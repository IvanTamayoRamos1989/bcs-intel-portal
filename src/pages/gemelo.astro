---
import BaseLayout from '../layouts/BaseLayout.astro';
import HowTo from '../components/HowTo.astro';
import PathBanner from '../components/PathBanner.astro';
import { cdtModel } from '../lib/cdtModel';
import { ficheStills } from '../lib/vistaStills';

const stillsByMuni = ficheStills();
const model = {
  ...cdtModel,
  munis: cdtModel.munis.map((m) => ({ ...m, stills: stillsByMuni[m.name] || [] })),
};
const learnByTheme: Record<string, string> = {
  urbano: '/aprendizaje/#planeacion',
  economia: '/aprendizaje/#vivienda',
  investigacion: '/aprendizaje/#planeacion',
  movilidad: '/aprendizaje/#agua',
  vivienda: '/aprendizaje/#costa',
};
const loretoAirLabel = cdtModel.munis.find((m) => m.name === 'Loreto')?.aereo_2025?.toLocaleString('es-MX') ?? '';
function cellText(id: string, raw: number | null | undefined) {
  if (raw === null || raw === undefined || Number.isNaN(Number(raw))) return '—';
  if (id === 'pobreza_pct') return Number(raw).toLocaleString('es-MX', { maximumFractionDigits: 2 }) + '%';
  return Math.round(Number(raw)).toLocaleString('es-MX');
}
const icon: Record<string, string> = {
  urbano: '<path d="M4 20V9l5-3 5 3v11"/><path d="M9 20v-6h4v6"/><path d="M14 20V11l5-2v11"/>',
  economia: '<path d="M4 19h16"/><path d="M7 16v-4"/><path d="M12 16V7"/><path d="M17 16v-6"/>',
  investigacion: '<circle cx="7" cy="8" r="2"/><circle cx="17" cy="8" r="2"/><circle cx="12" cy="16" r="2"/><path d="M9 9l2 5M15 9l-2 5M9 8h6"/>',
  movilidad: '<path d="M4 16h16"/><path d="M6 16V8h7l3 4h2v4"/><circle cx="8" cy="16" r="1.4"/><circle cx="16" cy="16" r="1.4"/>',
  vivienda: '<path d="M4 11 12 4l8 7"/><path d="M7 10.5V20h10v-9.5"/>',
};
---
<BaseLayout
  title="Gemelo territorial"
  titleEn="Territorial twin"
  description="Tablero por tema: mapa, cifras del portal, comparación municipal y escenarios."
  descriptionEn="Theme board: map, portal figures, municipal comparison and scenarios."
  section="Gemelo territorial"
  sectionEn="Territorial twin"
  wide={true}
  hidePageHead={true}
>
  <link rel="preconnect" href="https://tile.openstreetmap.org" crossorigin />
  <link rel="stylesheet" href="/explorar/vendor/maplibre-gl.css" />
  <link
    rel="stylesheet"
    href="/vendor/leaflet/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin=""
  />

  <PathBanner current="gemelo" />
  <div class="cdt">
    <header class="cdt-top">
      <div>
        <p class="cdt-kicker">
          <span data-lang-es>Fase 2.16 · apoyo a la decisión</span>
          <span data-lang-en hidden>Phase 2.16 · decision support</span>
        </p>
        <h1>
          <span data-lang-es>Gemelo territorial</span>
          <span data-lang-en hidden>Territorial twin</span>
        </h1>
        <p class="cdt-lead">
          <span data-lang-es>{model.pedagogy_es}</span>
          <span data-lang-en hidden>{model.pedagogy_en}</span>
        </p>
        <p class="cdt-fine">
          <span data-lang-es>{model.disclaimer_es}</span>
          <span data-lang-en hidden>{model.disclaimer_en}</span>
          {' '}
          <a href="/inicio/"><span data-lang-es>Volver a la consulta</span><span data-lang-en hidden>Back to the consultation</span></a>
          {' · '}
          <a href="/aprendizaje/"><span data-lang-es>Aprender de otras ciudades</span><span data-lang-en hidden>Learn from other cities</span></a>
          {' · '}
          <a href="/finanzas-publicas/"><span data-lang-es>Presupuesto, gasto y documentos públicos</span><span data-lang-en hidden>Budget, expenditure and public documents</span></a>
        </p>
        <nav class="cdt-presets" id="presets" aria-label="Para la reunión" data-aria-es="Para la reunión" data-aria-en="Meeting presets">
          <p>
            <span data-lang-es>Para la reunión. Puntos de partida, no pronósticos.</span>
            <span data-lang-en hidden>For the meeting. Starting points, not forecasts.</span>
            {' '}
            <a href="#recorrido-gemelo"><span data-lang-es>Guión de diez minutos</span><span data-lang-en hidden>Ten-minute script</span></a>
            {' '}
            <a href="#cdt-share"><span data-lang-es>Copiar vista</span><span data-lang-en hidden>Copy view</span></a>
            <span data-lang-es> guarda esta pantalla.</span>
            <span data-lang-en hidden> saves this screen.</span>
            {' '}
            <a href="#recetas"><span data-lang-es>Recetas</span><span data-lang-en hidden>Recipes</span></a>
          </p>
          <a data-preset href="/gemelo/?theme=vivienda&scenario=water_first&path=diagnostico&lever=deficit&z=sniiv_2025#presets">
            <span data-lang-es>Agua primero</span><span data-lang-en hidden>Water first</span>
          </a>
          <a data-preset href="/gemelo/?theme=urbano&scenario=corridor_intensify&compare=baseline&path=escenario&lever=corredor#presets">
            <span data-lang-es>Corredor y trayectoria</span><span data-lang-en hidden>Corridor and trajectory</span>
          </a>
          <a data-preset href="/gemelo/?theme=movilidad&scenario=ports_air_hubs&path=recomendacion&lever=aereo&z=aereo_2025#presets">
            <span data-lang-es>Puertos y aire</span><span data-lang-en hidden>Ports and air</span>
          </a>
          <a data-preset href="/gemelo/?theme=urbano&scenario=baseline&path=diagnostico&muni=Los%20Cabos&z=pob#presets">
            <span data-lang-es>Ficha Los Cabos</span><span data-lang-en hidden>Los Cabos fiche</span>
          </a>
        </nav>
        <section class="cdt-walk" id="recorrido-gemelo" aria-labelledby="cdt-walk-title">
          <h2 id="cdt-walk-title">
            <span data-lang-es>Guión de diez minutos</span>
            <span data-lang-en hidden>Ten-minute script</span>
          </h2>
          <p>
            <span data-lang-es>Para quien conduce. Ocho pasos. Cada enlace deja el gemelo en un estado que ya existe. No añade cifras.</span>
            <span data-lang-en hidden>For the person leading. Eight steps. Each link leaves the twin in a state it already has. It adds no figures.</span>
          </p>
          <ol>
            <li>
              <span data-lang-es>Diga: el relieve es el del estado. Pulse Vista 3D si quiere inclinar, y Estado para encuadrar.</span>
              <span data-lang-en hidden>Say: the terrain is the state’s. Press 3D view if you want to tilt, and State to frame it.</span>
              <a data-preset data-after="fit" href="/gemelo/?theme=urbano&scenario=baseline&path=diagnostico#recorrido-gemelo"><span data-lang-es>Encuadrar el estado</span><span data-lang-en hidden>Frame the state</span></a>
            </li>
            <li>
              <span data-lang-es>Diga: Capas enciende el tema. Esta apertura deja vivienda.</span>
              <span data-lang-en hidden>Say: Layers turns the theme on. This opening leaves housing.</span>
              <a data-preset data-after="capas" href="/gemelo/?theme=vivienda&scenario=baseline&path=diagnostico#recorrido-gemelo"><span data-lang-es>Capas de vivienda</span><span data-lang-en hidden>Housing layers</span></a>
            </li>
            <li>
              <span data-lang-es>Diga: agua primero es el diagnóstico de vivienda, con la altura del registro y la palanca del acuífero. No es un pronóstico.</span>
              <span data-lang-en hidden>Say: water first is the housing diagnosis, with the registry height and the aquifer lever. It is not a forecast.</span>
              <a data-preset href="/gemelo/?theme=vivienda&scenario=water_first&path=diagnostico&lever=deficit&z=sniiv_2025#recorrido-gemelo"><span data-lang-es>Agua primero</span><span data-lang-en hidden>Water first</span></a>
            </li>
            <li>
              <span data-lang-es>Diga: aquí se ven el corredor y la trayectoria actual a la vez. En pantalla estrecha, Ver A y Ver B.</span>
              <span data-lang-en hidden>Say: here you see the corridor and the current trajectory at once. On a narrow screen, View A and View B.</span>
              <a data-preset href="/gemelo/?theme=urbano&scenario=corridor_intensify&compare=baseline&path=escenario&lever=corredor#recorrido-gemelo"><span data-lang-es>Comparar el corredor</span><span data-lang-en hidden>Compare the corridor</span></a>
            </li>
            <li>
              <span data-lang-es>Diga: la ficha lee la cifra elegida y la demanda y oferta ya escritas. Si falta la cifra, se lee —.</span>
              <span data-lang-en hidden>Say: the fiche reads the chosen figure and the demand and supply already written. If the figure is missing, it reads —.</span>
              <a data-preset href="/gemelo/?theme=urbano&scenario=baseline&path=diagnostico&muni=Los%20Cabos&z=pob#recorrido-gemelo"><span data-lang-es>Ficha Los Cabos</span><span data-lang-en hidden>Los Cabos fiche</span></a>
            </li>
            <li>
              <span data-lang-es>Diga: Qué cambia es una frase. El cruce con otros temas es cualitativo. No es una simulación.</span>
              <span data-lang-en hidden>Say: What changes is one sentence. The cross-theme reading is qualitative. It is not a simulation.</span>
              <a data-preset data-after="cambia" href="/gemelo/?theme=urbano&scenario=corridor_intensify&compare=baseline&path=escenario&lever=corredor#recorrido-gemelo"><span data-lang-es>Qué cambia</span><span data-lang-en hidden>What changes</span></a>
            </li>
            <li>
              <span data-lang-es>Diga: Qué falta lista lo que aún no tiene archivo. Nada de eso está dibujado.</span>
              <span data-lang-en hidden>Say: What is missing lists what still has no file. None of that is drawn.</span>
              <a href="#listo"><span data-lang-es>Qué falta</span><span data-lang-en hidden>What is missing</span></a>
            </li>
            <li>
              <span data-lang-es>Diga: la hoja imprime el escenario que está en pantalla. No añade cifras.</span>
              <span data-lang-en hidden>Say: the sheet prints the scenario on screen. It adds no figures.</span>
              <button type="button" class="cdt-walk-print" id="cdt-walk-print"><span data-lang-es>Imprimir la hoja</span><span data-lang-en hidden>Print the sheet</span></button>
              <span data-lang-es> <a href="#cdt-share">Copiar vista</a> guarda el mismo enlace para quien llegue después.</span>
              <span data-lang-en hidden> <a href="#cdt-share">Copy view</a> saves the same link for whoever arrives later.</span>
            </li>
          </ol>
          <p>
            <a href="#consulta"><span data-lang-es>Consulta ciudadana</span><span data-lang-en hidden>Citizen consultation</span></a>
            <span data-lang-es>. Una pregunta por mesa, según el paso del camino.</span>
            <span data-lang-en hidden>. One question per table, according to the path step.</span>
          </p>
          <p>
            <a href="#checklist-anfitrion"><span data-lang-es>Checklist del anfitrión</span><span data-lang-en hidden>Host checklist</span></a>
            <span data-lang-es>. El orden corto: guión, recetas, consulta, copiar vista, fuentes y qué falta.</span>
            <span data-lang-en hidden>. The short order: script, recipes, consultation, copy view, sources and what is missing.</span>
          </p>
        </section>
        <section class="cdt-check" id="checklist-anfitrion" aria-labelledby="cdt-check-title">
          <h2 id="cdt-check-title">
            <span data-lang-es>Checklist del anfitrión</span>
            <span data-lang-en hidden>Host checklist</span>
          </h2>
          <p>
            <span data-lang-es>Para quien conduce. Una casilla por enlace. No añade cifras.</span>
            <span data-lang-en hidden>For the person leading. One box per link. It adds no figures.</span>
          </p>
          <ol>
            <li>
              <label>
                <input type="checkbox">
                <span data-lang-es>Abra las aperturas de la reunión. Son puntos de partida, no pronósticos.</span>
                <span data-lang-en hidden>Open the meeting openings. They are starting points, not forecasts.</span>
              </label>
              <a href="#presets"><span data-lang-es>Para la reunión</span><span data-lang-en hidden>For the meeting</span></a>
            </li>
            <li>
              <label>
                <input type="checkbox">
                <span data-lang-es>Siga el guión con los estados que ya existen.</span>
                <span data-lang-en hidden>Follow the script with the states that already exist.</span>
              </label>
              <a href="#recorrido-gemelo"><span data-lang-es>Guión de diez minutos</span><span data-lang-en hidden>Ten-minute script</span></a>
            </li>
            <li>
              <label>
                <input type="checkbox">
                <span data-lang-es>Elija una receta que el gemelo ya sabe aplicar.</span>
                <span data-lang-en hidden>Pick a recipe the twin already knows how to apply.</span>
              </label>
              <a href="#recetas"><span data-lang-es>Recetas</span><span data-lang-en hidden>Recipes</span></a>
            </li>
            <li>
              <label>
                <input type="checkbox">
                <span data-lang-es>Lea la pregunta de cada mesa, según el paso del camino.</span>
                <span data-lang-en hidden>Read the question for each table, according to the path step.</span>
              </label>
              <a href="#consulta"><span data-lang-es>Consulta</span><span data-lang-en hidden>Consultation</span></a>
            </li>
            <li>
              <label>
                <input type="checkbox">
                <span data-lang-es>Guarde esta pantalla en un enlace.</span>
                <span data-lang-en hidden>Save this screen in a link.</span>
              </label>
              <a href="#cdt-share"><span data-lang-es>Copiar vista</span><span data-lang-en hidden>Copy view</span></a>
            </li>
            <li>
              <label>
                <input type="checkbox">
                <span data-lang-es>Nombre la fuente de lo que está encendido.</span>
                <span data-lang-en hidden>Name the source of what is on.</span>
              </label>
              <a href="#fuentes-capas"><span data-lang-es>Fuentes de estas capas</span><span data-lang-en hidden>Sources for these layers</span></a>
            </li>
            <li>
              <label>
                <input type="checkbox">
                <span data-lang-es>Diga qué aún no tiene archivo.</span>
                <span data-lang-en hidden>Say what still has no file.</span>
              </label>
              <a href="#listo"><span data-lang-es>Qué falta</span><span data-lang-en hidden>What is missing</span></a>
            </li>
          </ol>
        </section>
        <nav class="cdt-path" id="cdt-path" aria-label="Camino de decisión" data-aria-es="Camino de decisión" data-aria-en="Decision path">
          <button type="button" data-path="diagnostico">
            <span data-lang-es>1 · Diagnóstico</span><span data-lang-en hidden>1 · Diagnosis</span>
          </button>
          <button type="button" data-path="meta">
            <span data-lang-es>2 · Meta</span><span data-lang-en hidden>2 · Goal</span>
          </button>
          <button type="button" data-path="escenario">
            <span data-lang-es>3 · Escenario</span><span data-lang-en hidden>3 · Scenario</span>
          </button>
          <button type="button" data-path="recomendacion">
            <span data-lang-es>4 · Recomendación</span><span data-lang-en hidden>4 · Recommendation</span>
          </button>
        </nav>
        <section class="cdt-consulta" id="consulta" aria-labelledby="cdt-consulta-title">
          <h2 id="cdt-consulta-title">
            <span data-lang-es>Consulta ciudadana</span>
            <span data-lang-en hidden>Citizen consultation</span>
          </h2>
          <p>
            <span data-lang-es>Una pregunta para el gobierno, el sector privado y la sociedad civil. Sigue el paso del camino. No añade cifras.</span>
            <span data-lang-en hidden>One question for government, the private sector and civil society. It follows the path step. It adds no figures.</span>
          </p>
          <div id="cdt-consulta-body"></div>
          <p><a href="#cdt-share"><span data-lang-es>Copiar vista</span><span data-lang-en hidden>Copy view</span></a>
            {' · '}
            <a href="#recetas"><span data-lang-es>Recetas de escenario</span><span data-lang-en hidden>Scenario recipes</span></a>
          </p>
        </section>
        <section class="cdt-recetas" id="recetas" aria-labelledby="cdt-recetas-title">
          <h2 id="cdt-recetas-title">
            <span data-lang-es>Recetas de escenario</span>
            <span data-lang-en hidden>Scenario recipes</span>
          </h2>
          <p>
            <span data-lang-es>Combinaciones que el gemelo ya sabe aplicar. No son pronósticos.</span>
            <span data-lang-en hidden>Combinations the twin already knows how to apply. They are not forecasts.</span>
          </p>
          <div class="cdt-recetas-grid">
            <article>
              <h3><span data-lang-es>Agua primero</span><span data-lang-en hidden>Water first</span></h3>
              <p><span data-lang-es>Prioriza el agua antes de abrir más crecimiento.</span><span data-lang-en hidden>Puts water ahead of opening more growth.</span></p>
              <a data-preset href="/gemelo/?theme=vivienda&scenario=water_first&path=diagnostico&lever=deficit&z=sniiv_2025#recetas"><span data-lang-es>Aplicar</span><span data-lang-en hidden>Apply</span></a>
            </article>
            <article>
              <h3><span data-lang-es>Corredor y trayectoria</span><span data-lang-en hidden>Corridor and trajectory</span></h3>
              <p><span data-lang-es>Compara el corredor con la trayectoria actual.</span><span data-lang-en hidden>Compares the corridor with the current trajectory.</span></p>
              <a data-preset href="/gemelo/?theme=urbano&scenario=corridor_intensify&compare=baseline&path=escenario&lever=corredor#recetas"><span data-lang-es>Aplicar</span><span data-lang-en hidden>Apply</span></a>
            </article>
            <article>
              <h3><span data-lang-es>Puertos y aire</span><span data-lang-en hidden>Ports and air</span></h3>
              <p><span data-lang-es>Ancla el crecimiento en puertos y aeropuertos.</span><span data-lang-en hidden>Anchors growth on ports and airports.</span></p>
              <a data-preset href="/gemelo/?theme=movilidad&scenario=ports_air_hubs&path=recomendacion&lever=aereo&z=aereo_2025#recetas"><span data-lang-es>Aplicar</span><span data-lang-en hidden>Apply</span></a>
            </article>
            <article>
              <h3><span data-lang-es>Los Cabos en vivienda</span><span data-lang-en hidden>Los Cabos in housing</span></h3>
              <p><span data-lang-es>Abre la ficha de Los Cabos en el tema de vivienda.</span><span data-lang-en hidden>Opens the Los Cabos fiche on the housing theme.</span></p>
              <a data-preset href="/gemelo/?theme=vivienda&scenario=baseline&path=diagnostico&muni=Los%20Cabos&z=pob#recetas"><span data-lang-es>Aplicar</span><span data-lang-en hidden>Apply</span></a>
            </article>
            <article>
              <h3><span data-lang-es>Trayectoria y margen de agua</span><span data-lang-en hidden>Trajectory and water headroom</span></h3>
              <p><span data-lang-es>Deja la palanca de margen de agua sobre la trayectoria actual.</span><span data-lang-en hidden>Leaves the water-headroom lever on the current trajectory.</span></p>
              <a data-preset href="/gemelo/?theme=urbano&scenario=baseline&path=diagnostico&lever=agua#recetas"><span data-lang-es>Aplicar</span><span data-lang-en hidden>Apply</span></a>
            </article>
            <article>
              <h3><span data-lang-es>Agua junto a la trayectoria</span><span data-lang-en hidden>Water beside the trajectory</span></h3>
              <p><span data-lang-es>Deja ver agua primero junto a la trayectoria actual.</span><span data-lang-en hidden>Shows water first beside the current trajectory.</span></p>
              <a data-preset href="/gemelo/?theme=vivienda&scenario=water_first&compare=baseline&path=escenario&lever=deficit#recetas"><span data-lang-es>Aplicar</span><span data-lang-en hidden>Apply</span></a>
            </article>
          </div>
        </section>
        <HowTo
          leadEs="Siga el camino: diagnóstico, meta, escenario y recomendación. Cada paso usa cifras y reglas que ya están en el portal."
          leadEn="Follow the path: diagnosis, goal, scenario and recommendation. Each step uses figures and rules already in the portal."
          steps={[
            { es: 'Diagnóstico: el tema, la altura municipal y las capas de ese tema.', en: 'Diagnosis: the theme, the municipal height and that theme’s layers.' },
            { es: 'Meta: las preguntas ya escritas para el municipio y el tema.', en: 'Goal: the questions already written for the municipality and the theme.' },
            { es: 'Escenario: el botón, la palanca, qué cambia y, si quiere, la comparación.', en: 'Scenario: the button, the lever, what changes and, if you want, the comparison.' },
            { es: 'Recomendación: la regla del portal para el municipio y el escenario. Imprima esa hoja para la reunión.', en: 'Recommendation: the portal rule for the municipality and the scenario. Print that sheet for the meeting.' },
            { es: 'Toque un municipio: la ficha muestra la cifra elegida, la demanda y oferta ya escritas, y la recomendación. Si falta la cifra, se lee —.', en: 'Tap a municipality: the fiche shows the chosen figure, the demand and supply already written, and the recommendation. If the figure is missing, it reads —.' },
            { es: 'Para la reunión hay cuatro aperturas listas. Son puntos de partida, no pronósticos.', en: 'For the meeting there are four ready openings. They are starting points, not forecasts.' },
            { es: 'La ficha puede mostrar hasta tres fotogramas que ya están en la vista de ese municipio. La leyenda de la altura dice la cifra. Sin cifra, el municipio queda plano.', en: 'The fiche can show up to three frames already in that municipality’s view. The height legend names the figure. With no figure, the municipality stays flat.' },
            { es: 'El atlas es el inventario para explorar. El gemelo es el lugar de los escenarios y la decisión. Abrir en el atlas lleva las capas del tema que el atlas ya conoce.', en: 'The atlas is the inventory for exploring. The twin is where scenarios and the decision live. Open in atlas carries the theme layers the atlas already knows.' },
          ]}
        />
        <aside class="cdt-tip">
          <p>
            <span data-lang-es>Cómo leer el tablero: elija un tema, luego un escenario, y compare los municipios.</span>
            <span data-lang-en hidden>How to read the board: pick a theme, then a scenario, and compare the municipalities.</span>
          </p>
          <p>
            <span data-lang-es>Si una celda está en blanco, se queda en blanco. No se rellena en la reunión.</span>
            <span data-lang-en hidden>If a cell is blank, it stays blank. It is not filled in during the meeting.</span>
          </p>
          <p>
            <a href="/vistas/"><span data-lang-es>Vistas guardadas</span><span data-lang-en hidden>Saved views</span></a>
            {' · '}
            <a href="/aprendizaje/#evidencia"><span data-lang-es>Evidencia de otras ciudades</span><span data-lang-en hidden>Evidence from other cities</span></a>
          </p>
        </aside>
        <section class="cdt-limits" id="limites">
          <h2>
            <span data-lang-es>Qué puede / qué no puede (Fase 2.10)</span>
            <span data-lang-en hidden>What it can / cannot do (Phase 2.10)</span>
          </h2>
          <p>
            <span data-lang-es>Puede ahora: recorrer diagnóstico, meta, escenario y recomendación; levantar cada municipio con una cifra que usted elige; y imprimir la hoja de ese escenario. Si una celda está en blanco, ese municipio no se levanta y la celda sigue en blanco.</span>
            <span data-lang-en hidden>It can now: walk diagnosis, goal, scenario and recommendation; raise each municipality with a figure you choose; and print the sheet for that scenario. If a cell is blank, that municipality does not rise and the cell stays blank.</span>
          </p>
          <p>
