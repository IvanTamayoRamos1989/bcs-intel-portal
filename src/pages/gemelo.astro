        return String(s || '').replace(/\s+ON DISK/gi, '').replace(/\s{2,}/g, ' ').trim();
      }
      function fmt(id, n) {
        if (id === 'pobreza_pct') return Number(n).toLocaleString('es-MX', { maximumFractionDigits: 2 }) + '%';
        return Math.round(Number(n)).toLocaleString('es-MX');
      }
      function uniq(list) {
        var seen = {};
        var out = [];
        list.forEach(function (id) {
          if (!id || seen[id]) return;
          seen[id] = 1;
          out.push(id);
        });
        return out;
      }

      var params = new URLSearchParams(location.search);
      if (params.get('theme') && themeById(params.get('theme')).id === params.get('theme')) state.theme = params.get('theme');
      if (params.get('scenario') && scenarioById(params.get('scenario')).id === params.get('scenario')) state.scenario = params.get('scenario');
      if (params.get('x') && indicatorById(params.get('x')).id === params.get('x')) state.x = params.get('x');
      if (params.get('y') && indicatorById(params.get('y')).id === params.get('y')) state.y = params.get('y');
      if (params.get('muni') && muniByName(params.get('muni')).name === params.get('muni')) state.muni = params.get('muni');
      if (params.get('compare') && scenarioById(params.get('compare')).id === params.get('compare') && params.get('compare') !== state.scenario) state.compare = params.get('compare');
      if (params.get('z') && indicatorById(params.get('z')).id === params.get('z')) state.z = params.get('z');
      if (params.get('path') && /^(diagnostico|meta|escenario|recomendacion)$/.test(params.get('path'))) state.path = params.get('path');
      if (params.get('lever')) state.lever = params.get('lever');
      if (state.x === state.y) state.y = state.x === 'sniiv_2025' ? 'pobreza_pct' : 'sniiv_2025';

      var map = null;
      var gl = null;
      var muniLayer = null;
      function ensure2d() {
        if (map || typeof L === 'undefined') return;
        map = L.map(mapEl, { scrollWheelZoom: true, maxZoom: 14 });
        map.setView([25.6, -112.0], 6);
        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '&copy; OpenStreetMap',
          maxZoom: 18,
        }).addTo(map);
        L.control.scale({ imperial: false, metric: true }).addTo(map);
        var pitchBtn = document.getElementById('cdt-pitch');
        var rotBtn = document.getElementById('cdt-rot');
        if (pitchBtn) pitchBtn.hidden = true;
        if (rotBtn) rotBtn.hidden = true;
        var fitBtn = document.getElementById('cdt-fit');
        if (fitBtn) fitBtn.addEventListener('click', function () {
          map.fitBounds(L.latLngBounds([22.87, -115.22], [28.0, -109.41]), { padding: [18, 18], maxZoom: 7, animate: false });
        });
      }
      var loaded = {};
      var active = {};
      var statusEl = document.getElementById('cdt-status');

      function setStatus(es, en) {
        if (statusEl) statusEl.textContent = tx(es, en);
      }

      function ramp(t) {
        var a = [214, 232, 245];
        var b = [0, 131, 196];
        var c = a.map(function (v, i) { return Math.round(v + (b[i] - v) * t); });
        return 'rgb(' + c.join(',') + ')';
      }

      function hasNum(v) { return v !== null && v !== undefined && !isNaN(Number(v)); }
      function styleMuni(feature) {
        var name = feature.properties && feature.properties.name;
        var m = muniByName(name);
        var ind = state.x;
        var vals = model.munis.map(function (row) { return row[ind]; }).filter(hasNum).map(Number);
        var raw = m[ind];
        var on = name === state.muni;
        if (!hasNum(raw) || !vals.length) {
          return { color: on ? '#0b3a56' : '#8aa0ad', weight: on ? 3 : 1.1, fillColor: '#e6eef2', fillOpacity: 0.55 };
        }
        var min = Math.min.apply(null, vals);
        var max = Math.max.apply(null, vals);
        var t = max === min ? 0.6 : (Number(raw) - min) / (max - min);
        return {
          color: on ? '#0b3a56' : '#006BA3',
          weight: on ? 3 : 1.2,
          fillColor: ramp(t),
          fillOpacity: 0.5,
        };
      }

      function muniColors() {
        var out = {};
        model.munis.forEach(function (m) {
          var s = styleMuni({ properties: { name: m.name } });
          out[m.name] = { fill: s.fillColor, line: s.color, weight: s.weight };
        });
        return out;
      }
      function extrusionHeights() {
        var id = state.z;
        var vals = model.munis.map(function (m) { return m[id]; }).filter(hasNum).map(Number);
        if (!vals.length) return {};
        var min = Math.min.apply(null, vals);
        var max = Math.max.apply(null, vals);
        var out = {};
        model.munis.forEach(function (m) {
          var raw = m[id];
          if (!hasNum(raw)) return;
          var t = max === min ? 1 : (Number(raw) - min) / (max - min);
          out[m.name] = Math.round(2500 + t * 20000);
        });
        return out;
      }
      function paintExtrude2d() {
        if (!map || !muniLayer || typeof L === 'undefined') return;
        if (extrudeLayer) map.removeLayer(extrudeLayer);
        var heights = extrusionHeights();
        var names = Object.keys(heights);
        if (!names.length) { extrudeLayer = null; return; }
        var maxH = Math.max.apply(null, names.map(function (n) { return heights[n]; }));
        extrudeLayer = L.layerGroup();
        muniLayer.eachLayer(function (layer) {
          var name = layer.feature && layer.feature.properties && layer.feature.properties.name;
          if (!name || !heights[name]) return;
          var t = heights[name] / maxH;
          L.circleMarker(layer.getBounds().getCenter(), {
            radius: 7 + t * 14,
            color: '#006BA3',
            weight: 1,
            fillColor: '#0083C4',
            fillOpacity: 0.9,
          }).bindTooltip(name, { sticky: true }).addTo(extrudeLayer);
        });
        extrudeLayer.addTo(map);
      }
      function refreshMuniStyle() {
        if (gl && gl.setExtrusion) gl.setExtrusion(extrusionHeights());
        if (gl) gl.paintMunis(muniColors());
        if (muniLayer) muniLayer.setStyle(styleMuni);
        paintExtrude2d();
        renderExtrudeLegend();
      }
      function currentLever() {
        var sc = scenarioById(state.scenario);
        var list = sc.levers || [];
        for (var i = 0; i < list.length; i++) if (list[i].id === state.lever) return list[i];
        return null;
      }

      function selectMuni(name) {
        state.muni = name;
        refreshMuniStyle();
        document.querySelectorAll('.cdt-table tr[data-muni]').forEach(function (tr) {
          tr.classList.toggle('is-on', tr.getAttribute('data-muni') === name);
        });
        renderDetail();
        renderScatter();
        applyContext();
        writeUrl();
      }

      function renderDetail() {
        var el = document.getElementById('cdt-muni-detail');
        if (!el) return;
        var m = muniByName(state.muni);
        var subs = (m.subplaces || []).map(function (s) {
          return '<p><strong>' + tx(s.name_es, s.name_en) + '.</strong> ' + tx(s.balance_es, s.balance_en) + '</p>';
        }).join('');
        el.innerHTML =
          '<p><strong>' + m.name + '</strong> · ' + tx('cabecera', 'seat') + ' ' + m.cabecera +
          ' (' + fmt('pob', m.cab_pob) + ')</p>' +
          '<p>' + plain(tx(m.strengths_es, m.strengths_en)) + '</p>' +
          '<p>' + plain(tx(m.locks_es, m.locks_en)) + '</p>' +
          subs +
          '<p><a href="' + m.studio + '">' + tx('Ficha del municipio', 'Municipal page') + '</a>' +
          ' · <a href="' + m.crecimiento + '">' + tx('Demanda y oferta', 'Demand and supply') + '</a>' +
          ' · <a href="' + m.vista + '">' + tx('Vista: ', 'View: ') + tx(m.vista_es, m.vista_en) + '</a></p>';
      }

      function renderScatter() {
        var host = document.getElementById('cdt-scatter');
        if (!host) return;
        var xi = indicatorById(state.x);
        var yi = indicatorById(state.y);
        var W = 340, H = 230, Lft = 46, Bot = 36, Rgt = 12, Top = 14;
        var strip = document.getElementById('cdt-quality-strip');
        if (strip) {
          function card(ind) {
            var cov = ind.complete
              ? tx('Cobertura: cinco municipios.', 'Coverage: five municipalities.')
              : tx('Cobertura incompleta.', 'Incomplete coverage.');
            return '<article><strong>' + tx(ind.label_es, ind.label_en) + '</strong><small>' +
              tx('Año ', 'Year ') + ind.year + ' · ' + tx(ind.source_es, ind.source_en) + '. ' + cov + ' ' +
              tx(ind.quality_es, ind.quality_en) + '</small></article>';
          }
          strip.innerHTML = card(xi) + card(yi);
          if (!xi.complete || !yi.complete) {
            strip.innerHTML += '<p><a class="cdt-blank" href="/metas/">' +
              tx('Sin serie municipal en el acervo para al menos un eje. Ver preguntas abiertas.', 'No municipal series in the archive for at least one axis. See open questions.') +
              '</a></p>';
          }
        }
        var rows = model.munis.filter(function (m) { return hasNum(m[state.x]) && hasNum(m[state.y]); });
        if (rows.length < 2) {
          host.textContent = tx('No hay suficientes municipios con las dos cifras.', 'Not enough municipalities have both figures.');
          return;
        }
        var xs = rows.map(function (m) { return Number(m[state.x]); });
        var ys = rows.map(function (m) { return Number(m[state.y]); });
        var xmin = Math.min.apply(null, xs), xmax = Math.max.apply(null, xs);
        var ymin = Math.min.apply(null, ys), ymax = Math.max.apply(null, ys);
        if (xmin === xmax) { xmin -= 1; xmax += 1; }
        if (ymin === ymax) { ymin -= 1; ymax += 1; }
        function px(v) { return Lft + (v - xmin) / (xmax - xmin) * (W - Lft - Rgt); }
        function py(v) { return H - Bot - (v - ymin) / (ymax - ymin) * (H - Bot - Top); }
        var dots = rows.map(function (m) {
          var on = m.name === state.muni;
          return '<g class="cdt-dot" data-dot="' + m.name + '" style="cursor:pointer">' +
            '<circle cx="' + px(m[state.x]).toFixed(1) + '" cy="' + py(m[state.y]).toFixed(1) +
            '" r="' + (on ? 7 : 5) + '" fill="#0083C4" stroke="' + (on ? '#0b3a56' : '#fff') + '" stroke-width="' + (on ? 2.5 : 1.2) + '"></circle>' +
            '<text x="' + (px(m[state.x]) + 8).toFixed(1) + '" y="' + (py(m[state.y]) - 6).toFixed(1) +
            '" font-size="10" fill="#1a1a1a">' + m.short + '</text></g>';
        }).join('');
        host.innerHTML =
          '<svg viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="' + tx('Comparación municipal', 'Municipal comparison') + '">' +
          '<line x1="' + Lft + '" y1="' + (H - Bot) + '" x2="' + (W - Rgt) + '" y2="' + (H - Bot) + '" stroke="#d0d0d0"/>' +
          '<line x1="' + Lft + '" y1="' + Top + '" x2="' + Lft + '" y2="' + (H - Bot) + '" stroke="#d0d0d0"/>' +
          '<text x="' + Lft + '" y="' + (H - 8) + '" font-size="10" fill="#5a5a5a">' + tx(xi.label_es, xi.label_en) + '</text>' +
          '<text x="12" y="' + (Top + 8) + '" font-size="10" fill="#5a5a5a">' + tx(yi.label_es, yi.label_en) + '</text>' +
          '<text x="' + Lft + '" y="' + (H - Bot + 12) + '" font-size="9" fill="#5a5a5a">' + fmt(state.x, xmin) + '</text>' +
          '<text x="' + (W - Rgt - 36) + '" y="' + (H - Bot + 12) + '" font-size="9" fill="#5a5a5a">' + fmt(state.x, xmax) + '</text>' +
          dots +
          '</svg>';
        host.querySelectorAll('[data-dot]').forEach(function (g) {
          g.addEventListener('click', function () { selectMuni(g.getAttribute('data-dot')); });
        });
        var src = document.getElementById('cdt-sources');
        if (src) {
          src.textContent = tx(
            xi.source_es + ' · ' + yi.source_es + '. ' + xi.quality_es + ' ' + yi.quality_es + ' Cada punto es un municipio. No hay línea de tendencia.',
            xi.source_en + ' · ' + yi.source_en + '. ' + xi.quality_en + ' ' + yi.quality_en + ' Each point is a municipality. There is no trend line.'
          );
        }
      }

      function fillSelects() {
        ['cdt-x', 'cdt-y'].forEach(function (id) {
          var sel = document.getElementById(id);
          if (!sel) return;
          var current = id === 'cdt-x' ? state.x : state.y;
          sel.innerHTML = model.indicators.map(function (ind) {
            return '<option value="' + ind.id + '"' + (ind.id === current ? ' selected' : '') + '>' +
              tx(ind.label_es, ind.label_en) + '</option>';
          }).join('');
        });
      }

      function presetIds() {
        var theme = themeById(state.theme);
        var sc = scenarioById(state.scenario);
        var ids = (theme.layers || []).concat(sc.priority_layer_ids || []);
        if (state.compare) ids = ids.concat(scenarioById(state.compare).priority_layer_ids || []);
        return uniq(ids);
      }
      function wantedLayers() {
        return uniq(presetIds().filter(function (id) { return !layerOff[id]; }).concat(Object.keys(layerExtra)));
      }
      function compareOnly() {
        var only = {};
        if (!state.compare) return only;
        var keep = {};
        var theme = themeById(state.theme);
        var sc = scenarioById(state.scenario);
        (theme.layers || []).concat(sc.priority_layer_ids || []).forEach(function (id) { keep[id] = 1; });
        (scenarioById(state.compare).priority_layer_ids || []).forEach(function (id) {
          if (!keep[id]) only[id] = 1;
        });
        return only;
      }
      function resetLayerPins() {
        layerOff = {};
        layerExtra = {};
      }

      function pointLayer(meta) {
        return function (feat, latlng) {
          return L.circleMarker(latlng, {
            radius: 5,
            color: meta.color,
            weight: 1,
            fillColor: meta.color,
            fillOpacity: 0.85,
          });
        };
      }

      function popupHtml(feat) {
        var p = feat.properties || {};
        var name = p.name_es || p.name || p.proyecto || p.NOMBRE || p.NOM_NUC || p.ref || '';
        return name ? String(name) : '';
      }

      function ensureLayer(id) {
        if (loaded[id]) return Promise.resolve(loaded[id]);
        var meta = layerMeta(id);
        if (!meta) return Promise.resolve(null);
        return fetch(meta.url).then(function (r) { return r.json(); }).then(function (geo) {
          var isPoint = meta.type === 'point' || meta.type === 'points';
          var layer = L.geoJSON(geo, {
            interactive: isPoint,
            style: function () {
              if (meta.type === 'line') return { color: meta.color, weight: 1.6, opacity: 0.9 };
              return { color: meta.color, weight: 1, fillColor: meta.color, fillOpacity: 0.16 };
            },
            pointToLayer: pointLayer(meta),
            onEachFeature: function (feat, layer) {
              var html = popupHtml(feat);
              if (html && isPoint) layer.bindPopup(html);
            },
          });
          layer._cdtPoint = isPoint;
          loaded[id] = layer;
          return layer;
        }).catch(function () {
          loaded[id] = null;
          return null;
        });
      }

      function syncLayers() {
        var ids = wantedLayers();
        var want = {};
        ids.forEach(function (id) { want[id] = 1; });
        var cmp = compareOnly();
        var names = ids.map(function (id) {
          var meta = layerMeta(id);
          var label = meta ? tx(meta.name_es, meta.name_en) : id;
          return cmp[id] ? label + (lang() === 'en' ? ' (compare)' : ' (comparar)') : label;
        });
        var nameEl = document.getElementById('cdt-layer-names');
        if (nameEl) nameEl.textContent = tx('Capas: ', 'Layers: ') + names.join(' · ');
        renderCapas(ids, cmp);
        if (gl) {
          model.layerCatalog.forEach(function (meta) {
            if (!want[meta.id] && gl.hide) gl.hide(meta.id);
          });
          return Promise.all(ids.map(function (id) {
            var meta = layerMeta(id);
            if (!meta) return 'fail';
            return gl.load(meta).then(function (geo) {
              if (!geo) return 'fail';
              gl.show(id, geo, meta, cmp[id] ? 'compare' : 'on');
              return 'ok';
            });
          })).then(function (flags) {
            var failed = flags.filter(function (f) { return f === 'fail'; });
            if (failed.length) setStatus('Algunas capas no cargaron.', 'Some layers did not load.');
            else setStatus(
              'Relieve del estado. El color compara municipios. Las capas del tema y del escenario están encendidas.',
              'State terrain. Color compares municipalities. Theme and scenario layers are on.'
            );
          });
        }
        Object.keys(active).forEach(function (id) {
          if (!want[id] && map) {
            map.removeLayer(active[id]);
            delete active[id];
          }
        });
        return Promise.all(ids.map(function (id) {
          return ensureLayer(id).then(function (layer) {
            if (!layer || active[id] || !map) return;
            if (!want[id]) return;
            layer.addTo(map);
            active[id] = layer;
          });
        })).then(function () {
          Object.keys(active).forEach(function (id) {
            if (active[id] && !active[id]._cdtPoint) active[id].bringToBack();
          });
          if (muniLayer) muniLayer.bringToFront();
          Object.keys(active).forEach(function (id) {
            if (active[id] && active[id]._cdtPoint) active[id].bringToFront();
          });
          var failed = ids.filter(function (id) { return loaded[id] === null; });
          if (failed.length) setStatus('Algunas capas no cargaron. El mapa queda en plano.', 'Some layers did not load. The map stays flat.');
          else setStatus('Sin mapa 3D en este navegador. Las capas siguen en el plano y el color compara municipios.', 'No 3D map in this browser. Layers stay on the flat map and color compares municipalities.');
        });
      }

      function fitScenario() {
        var sc = scenarioById(state.scenario);
        var b = sc.focus_bbox;
        function fit() {
          try {
            if (gl) {
              gl.resize();
              gl.fitBox(b && b.length === 4 ? b : null);
              return;
            }
            if (!map || !b || b.length !== 4) return;
            map.invalidateSize();
            map.fitBounds(L.latLngBounds([b[1], b[0]], [b[3], b[2]]), { padding: [18, 18], maxZoom: 10, animate: false });
          } catch (e) {}
        }
        fit();
        setTimeout(fit, 280);
      }

      function updateMapLink() {
        var a = document.getElementById('cdt-map-link');
        if (!a) return;
        var ids = wantedLayers();
        a.href = '/mapas?scenario=' + encodeURIComponent(state.scenario) + '&layers=' + encodeURIComponent(ids.join(',')) + '#gis';
      }

      function writeUrl() {
        var q = new URLSearchParams();
        q.set('theme', state.theme);
        q.set('scenario', state.scenario);
        if (state.compare && state.compare !== state.scenario) q.set('compare', state.compare);
        if (state.lever && currentLever()) q.set('lever', state.lever);
        if (state.z) q.set('z', state.z);
        if (state.path) q.set('path', state.path);
        q.set('x', state.x);
        q.set('y', state.y);
        q.set('muni', state.muni);
        history.replaceState(null, '', location.pathname + '?' + q.toString() + location.hash);
      }

      function applyContext() {
        var m = muniByName(state.muni);
        var placeIds = (m.subplaces || []).map(function (s) { return s.id; });
        document.querySelectorAll('[data-goal-places]').forEach(function (li) {
          var places = (li.getAttribute('data-goal-places') || '').split(/\s+/);
          var themes = (li.getAttribute('data-goal-themes') || '').split(/\s+/);
          var hit = themes.indexOf(state.theme) !== -1 && places.some(function (id) { return placeIds.indexOf(id) !== -1; });
          li.hidden = !hit;
        });
        document.querySelectorAll('[data-aim]').forEach(function (li) {
          li.hidden = placeIds.indexOf(li.getAttribute('data-aim')) === -1;
        });
        document.querySelectorAll('[data-couple]').forEach(function (ul) {
          ul.hidden = ul.getAttribute('data-couple') !== state.theme;
        });
        document.querySelectorAll('[data-qcount]').forEach(function (el) {
          el.classList.toggle('is-on', el.getAttribute('data-qcount') === state.theme);
        });
        var shown = 0;
        document.querySelectorAll('#cdt-dep-list [data-where]').forEach(function (li) {
          var where = li.getAttribute('data-where') || '';
          var match = where.indexOf(m.name) !== -1;
          var keep = match && shown < 6;
          if (keep) shown += 1;
          li.hidden = !keep;
        });
      }

      function applyChrome() {
        document.querySelectorAll('[data-theme]').forEach(function (btn) {
          btn.setAttribute('aria-pressed', btn.getAttribute('data-theme') === state.theme ? 'true' : 'false');
        });
        document.querySelectorAll('[data-theme-panel]').forEach(function (panel) {
          panel.hidden = panel.getAttribute('data-theme-panel') !== state.theme;
        });
        document.querySelectorAll('[data-scenario]').forEach(function (btn) {
          btn.setAttribute('aria-pressed', btn.getAttribute('data-scenario') === state.scenario ? 'true' : 'false');
        });
        document.querySelectorAll('[data-scenario-copy]').forEach(function (block) {
          block.hidden = block.getAttribute('data-scenario-copy') !== state.scenario;
        });
        document.querySelectorAll('[data-rec-themes]').forEach(function (card) {
          var themes = (card.getAttribute('data-rec-themes') || '').split(/\s+/);
          var scenarios = (card.getAttribute('data-rec-scenarios') || '').split(/\s+/);
          var show = themes.indexOf(state.theme) !== -1 && scenarios.indexOf(state.scenario) !== -1;
          card.hidden = !show;
        });
        var cmpSel = document.getElementById('cdt-compare');
        if (cmpSel) {
          var cur = state.compare;
          cmpSel.innerHTML = '<option value="">' + tx('Ninguno', 'None') + '</option>' +
            model.scenarios.map(function (sc) {
              if (sc.id === state.scenario) return '';
              return '<option value="' + sc.id + '"' + (sc.id === cur ? ' selected' : '') + '>' + tx(sc.title_es, sc.title_en) + '</option>';
            }).join('');
        }
        renderLevers();
        renderCambia();
        renderExtrudeLegend();
        document.querySelectorAll('[data-balance]').forEach(function (card) {
          var lever = currentLever();
          var on = !!(lever && !card.hidden && card.getAttribute('data-balance') === lever.balance);
          card.classList.toggle('is-lever', on);
        });
        renderCruce();
        focusPath(false);
        renderSheet();
        updateMapLink();
        applyContext();
        writeUrl();
      }

      function focusPath(scroll) {
        document.body.dataset.cdtPath = state.path || '';
        document.querySelectorAll('[data-path]').forEach(function (btn) {
          btn.setAttribute('aria-pressed', btn.getAttribute('data-path') === state.path ? 'true' : 'false');
        });
        document.querySelectorAll('[data-step]').forEach(function (el) {
          el.classList.toggle('is-step', !!state.path && el.getAttribute('data-step') === state.path);
        });
        if (!scroll || !state.path) return;
        var target = document.querySelector('[data-step="' + state.path + '"].is-step');
        if (!target) return;
        var root = document.documentElement;
        var prev = root.style.scrollBehavior;
        root.style.scrollBehavior = 'auto';
        target.scrollIntoView({ block: 'start', behavior: 'auto' });
        root.style.scrollBehavior = prev;
      }

      function renderSheet() {
        var host = document.getElementById('cdt-sheet');
        if (!host) return;
        var theme = themeById(state.theme);
        var sc = scenarioById(state.scenario);
        var lever = currentLever();
        var ind = indicatorById(state.z);
        var missing = model.munis.filter(function (m) { return !hasNum(m[state.z]); }).map(function (m) { return m.name; });
        var recs = [];
        document.querySelectorAll('#cdt-rec-list .cdt-rec').forEach(function (card) {
          if (card.hidden || recs.length >= 4) return;
          var name = card.querySelector('.cdt-rec-kicker');
          var rule = card.querySelector('.cdt-rec-rule');
          recs.push('<li><strong>' + (name ? name.innerText.trim() : '') + '.</strong> ' + (rule ? rule.innerText.trim() : '') + '</li>');
        });
        host.innerHTML =
          '<h2>' + tx('Hoja del escenario', 'Scenario sheet') + '</h2>' +
          '<p><strong>' + tx('Tema. ', 'Theme. ') + '</strong>' + tx(theme.es, theme.en) + '</p>' +
          '<p><strong>' + tx('Escenario. ', 'Scenario. ') + '</strong>' + tx(sc.title_es, sc.title_en) + '. ' + tx(sc.blurb_es, sc.blurb_en) + '</p>' +
          '<p><strong>' + tx('Palanca. ', 'Lever. ') + '</strong>' + (lever ? tx(lever.label_es, lever.label_en) + '. ' + tx(lever.read_es, lever.read_en) : tx('Ninguna.', 'None.')) + '</p>' +
          '<p><strong>' + tx('Municipios en tensión. ', 'Municipalities under stress. ') + '</strong>' + (sc.stress || []).join(' · ') + '</p>' +
          '<p><strong>' + tx('Altura. ', 'Height. ') + '</strong>' + tx(ind.label_es, ind.label_en) + ' · ' + tx(ind.source_es, ind.source_en) + '. ' +
          (missing.length ? tx('Sin cifra: ', 'No figure: ') + missing.join(' · ') + '.' : tx('Los cinco municipios tienen cifra.', 'All five municipalities have a figure.')) + '</p>' +
          '<p><strong>' + tx('Recomendación. ', 'Recommendation. ') + '</strong></p><ul>' + recs.join('') + '</ul>' +
          '<p>' + tx('El cruce con los otros temas es cualitativo. No es una simulación.', 'The cross-theme reading is qualitative. It is not a simulation.') + '</p>' +
          '<p>' + location.href + '</p>';
      }

      function renderCruce() {
        var host = document.getElementById('cdt-cruce-body');
        if (!host) return;
        var sc = scenarioById(state.scenario);
        var lever = currentLever();
        var lines = (model.couplings[state.theme] || []).map(function (c) {
          var other = themeById(c.to);
          var front = !!(lever && lever.read_es === c.es);
          return '<li' + (front ? ' class="is-front"' : '') + '><strong>' + tx(other.es, other.en) + '.</strong> ' + tx(c.es, c.en) + '</li>';
        }).join('');
        var nodes = (sc.nodes || []).map(function (n) {
          var see = n.muni
            ? ' <button type="button" class="cdt-node-btn" data-node-muni="' + n.muni + '">' + tx('Ver en el mapa', 'See on the map') + '</button>'
            : '';
          return '<span><a class="cdt-node" href="' + n.href + '">' + tx(n.label, n.label_en) + '</a>' + see + '</span>';
        }).join('');
        host.innerHTML =
          '<p>' + tx('Lectura cualitativa de las reglas del portal. No es un motor de simulación.', 'A qualitative reading of the portal’s rules. It is not a simulation engine.') + '</p>' +
          (lever
            ? '<p><strong>' + tx('Palanca delante: ', 'Lever in front: ') + tx(lever.label_es, lever.label_en) + '.</strong> ' + tx(lever.read_es, lever.read_en) + '</p>'
            : '<p>' + tx(sc.note_es, sc.note_en) + '</p>') +
          '<ul>' + lines + '</ul>' +
          '<p><strong>' + tx('Nodos del escenario.', 'Scenario nodes.') + '</strong> ' +
          tx('No traen coordenada propia. El enlace abre el nombre en la ontología.', 'They have no coordinate of their own. The link opens the name in the ontology.') + '</p>' +
          '<p class="cdt-nodes">' + nodes + '</p>';
        host.querySelectorAll('[data-node-muni]').forEach(function (btn) {
          btn.addEventListener('click', function () { selectMuni(btn.getAttribute('data-node-muni')); });
        });
      }

      function renderLevers() {
        var host = document.getElementById('cdt-levers');
        if (!host) return;
        var sc = scenarioById(state.scenario);
        if (state.lever && !currentLever()) state.lever = '';
        host.innerHTML = (sc.levers || []).map(function (lv) {
          var on = lv.id === state.lever;
          return '<button type="button" class="cdt-sc cdt-lever" data-lever="' + lv.id + '" aria-pressed="' + (on ? 'true' : 'false') + '">' +
            tx(lv.label_es, lv.label_en) + '</button>';
        }).join('');
        host.querySelectorAll('[data-lever]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var id = btn.getAttribute('data-lever');
            state.lever = state.lever === id ? '' : id;
            applyChrome();
          });
        });
      }

      function renderExtrudeLegend() {
        var host = document.getElementById('cdt-extrude');
        if (!host) return;
        var ind = indicatorById(state.z);
        var rows = model.munis.map(function (m) {
          var raw = m[state.z];
          var value = hasNum(raw) ? fmt(state.z, raw) : tx('sin cifra, no se levanta', 'no figure, it does not rise');
          return '<li>' + m.name + ' · ' + value + '</li>';
        }).join('');
        var opts = model.indicators.map(function (item) {
          return '<option value="' + item.id + '"' + (item.id === state.z ? ' selected' : '') + '>' + tx(item.label_es, item.label_en) + '</option>';
        }).join('');
        host.innerHTML =
          '<p><strong>' + tx('Altura municipal', 'Municipal height') + '</strong> ' +
          '<select id="cdt-z" aria-label="' + tx('Cifra de la altura', 'Height figure') + '">' + opts + '</select></p>' +
          '<p><small>' + tx(ind.source_es, ind.source_en) + ' · ' + tx(ind.unit_es, ind.unit_en) + ' · ' + ind.year + '. ' +
          tx('La altura es relativa a la cifra más alta. No son metros de terreno ni edificios.', 'Height is relative to the highest figure. These are not meters of terrain or buildings.') +
          (gl ? '' : ' ' + tx('Sin mapa 3D, el círculo usa la misma cifra.', 'Without the 3D map, the circle uses the same figure.')) +
          '</small></p><ul>' + rows + '</ul>';
        var sel = document.getElementById('cdt-z');
        if (sel) sel.addEventListener('change', function () {
          state.z = sel.value;
          refreshMuniStyle();
          renderCambia();
          writeUrl();
        });
      }

      function renderCambia() {
        var host = document.getElementById('cdt-cambia-body');
        if (!host) return;
        var sc = scenarioById(state.scenario);
        var ids = presetIds();
        var cmp = compareOnly();
        var lines = ids.map(function (id) {
          var meta = layerMeta(id);
          var name = meta ? tx(meta.name_es, meta.name_en) : id;
          return '<li>' + name + (cmp[id] ? ' · ' + tx('solo en la comparación', 'only in the comparison') : '') + '</li>';
        }).join('');
        var other = state.compare ? scenarioById(state.compare) : null;
        var lever = currentLever();
        var ind = indicatorById(state.z);
        var missing = model.munis.filter(function (m) { return !hasNum(m[state.z]); }).map(function (m) { return m.name; });
        host.innerHTML =
          (lever ? '<p><strong>' + tx('Palanca: ', 'Lever: ') + tx(lever.label_es, lever.label_en) + '.</strong> ' + tx(lever.read_es, lever.read_en) + '</p>' : '') +
          '<p>' + tx(sc.note_es, sc.note_en) + '</p>' +
          '<p><strong>' + tx('Altura: ', 'Height: ') + '</strong>' + tx(ind.label_es, ind.label_en) + ' · ' + tx(ind.source_es, ind.source_en) + '. ' +
          (missing.length ? tx('Sin volumen: ', 'No volume: ') + missing.join(' · ') + '.' : tx('Los cinco municipios tienen cifra.', 'All five municipalities have a figure.')) + '</p>' +
          '<p><strong>' + tx('Municipios en tensión: ', 'Municipalities under stress: ') + '</strong>' + (sc.stress || []).join(' · ') + '</p>' +
          (other ? '<p><strong>' + tx('Comparado con ', 'Compared with ') + tx(other.title_es, other.title_en) + '.</strong> ' +
            (Object.keys(cmp).length
              ? tx('Se suman capas que este escenario no trae: ', 'Layers this scenario does not already include: ') + Object.keys(cmp).map(function (id) { var meta = layerMeta(id); return meta ? tx(meta.name_es, meta.name_en) : id; }).join(' · ') + '.'
              : tx('Este escenario ya incluye las capas del otro.', 'This scenario already includes the other scenario’s layers.')) +
            '</p>' : '') +
          '<ul>' + lines + '</ul>';
      }

      function renderCapas(onIds, cmp) {
        var host = document.getElementById('cdt-capas-body');
        if (!host) return;
        var ids = onIds || wantedLayers();
        var on = {};
        ids.forEach(function (id) { on[id] = 1; });
        cmp = cmp || compareOnly();
        var q = capasQ.toLowerCase();
        var countEl = document.getElementById('cdt-capas-count');
        if (countEl) countEl.textContent = tx(ids.length + ' capas activas', ids.length + ' layers on');
        var search = document.getElementById('cdt-capas-q');
        if (search && document.activeElement !== search) {
          search.placeholder = tx('Filtrar capas', 'Filter layers');
          search.value = capasQ;
        }
        var html = '';
        (model.layerGroups || []).forEach(function (g) {
          var theme = themeById(g.id);
          var items = '';
          (g.layers || []).forEach(function (id) {
            var meta = layerMeta(id);
            if (!meta) return;
            var label = tx(meta.name_es, meta.name_en);
            var blob = (label + ' ' + tx(meta.source_es, meta.source_en)).toLowerCase();
            if (q && blob.indexOf(q) === -1) return;
            items += '<label><input type="checkbox" data-layer="' + id + '"' + (on[id] ? ' checked' : '') + '> <span>' +
              label +
              (cmp[id] ? ' · ' + tx('comparar', 'compare') : '') +
              '<small>' + tx(meta.source_es, meta.source_en) + ' · ' + tx(meta.year_es, meta.year_en) + '</small></span></label>';
          });
          if (!items) return;
          html += '<section class="cdt-capas-group"><h3>' + tx(theme.es, theme.en) + '</h3>' + items + '</section>';
        });
        if (!html) html = '<p>' + tx('Ninguna capa coincide con el filtro.', 'No layer matches the filter.') + '</p>';
        host.innerHTML = html;
        host.querySelectorAll('[data-layer]').forEach(function (box) {
          box.addEventListener('change', function () {
            var id = box.getAttribute('data-layer');
            if (box.checked) { layerExtra[id] = 1; delete layerOff[id]; }
            else { layerOff[id] = 1; delete layerExtra[id]; }
            syncLayers();
          });
        });
      }

      function bootMunis() {
        return fetch('/gis/osm_municipalities.geojson').then(function (r) { return r.json(); }).then(function (geo) {
          muniLayer = L.geoJSON(geo, {
            style: styleMuni,
            onEachFeature: function (feat, layer) {
              var name = feat.properties && feat.properties.name;
              layer.on('click', function () { if (name) selectMuni(name); });
              if (name) layer.bindTooltip(name, { sticky: true });
            },
          }).addTo(map);
        });
      }

      document.querySelectorAll('[data-theme]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          state.theme = btn.getAttribute('data-theme');
          resetLayerPins();
          applyChrome();
          syncLayers();
        });
      });
      document.querySelectorAll('[data-scenario]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          state.scenario = btn.getAttribute('data-scenario');
          if (state.compare === state.scenario) state.compare = '';
          resetLayerPins();
          applyChrome();
          syncLayers().then(fitScenario);
        });
      });
      var cmpSel = document.getElementById('cdt-compare');
      if (cmpSel) cmpSel.addEventListener('change', function () {
        state.compare = cmpSel.value && cmpSel.value !== state.scenario ? cmpSel.value : '';
        resetLayerPins();
        applyChrome();
        syncLayers();
      });
      document.querySelectorAll('[data-muni-btn]').forEach(function (btn) {
        btn.addEventListener('click', function () { selectMuni(btn.getAttribute('data-muni-btn')); });
      });

      var selX = document.getElementById('cdt-x');
      var selY = document.getElementById('cdt-y');
      function onAxis() {
        state.x = selX.value;
        state.y = selY.value;
        if (state.x === state.y) {
          state.y = model.indicators.map(function (i) { return i.id; }).filter(function (id) { return id !== state.x; })[0];
          selY.value = state.y;
        }
        refreshMuniStyle();
        renderScatter();
        writeUrl();
      }
      var capasSearch = document.getElementById('cdt-capas-q');
      if (capasSearch) capasSearch.addEventListener('input', function () {
        capasQ = capasSearch.value || '';
        renderCapas(wantedLayers(), compareOnly());
      });
      if (selX) selX.addEventListener('change', onAxis);
      if (selY) selY.addEventListener('change', onAxis);
      var shareBtn = document.getElementById('cdt-share');
      if (shareBtn) shareBtn.addEventListener('click', function () {
        var url = location.href;
        function done(ok) { setStatus(ok ? 'Enlace copiado.' : url, ok ? 'Link copied.' : url); }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(function () { done(true); }).catch(function () { done(false); });
        } else done(false);
      });
      var printBtn = document.getElementById('cdt-print');
      if (printBtn) printBtn.addEventListener('click', function () {
        renderSheet();
        window.print();
      });
      document.querySelectorAll('[data-path]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var id = btn.getAttribute('data-path');
          state.path = state.path === id ? '' : id;
          focusPath(true);
          renderSheet();
          writeUrl();
        });
      });

      document.addEventListener('bcs:lang', function () {
        fillSelects();
        renderScatter();
        renderDetail();
        renderCambia();
        renderExtrudeLegend();
        renderLevers();
        syncLayers();
      });

      fillSelects();
      applyChrome();
      if (state.path) window.setTimeout(function () { focusPath(true); }, 350);
      renderScatter();
      selectMuni(state.muni);
      var reduceMotion = false;
      try { reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
      var want3d = window.CDT3D && CDT3D.hasWebGL() && typeof maplibregl !== 'undefined';
      var boot3d = want3d ? CDT3D.start({
        container: mapEl,
        reduced: reduceMotion,
        onMunicipality: function (name) { selectMuni(name); },
      }) : Promise.reject();
      boot3d.then(function (eng) {
        gl = eng;
        refreshMuniStyle();
      }).catch(function () {
        ensure2d();
        return bootMunis();
      }).then(function () {
        return syncLayers();
      }).then(fitScenario).catch(function () {
        setStatus('No se pudo cargar el mapa.', 'The map could not load.');
      });
    })();
  </script>
</BaseLayout>
