        if (!window.matchMedia('(max-width: 980px)').matches) return;
        var root = document.documentElement;
        var prev = root.style.scrollBehavior;
        root.style.scrollBehavior = 'auto';
        wrap.scrollIntoView({ block: 'nearest', behavior: 'auto' });
        root.style.scrollBehavior = prev;
      }
      function selectMuni(name, sheet) {
        state.muni = name;
        refreshMuniStyle();
        document.querySelectorAll('.cdt-table tr[data-muni]').forEach(function (tr) {
          tr.classList.toggle('is-on', tr.getAttribute('data-muni') === name);
        });
        renderDetail();
        renderScatter();
        applyContext();
        updateMapLink();
        writeUrl();
        if (sheet) openFicheSheet();
      }

      function renderDetail() {
        var el = document.getElementById('cdt-fiche');
        var side = document.getElementById('cdt-muni-detail');
        var m = muniByName(state.muni);
        var ind = indicatorById(state.z);
        var raw = m[state.z];
        var figure = hasNum(raw) ? fmt(state.z, raw) + ' ' + tx(ind.unit_es, ind.unit_en) : '—';
        var offer = plain(tx(m.strengths_es, m.strengths_en));
        var demand = plain(tx(m.locks_es, m.locks_en));
        var balances = (m.subplaces || []).map(function (s) {
          var text = plain(tx(s.balance_es, s.balance_en));
          if (!text) return '';
          return '<p><strong>' + tx(s.name_es, s.name_en) + '.</strong> ' + text + '</p>';
        }).join('');
        var placeIds = (m.subplaces || []).map(function (s) { return s.id; });
        var recs = '';
        document.querySelectorAll('#cdt-rec-list .cdt-rec').forEach(function (card) {
          if (card.hidden) return;
          if (placeIds.indexOf(card.getAttribute('data-rec-id')) === -1) return;
          var name = card.querySelector('.cdt-rec-kicker');
          var rule = card.querySelector('.cdt-rec-rule');
          recs += '<p><strong>' + (name ? name.innerText.trim() : '') + '.</strong> ' + (rule ? rule.innerText.trim() : '') + '</p>';
        });
        var lever = currentLever();
        var leverOn = lever && (m.subplaces || []).some(function (s) { return s.balance === lever.balance; });
        var learn = (typeof learnByTheme !== 'undefined' && learnByTheme[state.theme]) || '';
        var catLabel = {
          cabecera: ['Cabecera', 'Municipal seat'],
          localidad: ['Localidad', 'Locality'],
          puerto: ['Puerto', 'Port'],
          carretera: ['Carretera', 'Highway'],
          anp: ['ANP', 'Protected area'],
          turismo: ['Turismo', 'Tourism'],
          tenencia: ['Propiedad del suelo', 'Land ownership'],
        };
        var stills = (m.stills || []).filter(function (s) { return s && typeof s.thumb === 'string' && s.thumb.indexOf('/stills/') === 0; });
        var photos = '';
        if (stills.length) {
          photos = '<div class="cdt-stills">' + stills.map(function (s) {
            var pair = catLabel[s.category];
            var cat = pair ? tx(pair[0], pair[1]) : '';
            return '<figure><a href="/vistas/#' + esc(s.vista) + '"><img src="' + esc(s.thumb) + '" alt="' + esc(s.name) + '" width="160" height="90" loading="lazy" onerror="var box=this.closest(\'.cdt-stills\'); var f=this.closest(\'figure\'); if(f) f.remove(); if(box && !box.querySelector(\'img\')){ var n=box.nextElementSibling; if(n && n.classList.contains(\'cdt-still-credit\')) n.remove(); box.remove(); }" /><figcaption>' + esc(s.name) + (cat ? ' · ' + esc(cat) : '') + '</figcaption></a></figure>';
          }).join('') + '</div><p class="cdt-still-credit">' + tx('Fotograma territorial. No es una cifra. ', 'Territory frame. It is not a figure. ') + '<a href="/stills/">' + tx('Fotos del territorio', 'Territory photos') + '</a></p>';
        }
        var sum = document.getElementById('cdt-fiche-sum');
        if (sum) sum.textContent = tx('Ficha · ', 'Fiche · ') + m.name;
        var html =
          '<h2>' + m.name + '</h2>' +
          photos +
          '<p><strong>' + tx(ind.label_es, ind.label_en) + '.</strong> ' + figure + '. ' +
          tx(ind.source_es, ind.source_en) + ' · ' + ind.year + '.</p>' +
          (offer ? '<p><strong>' + tx('Oferta. ', 'Supply. ') + '</strong>' + offer + '</p>' : '') +
          (demand ? '<p><strong>' + tx('Demanda. ', 'Demand. ') + '</strong>' + demand + '</p>' : '') +
          (balances ? '<p><strong>' + tx('Balance. ', 'Balance. ') + '</strong></p>' + balances : '') +
          (leverOn ? '<p><strong>' + tx('Palanca. ', 'Lever. ') + '</strong>' + tx(lever.read_es, lever.read_en) + '</p>' : '') +
          (recs ? '<p><strong>' + tx('Recomendación. ', 'Recommendation. ') + '</strong></p>' + recs : '') +
          '<p><a href="' + m.vista + '">' + tx('Vista: ', 'View: ') + tx(m.vista_es, m.vista_en) + '</a>' +
          (learn ? ' · <a href="' + learn + '">' + tx('Aprendizaje de este tema', 'Learning for this theme') + '</a>' : '') +
          ' · <a href="' + m.crecimiento + '">' + tx('Demanda y oferta', 'Demand and supply') + '</a></p>';
        if (el) el.innerHTML = html;
        if (side) side.innerHTML = '<p><a href="#cdt-fiche">' + m.name + '</a> · ' + figure + '</p>';
      }

      function renderScatter() {
        var host = document.getElementById('cdt-scatter');
        if (!host) return;
        var xi = indicatorById(state.x);
        var yi = indicatorById(state.y);
        var W = 340, H = 230, Lft = 46, Bot = 36, Rgt = 12, Top = 14;
        var strip = document.getElementById('cdt-quality-strip');
        if (strip) {
          function card(ind) {
            var cov = ind.complete
              ? tx('Cobertura: cinco municipios.', 'Coverage: five municipalities.')
              : tx('Cobertura incompleta.', 'Incomplete coverage.');
            return '<article><strong>' + tx(ind.label_es, ind.label_en) + '</strong><small>' +
              tx('Año ', 'Year ') + ind.year + ' · ' + tx(ind.source_es, ind.source_en) + '. ' + cov + ' ' +
              tx(ind.quality_es, ind.quality_en) + '</small></article>';
          }
          strip.innerHTML = card(xi) + card(yi);
          if (!xi.complete || !yi.complete) {
            strip.innerHTML += '<p><a class="cdt-blank" href="/metas/">' +
              tx('Sin serie municipal en el acervo para al menos un eje. Ver preguntas abiertas.', 'No municipal series in the archive for at least one axis. See open questions.') +
              '</a></p>';
          }
        }
        var rows = model.munis.filter(function (m) { return hasNum(m[state.x]) && hasNum(m[state.y]); });
        if (rows.length < 2) {
          host.textContent = tx('No hay suficientes municipios con las dos cifras.', 'Not enough municipalities have both figures.');
          return;
        }
        var xs = rows.map(function (m) { return Number(m[state.x]); });
        var ys = rows.map(function (m) { return Number(m[state.y]); });
        var xmin = Math.min.apply(null, xs), xmax = Math.max.apply(null, xs);
        var ymin = Math.min.apply(null, ys), ymax = Math.max.apply(null, ys);
        if (xmin === xmax) { xmin -= 1; xmax += 1; }
        if (ymin === ymax) { ymin -= 1; ymax += 1; }
        function px(v) { return Lft + (v - xmin) / (xmax - xmin) * (W - Lft - Rgt); }
        function py(v) { return H - Bot - (v - ymin) / (ymax - ymin) * (H - Bot - Top); }
        var dots = rows.map(function (m) {
          var on = m.name === state.muni;
          return '<g class="cdt-dot" data-dot="' + m.name + '" style="cursor:pointer">' +
            '<circle cx="' + px(m[state.x]).toFixed(1) + '" cy="' + py(m[state.y]).toFixed(1) +
            '" r="' + (on ? 7 : 5) + '" fill="#0083C4" stroke="' + (on ? '#0b3a56' : '#fff') + '" stroke-width="' + (on ? 2.5 : 1.2) + '"></circle>' +
            '<text x="' + (px(m[state.x]) + 8).toFixed(1) + '" y="' + (py(m[state.y]) - 6).toFixed(1) +
            '" font-size="10" fill="#1a1a1a">' + m.short + '</text></g>';
        }).join('');
        host.innerHTML =
          '<svg viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="' + tx('Comparación municipal', 'Municipal comparison') + '">' +
          '<line x1="' + Lft + '" y1="' + (H - Bot) + '" x2="' + (W - Rgt) + '" y2="' + (H - Bot) + '" stroke="#d0d0d0"/>' +
          '<line x1="' + Lft + '" y1="' + Top + '" x2="' + Lft + '" y2="' + (H - Bot) + '" stroke="#d0d0d0"/>' +
          '<text x="' + Lft + '" y="' + (H - 8) + '" font-size="10" fill="#5a5a5a">' + tx(xi.label_es, xi.label_en) + '</text>' +
          '<text x="12" y="' + (Top + 8) + '" font-size="10" fill="#5a5a5a">' + tx(yi.label_es, yi.label_en) + '</text>' +
          '<text x="' + Lft + '" y="' + (H - Bot + 12) + '" font-size="9" fill="#5a5a5a">' + fmt(state.x, xmin) + '</text>' +
          '<text x="' + (W - Rgt - 36) + '" y="' + (H - Bot + 12) + '" font-size="9" fill="#5a5a5a">' + fmt(state.x, xmax) + '</text>' +
          dots +
          '</svg>';
        host.querySelectorAll('[data-dot]').forEach(function (g) {
          g.addEventListener('click', function () { selectMuni(g.getAttribute('data-dot'), true); });
        });
        var src = document.getElementById('cdt-sources');
        if (src) {
          src.textContent = tx(
            xi.source_es + ' · ' + yi.source_es + '. ' + xi.quality_es + ' ' + yi.quality_es + ' Cada punto es un municipio. No hay línea de tendencia.',
            xi.source_en + ' · ' + yi.source_en + '. ' + xi.quality_en + ' ' + yi.quality_en + ' Each point is a municipality. There is no trend line.'
          );
        }
      }

      function fillSelects() {
        ['cdt-x', 'cdt-y'].forEach(function (id) {
          var sel = document.getElementById(id);
          if (!sel) return;
          var current = id === 'cdt-x' ? state.x : state.y;
          sel.innerHTML = model.indicators.map(function (ind) {
            return '<option value="' + ind.id + '"' + (ind.id === current ? ' selected' : '') + '>' +
              tx(ind.label_es, ind.label_en) + '</option>';
          }).join('');
        });
      }

      function presetIds() {
        var theme = themeById(state.theme);
        var sc = scenarioById(state.scenario);
        var ids = (theme.layers || []).concat(sc.priority_layer_ids || []);
        if (state.compare) ids = ids.concat(scenarioById(state.compare).priority_layer_ids || []);
        return uniq(ids);
      }
      function wantedLayers() {
        return uniq(presetIds().filter(function (id) { return !layerOff[id]; }).concat(Object.keys(layerExtra)));
      }
      function partition() {
        var theme = (themeById(state.theme).layers || []).slice();
        var aList = theme.concat(scenarioById(state.scenario).priority_layer_ids || []);
        var bList = state.compare ? theme.concat(scenarioById(state.compare).priority_layer_ids || []) : theme.slice();
        function bag(list) {
          var o = {};
          list.forEach(function (id) { if (id && !layerOff[id]) o[id] = 1; });
          Object.keys(layerExtra).forEach(function (id) { o[id] = 1; });
          return o;
        }
        var A = bag(aList);
        var B = state.compare ? bag(bList) : {};
        var onlyA = [];
        var onlyB = [];
        var both = [];
        Object.keys(A).forEach(function (id) {
          if (!state.compare || B[id]) both.push(id);
          else onlyA.push(id);
        });
        if (state.compare) Object.keys(B).forEach(function (id) { if (!A[id]) onlyB.push(id); });
        return { onlyA: onlyA, onlyB: onlyB, both: both, A: A, B: B };
      }
      function idsOf(bag) { return Object.keys(bag); }
      function wideScreen() {
        try { return window.matchMedia('(min-width: 980px)').matches; } catch (e) { return true; }
      }
      function compareOnly() {
        var only = {};
        if (!state.compare) return only;
        var keep = {};
        var theme = themeById(state.theme);
        var sc = scenarioById(state.scenario);
        (theme.layers || []).concat(sc.priority_layer_ids || []).forEach(function (id) { keep[id] = 1; });
        (scenarioById(state.compare).priority_layer_ids || []).forEach(function (id) {
          if (!keep[id]) only[id] = 1;
        });
        return only;
      }
      function resetLayerPins() {
        layerOff = {};
        layerExtra = {};
      }

      function pointLayer(meta) {
        return function (feat, latlng) {
          return L.circleMarker(latlng, {
            radius: 5,
            color: meta.color,
            weight: 1,
            fillColor: meta.color,
            fillOpacity: 0.85,
          });
        };
      }

      function popupHtml(feat) {
        var p = feat.properties || {};
        var name = p.name_es || p.name || p.proyecto || p.NOMBRE || p.NOM_NUC || p.ref || '';
        return name ? String(name) : '';
      }

      function ensureLayer(id) {
        if (loaded[id]) return Promise.resolve(loaded[id]);
        var meta = layerMeta(id);
        if (!meta) return Promise.resolve(null);
        return fetch(meta.url).then(function (r) { return r.json(); }).then(function (geo) {
          var isPoint = meta.type === 'point' || meta.type === 'points';
          var layer = L.geoJSON(geo, {
            interactive: isPoint,
            style: function () {
              if (meta.type === 'line') return { color: meta.color, weight: 1.6, opacity: 0.9 };
              return { color: meta.color, weight: 1, fillColor: meta.color, fillOpacity: 0.16 };
            },
            pointToLayer: pointLayer(meta),
            onEachFeature: function (feat, layer) {
              var html = popupHtml(feat);
              if (html && isPoint) layer.bindPopup(html);
            },
          });
          layer._cdtPoint = isPoint;
          loaded[id] = layer;
          return layer;
        }).catch(function () {
          loaded[id] = null;
          return null;
        });
      }

      function syncLayers() {
        var partNow = partition();
        var splitNow = !!(state.compare && glB && wideScreen());
        var ids = wantedLayers();
        if (state.compare && splitNow) ids = idsOf(partNow.A);
        else if (state.compare && state.ab === 'a') ids = idsOf(partNow.A);
        else if (state.compare && state.ab === 'b') ids = idsOf(partNow.B);
        var want = {};
        ids.forEach(function (id) { want[id] = 1; });
        var cmp = compareOnly();
        var names = ids.map(function (id) {
          var meta = layerMeta(id);
          var label = meta ? tx(meta.name_es, meta.name_en) : id;
          return cmp[id] ? label + (lang() === 'en' ? ' (compare)' : ' (comparar)') : label;
        });
        var nameEl = document.getElementById('cdt-layer-names');
        if (nameEl) nameEl.textContent = tx('Capas: ', 'Layers: ') + names.join(' · ');
        var fuenteIds = ids.slice();
        if (state.compare && splitNow) fuenteIds = uniq(idsOf(partNow.A).concat(idsOf(partNow.B)));
        fuentesIds = fuenteIds;
        renderFuentes(fuenteIds);
        renderCapas(ids, cmp);
        if (gl) {
          var part = partition();
          var split = !!(state.compare && glB && wideScreen());
          var showIds = ids;
          var hi = cmp;
          if (state.compare && !split) {
            if (state.ab === 'a') { showIds = idsOf(part.A); hi = {}; }
            else if (state.ab === 'b') { showIds = idsOf(part.B); hi = {}; }
          } else if (split) {
            showIds = idsOf(part.A);
            hi = {};
          }
          var showSet = {};
          showIds.forEach(function (id) { showSet[id] = 1; });
          model.layerCatalog.forEach(function (meta) {
            if (!showSet[meta.id] && gl.hide) gl.hide(meta.id);
          });
          var jobs = showIds.map(function (id) {
            var meta = layerMeta(id);
            if (!meta) return Promise.resolve('fail');
            return gl.load(meta).then(function (geo) {
              if (!geo) return 'fail';
              gl.show(id, geo, meta, hi[id] ? 'compare' : 'on');
              return 'ok';
            });
          });
          if (split) {
            var bSet = {};
            idsOf(part.B).forEach(function (id) { bSet[id] = 1; });
            model.layerCatalog.forEach(function (meta) {
              if (!bSet[meta.id] && glB.hide) glB.hide(meta.id);
            });
            idsOf(part.B).forEach(function (id) {
              var meta = layerMeta(id);
              if (!meta) return;
              jobs.push(glB.load(meta).then(function (geo) {
                if (!geo) return 'fail';
                glB.show(id, geo, meta, 'on');
                if (glB.paintMunis) glB.paintMunis(muniColors());
                if (glB.setExtrusion) glB.setExtrusion(extrusionHeights());
                return 'ok';
              }));
            });
          }
          return Promise.all(jobs).then(function (flags) {
            var failed = flags.filter(function (f) { return f === 'fail'; });
            if (failed.length) setStatus('Algunas capas no cargaron.', 'Some layers did not load.');
            else setStatus(
              'Relieve del estado. El color compara municipios. Las capas del tema y del escenario están encendidas.',
              'State terrain. Color compares municipalities. Theme and scenario layers are on.'
            );
          });
        }
        Object.keys(active).forEach(function (id) {
          if (!want[id] && map) {
            map.removeLayer(active[id]);
            delete active[id];
          }
        });
        return Promise.all(ids.map(function (id) {
          return ensureLayer(id).then(function (layer) {
            if (!layer || active[id] || !map) return;
            if (!want[id]) return;
            layer.addTo(map);
            active[id] = layer;
          });
        })).then(function () {
          Object.keys(active).forEach(function (id) {
            if (active[id] && !active[id]._cdtPoint) active[id].bringToBack();
          });
          if (muniLayer) muniLayer.bringToFront();
          Object.keys(active).forEach(function (id) {
            if (active[id] && active[id]._cdtPoint) active[id].bringToFront();
          });
          var failed = ids.filter(function (id) { return loaded[id] === null; });
          if (failed.length) setStatus('Algunas capas no cargaron. El mapa queda en plano.', 'Some layers did not load. The map stays flat.');
          else setStatus('Sin mapa 3D en este navegador. Las capas siguen en el plano y el color compara municipios.', 'No 3D map in this browser. Layers stay on the flat map and color compares municipalities.');
        });
      }

      function fitScenario() {
        var sc = scenarioById(state.scenario);
        var b = sc.focus_bbox;
        function fit() {
          try {
            if (gl) {
              gl.resize();
              gl.fitBox(b && b.length === 4 ? b : null);
              if (glB && gl.readCamera) glB.jumpCamera(gl.readCamera());
              return;
            }
            if (!map || !b || b.length !== 4) return;
            map.invalidateSize();
            map.fitBounds(L.latLngBounds([b[1], b[0]], [b[3], b[2]]), { padding: [18, 18], maxZoom: 10, animate: false });
          } catch (e) {}
        }
        fit();
        setTimeout(fit, 280);
      }

      var ATLAS_LAYER = {
        settlements: 'cities',
        osm_towns: 'cities',
        poer_ugas: 'zoning',
        anp_federales: 'protected',
        rtp_conabio: 'priority',
        osm_highways: 'roads',
        highway_nodes: 'roads',
        osm_transport_nodes: 'transport'
      };
      function updateMapLink() {
        var a = document.getElementById('cdt-map-link');
        if (a) {
          var ids = wantedLayers();
          a.href = '/mapas?scenario=' + encodeURIComponent(state.scenario) + '&layers=' + encodeURIComponent(ids.join(',')) + '#gis';
        }
        var atlas = document.getElementById('cdt-atlas');
        if (!atlas) return;
        var seen = {};
        var capas = [];
        (themeById(state.theme).layers || []).forEach(function (id) {
          var name = ATLAS_LAYER[id];
          if (!name || seen[name]) return;
          seen[name] = 1;
          capas.push(name);
        });
        var q = new URLSearchParams();
        q.set('tema', state.theme);
        if (capas.length) q.set('capas', capas.join(','));
        if (state.muni) q.set('muni', state.muni);
        atlas.href = '/explorar/?' + q.toString();
      }

      function writeUrl() {
        var q = new URLSearchParams();
        q.set('theme', state.theme);
        q.set('scenario', state.scenario);
        if (state.compare && state.compare !== state.scenario) q.set('compare', state.compare);
        if (state.lever && currentLever()) q.set('lever', state.lever);
        if (state.z) q.set('z', state.z);
        if (state.path) q.set('path', state.path);
        q.set('x', state.x);
        q.set('y', state.y);
        q.set('muni', state.muni);
        history.replaceState(null, '', location.pathname + '?' + q.toString() + location.hash);
      }

      function applyContext() {
        var m = muniByName(state.muni);
        var placeIds = (m.subplaces || []).map(function (s) { return s.id; });
        document.querySelectorAll('[data-goal-places]').forEach(function (li) {
          var places = (li.getAttribute('data-goal-places') || '').split(/\s+/);
          var themes = (li.getAttribute('data-goal-themes') || '').split(/\s+/);
          var hit = themes.indexOf(state.theme) !== -1 && places.some(function (id) { return placeIds.indexOf(id) !== -1; });
          li.hidden = !hit;
        });
        document.querySelectorAll('[data-aim]').forEach(function (li) {
          li.hidden = placeIds.indexOf(li.getAttribute('data-aim')) === -1;
        });
        document.querySelectorAll('[data-couple]').forEach(function (ul) {
          ul.hidden = ul.getAttribute('data-couple') !== state.theme;
        });
        document.querySelectorAll('[data-qcount]').forEach(function (el) {
          el.classList.toggle('is-on', el.getAttribute('data-qcount') === state.theme);
        });
        var shown = 0;
        document.querySelectorAll('#cdt-dep-list [data-where]').forEach(function (li) {
          var where = li.getAttribute('data-where') || '';
          var match = where.indexOf(m.name) !== -1;
          var keep = match && shown < 6;
          if (keep) shown += 1;
          li.hidden = !keep;
        });
      }

      function applyChrome() {
        document.querySelectorAll('[data-theme]').forEach(function (btn) {
          btn.setAttribute('aria-pressed', btn.getAttribute('data-theme') === state.theme ? 'true' : 'false');
        });
        document.querySelectorAll('[data-theme-panel]').forEach(function (panel) {
          panel.hidden = panel.getAttribute('data-theme-panel') !== state.theme;
        });
        document.querySelectorAll('[data-scenario]').forEach(function (btn) {
          btn.setAttribute('aria-pressed', btn.getAttribute('data-scenario') === state.scenario ? 'true' : 'false');
        });
        document.querySelectorAll('[data-scenario-copy]').forEach(function (block) {
          block.hidden = block.getAttribute('data-scenario-copy') !== state.scenario;
        });
        document.querySelectorAll('[data-rec-themes]').forEach(function (card) {
          var themes = (card.getAttribute('data-rec-themes') || '').split(/\s+/);
          var scenarios = (card.getAttribute('data-rec-scenarios') || '').split(/\s+/);
          var show = themes.indexOf(state.theme) !== -1 && scenarios.indexOf(state.scenario) !== -1;
          card.hidden = !show;
        });
        var cmpSel = document.getElementById('cdt-compare');
        if (cmpSel) {
          var cur = state.compare;
          cmpSel.innerHTML = '<option value="">' + tx('Ninguno', 'None') + '</option>' +
            model.scenarios.map(function (sc) {
              if (sc.id === state.scenario) return '';
              return '<option value="' + sc.id + '"' + (sc.id === cur ? ' selected' : '') + '>' + tx(sc.title_es, sc.title_en) + '</option>';
            }).join('');
        }
        renderLevers();
        renderCambia();
        renderExtrudeLegend();
        document.querySelectorAll('[data-balance]').forEach(function (card) {
          var lever = currentLever();
          var on = !!(lever && !card.hidden && card.getAttribute('data-balance') === lever.balance);
          card.classList.toggle('is-lever', on);
        });
        renderCruce();
        renderSplitChrome();
        renderDetail();
        focusPath(false);
        renderSheet();
        updateMapLink();
        applyContext();
        writeUrl();
      }

      function focusPath(scroll) {
        document.body.dataset.cdtPath = state.path || '';
        document.querySelectorAll('[data-path]').forEach(function (btn) {
          btn.setAttribute('aria-pressed', btn.getAttribute('data-path') === state.path ? 'true' : 'false');
        });
        document.querySelectorAll('[data-step]').forEach(function (el) {
          el.classList.toggle('is-step', !!state.path && el.getAttribute('data-step') === state.path);
        });
        renderConsulta();
        if (!scroll || !state.path) return;
        var target = document.querySelector('[data-step="' + state.path + '"].is-step');
        if (!target) return;
        var root = document.documentElement;
        var prev = root.style.scrollBehavior;
        root.style.scrollBehavior = 'auto';
        target.scrollIntoView({ block: 'start', behavior: 'auto' });
        root.style.scrollBehavior = prev;
      }

      function renderConsulta() {
        var host = document.getElementById('cdt-consulta-body');
        if (!host) return;
        var theme = themeById(state.theme);
        var sc = scenarioById(state.scenario);
        var tema = tx(theme.es, theme.en);
        var escenario = tx(sc.title_es, sc.title_en);
        var muni = muniByName(state.muni).name;
        function fill(pair) {
          return tx(pair[0], pair[1]).replace('{tema}', tema).replace('{escenario}', escenario).replace('{muni}', muni);
        }
        var book = {
          diagnostico: [
            ['Gobierno', 'Government', '¿Qué cifra ya publicada de «{tema}» cambia la lectura de {muni}?', 'Which published figure for “{tema}” changes the reading of {muni}?'],
            ['Sector privado', 'Private sector', '¿Qué demanda de «{escenario}» ya está escrita, y qué oferta no se da por hecha?', 'Which demand in “{escenario}” is already written, and which supply is not taken for granted?'],
            ['Sociedad civil', 'Civil society', '¿Qué celda de esta ficha está en blanco y por eso no se decide?', 'Which cell on this fiche is blank, and so is not decided?']
          ],
          meta: [
            ['Gobierno', 'Government', '¿Qué pregunta abierta de {muni}, en «{tema}», sigue sin respuesta?', 'Which open question for {muni}, in “{tema}”, is still unanswered?'],
            ['Sector privado', 'Private sector', '¿Qué meta de este lugar depende de un servicio que «{escenario}» no da por hecho?', 'Which goal for this place depends on a service “{escenario}” does not take for granted?'],
            ['Sociedad civil', 'Civil society', '¿A quién le falta evidencia antes de aceptar más crecimiento?', 'Who is missing evidence before accepting more growth?']
          ],
          escenario: [
            ['Gobierno', 'Government', '¿Qué cambia entre «{escenario}» y la comparación, con las capas que ya están?', 'What changes between “{escenario}” and the comparison, with the layers already on?'],
            ['Sector privado', 'Private sector', '¿La palanca de «{escenario}» adelanta una regla ya escrita, o solo un deseo?', 'Does the lever of “{escenario}” bring forward a rule already written, or only a wish?'],
            ['Sociedad civil', 'Civil society', '¿El cruce con los otros temas sigue siendo una lectura, no una simulación?', 'Does the cross-theme reading stay a reading, not a simulation?']
          ],
          recomendacion: [
            ['Gobierno', 'Government', '¿Qué regla del portal se aplica a {muni} en «{escenario}»?', 'Which portal rule applies to {muni} in “{escenario}”?'],
            ['Sector privado', 'Private sector', '¿Qué no se abre en «{tema}» si falta una cifra o una oferta?', 'What does not open in “{tema}” if a figure or a supply is missing?'],
            ['Sociedad civil', 'Civil society', '¿Qué se lleva la mesa si una celda de {muni} sigue en blanco?', 'What does the table take away if a cell for {muni} stays blank?']
          ]
        };
        var rows = book[state.path];
        if (!rows) {
          host.innerHTML = '<p>' + tx('Elija diagnóstico, meta, escenario o recomendación. Las preguntas siguen ese paso.', 'Choose diagnosis, goal, scenario or recommendation. The questions follow that step.') + '</p>';
          return;
        }
        host.innerHTML = '<div class="cdt-consulta-grid">' + rows.map(function (row) {
          return '<article><h3>' + tx(row[0], row[1]) + '</h3><p>' + esc(fill([row[2], row[3]])) + '</p></article>';
        }).join('') + '</div>';
      }

      function renderSheet() {
        var host = document.getElementById('cdt-sheet');
        if (!host) return;
        var theme = themeById(state.theme);
        var sc = scenarioById(state.scenario);
        var lever = currentLever();
        var ind = indicatorById(state.z);
        var missing = model.munis.filter(function (m) { return !hasNum(m[state.z]); }).map(function (m) { return m.name; });
        var recs = [];
        document.querySelectorAll('#cdt-rec-list .cdt-rec').forEach(function (card) {
          if (card.hidden || recs.length >= 4) return;
          var name = card.querySelector('.cdt-rec-kicker');
          var rule = card.querySelector('.cdt-rec-rule');
          recs.push('<li><strong>' + (name ? name.innerText.trim() : '') + '.</strong> ' + (rule ? rule.innerText.trim() : '') + '</li>');
        });
        host.innerHTML =
          '<h2>' + tx('Hoja del escenario', 'Scenario sheet') + '</h2>' +
          '<p><strong>' + tx('Tema. ', 'Theme. ') + '</strong>' + tx(theme.es, theme.en) + '</p>' +
          '<p><strong>' + tx('Escenario. ', 'Scenario. ') + '</strong>' + tx(sc.title_es, sc.title_en) +
          (state.compare ? ' · ' + tx('comparado con ', 'compared with ') + tx(scenarioById(state.compare).title_es, scenarioById(state.compare).title_en) : '') +
          '. ' + tx(sc.blurb_es, sc.blurb_en) + '</p>' +
          '<p><strong>' + tx('Palanca. ', 'Lever. ') + '</strong>' + (lever ? tx(lever.label_es, lever.label_en) + '. ' + tx(lever.read_es, lever.read_en) : tx('Ninguna.', 'None.')) + '</p>' +
          '<p><strong>' + tx('Municipio. ', 'Municipality. ') + '</strong>' + muniByName(state.muni).name + '. ' +
          tx(ind.label_es, ind.label_en) + ': ' + (hasNum(muniByName(state.muni)[state.z]) ? fmt(state.z, muniByName(state.muni)[state.z]) : '—') + '.</p>' +
          '<p><strong>' + tx('Municipios en tensión. ', 'Municipalities under stress. ') + '</strong>' + (sc.stress || []).join(' · ') + '</p>' +
          '<p><strong>' + tx('Altura. ', 'Height. ') + '</strong>' + tx(ind.label_es, ind.label_en) + ' · ' + tx(ind.source_es, ind.source_en) + '. ' +
          (missing.length ? tx('Sin cifra: ', 'No figure: ') + missing.join(' · ') + '.' : tx('Los cinco municipios tienen cifra.', 'All five municipalities have a figure.')) + '</p>' +
          '<p><strong>' + tx('Recomendación. ', 'Recommendation. ') + '</strong></p><ul>' + recs.join('') + '</ul>' +
          '<p>' + tx('El cruce con los otros temas es cualitativo. No es una simulación.', 'The cross-theme reading is qualitative. It is not a simulation.') + '</p>' +
          '<p>' + location.href + '</p>';
      }

      function renderCruce() {
        var host = document.getElementById('cdt-cruce-body');
        if (!host) return;
        var sc = scenarioById(state.scenario);
        var lever = currentLever();
        var lines = (model.couplings[state.theme] || []).map(function (c) {
          var other = themeById(c.to);
          var front = !!(lever && lever.read_es === c.es);
          return '<li' + (front ? ' class="is-front"' : '') + '><strong>' + tx(other.es, other.en) + '.</strong> ' + tx(c.es, c.en) + '</li>';
        }).join('');
        var nodes = (sc.nodes || []).map(function (n) {
          var see = n.muni
            ? ' <button type="button" class="cdt-node-btn" data-node-muni="' + n.muni + '">' + tx('Ver en el mapa', 'See on the map') + '</button>'
            : '';
          return '<span><a class="cdt-node" href="' + n.href + '">' + tx(n.label, n.label_en) + '</a>' + see + '</span>';
        }).join('');
        host.innerHTML =
          '<p>' + tx('Lectura cualitativa de las reglas del portal. No es un motor de simulación.', 'A qualitative reading of the portal’s rules. It is not a simulation engine.') + '</p>' +
          (lever
            ? '<p><strong>' + tx('Palanca delante: ', 'Lever in front: ') + tx(lever.label_es, lever.label_en) + '.</strong> ' + tx(lever.read_es, lever.read_en) + '</p>'
            : '<p>' + tx(sc.note_es, sc.note_en) + '</p>') +
          '<ul>' + lines + '</ul>' +
          '<p><strong>' + tx('Nodos del escenario.', 'Scenario nodes.') + '</strong> ' +
          tx('No traen coordenada propia. El enlace abre el nombre en la ontología.', 'They have no coordinate of their own. The link opens the name in the ontology.') + '</p>' +
          '<p class="cdt-nodes">' + nodes + '</p>';
        host.querySelectorAll('[data-node-muni]').forEach(function (btn) {
          btn.addEventListener('click', function () { selectMuni(btn.getAttribute('data-node-muni'), true); });
        });
      }

      function renderLevers() {
        var host = document.getElementById('cdt-levers');
        if (!host) return;
        var sc = scenarioById(state.scenario);
        if (state.lever && !currentLever()) state.lever = '';
        host.innerHTML = (sc.levers || []).map(function (lv) {
          var on = lv.id === state.lever;
          return '<button type="button" class="cdt-sc cdt-lever" data-lever="' + lv.id + '" aria-pressed="' + (on ? 'true' : 'false') + '">' +
            tx(lv.label_es, lv.label_en) + '</button>';
        }).join('');
        host.querySelectorAll('[data-lever]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var id = btn.getAttribute('data-lever');
            state.lever = state.lever === id ? '' : id;
            applyChrome();
          });
        });
      }

      function renderExtrudeLegend() {
        var host = document.getElementById('cdt-extrude');
        if (!host) return;
        var ind = indicatorById(state.z);
        var rows = model.munis.map(function (m) {
          var raw = m[state.z];
          var value = hasNum(raw) ? fmt(state.z, raw) : tx('sin cifra, queda plano', 'no figure, it stays flat');
          return '<li>' + m.name + ' · ' + value + '</li>';
        }).join('');
        var opts = model.indicators.map(function (item) {
          return '<option value="' + item.id + '"' + (item.id === state.z ? ' selected' : '') + '>' + tx(item.label_es, item.label_en) + '</option>';
        }).join('');
        host.innerHTML =
          '<p><strong>' + tx('Altura municipal', 'Municipal height') + '</strong> ' +
          '<select id="cdt-z" aria-label="' + tx('Cifra de la altura', 'Height figure') + '">' + opts + '</select></p>' +
          '<p class="cdt-legend"><span class="cdt-legend-swatch" aria-hidden="true"></span><span>' +
          tx(ind.label_es, ind.label_en) + ' · ' + tx(ind.unit_es, ind.unit_en) + ' · ' +
          tx(ind.source_es, ind.source_en) + ' · ' + ind.year + '. ' +
          tx('Sin cifra, el municipio queda plano. No es cero. ', 'With no figure, the municipality stays flat. It is not zero. ') +
          tx('La altura es relativa a la cifra más alta. No son metros de terreno ni edificios.', 'Height is relative to the highest figure. These are not meters of terrain or buildings.') +
          (gl ? '' : ' ' + tx('Sin mapa 3D, el círculo usa la misma cifra.', 'Without the 3D map, the circle uses the same figure.')) +
          '</span></p><ul>' + rows + '</ul>';
        var sel = document.getElementById('cdt-z');
        if (sel) sel.addEventListener('change', function () {
          state.z = sel.value;
          refreshMuniStyle();
          renderDetail();
          renderCambia();
          renderFuentes(fuentesIds);
          writeUrl();
        });
      }

      function renderCambia() {
        var host = document.getElementById('cdt-cambia-body');
        if (!host) return;
        var sc = scenarioById(state.scenario);
        var ids = presetIds();
        var cmp = compareOnly();
        var lines = ids.map(function (id) {
          var meta = layerMeta(id);
          var name = meta ? tx(meta.name_es, meta.name_en) : id;
          return '<li>' + name + (cmp[id] ? ' · ' + tx('solo en la comparación', 'only in the comparison') : '') + '</li>';
        }).join('');
        var other = state.compare ? scenarioById(state.compare) : null;
        var part = partition();
        var lever = currentLever();
        var ind = indicatorById(state.z);
        var missing = model.munis.filter(function (m) { return !hasNum(m[state.z]); }).map(function (m) { return m.name; });
        host.innerHTML =
          (lever ? '<p><strong>' + tx('Palanca: ', 'Lever: ') + tx(lever.label_es, lever.label_en) + '.</strong> ' + tx(lever.read_es, lever.read_en) + '</p>' : '') +
          '<p>' + tx(sc.note_es, sc.note_en) + '</p>' +
          '<p><strong>' + tx('Altura: ', 'Height: ') + '</strong>' + tx(ind.label_es, ind.label_en) + ' · ' + tx(ind.source_es, ind.source_en) + '. ' +
          (missing.length ? tx('Sin volumen: ', 'No volume: ') + missing.join(' · ') + '.' : tx('Los cinco municipios tienen cifra.', 'All five municipalities have a figure.')) + '</p>' +
          '<p><strong>' + tx('Municipios en tensión: ', 'Municipalities under stress: ') + '</strong>' + (sc.stress || []).join(' · ') + '</p>' +
          (other ? '<p><strong>' + tx('Comparado con ', 'Compared with ') + tx(other.title_es, other.title_en) + '.</strong> ' +
            (part.onlyB.length
              ? tx('Se suman capas que este escenario no trae: ', 'Layers this scenario does not already include: ') + layerNames(part.onlyB) + '.'
              : tx('Este escenario ya incluye las capas del otro.', 'This scenario already includes the other scenario’s layers.')) +
            '</p>' +
            '<p><strong>' + tx('Solo en A. ', 'Only in A. ') + '</strong>' + layerNames(part.onlyA) + '</p>' +
            '<p><strong>' + tx('Solo en B. ', 'Only in B. ') + '</strong>' + layerNames(part.onlyB) + '</p>' +
            '<p><strong>' + tx('En ambos. ', 'In both. ') + '</strong>' + layerNames(part.both) + '</p>'
            : '<ul>' + lines + '</ul>');
      }

      function layerNames(ids) {
        if (!ids || !ids.length) return tx('Ninguna.', 'None.');
        return ids.map(function (id) {
          var meta = layerMeta(id);
          return meta ? tx(meta.name_es, meta.name_en) : id;
        }).join(' · ');
      }

      function renderSplitChrome() {
        var on = !!state.compare;
        var stage = document.getElementById('cdt-stage');
        var frameB = document.getElementById('cdt-map-b-frame');
        var bar = document.getElementById('cdt-ab');
        var split = on && wideScreen() && !!gl;
        if (stage) stage.classList.toggle('is-split', split);
        if (frameB) frameB.hidden = !split;
        if (bar) {
          bar.classList.toggle('is-on', on && !split);
          bar.hidden = !(on && !split);
          bar.querySelectorAll('[data-ab]').forEach(function (btn) {
            btn.setAttribute('aria-pressed', btn.getAttribute('data-ab') === state.ab ? 'true' : 'false');
          });
        }
        var aTitle = document.getElementById('cdt-pane-a');
        var bTitle = document.getElementById('cdt-pane-b');
        var sc = scenarioById(state.scenario);
        var other = state.compare ? scenarioById(state.compare) : null;
        if (aTitle) {
          aTitle.hidden = !on;
          aTitle.textContent = on ? 'A · ' + tx(sc.title_es, sc.title_en) : '';
        }
        if (bTitle && other) bTitle.textContent = 'B · ' + tx(other.title_es, other.title_en);
      }

      var glB = null;
      var camLock = false;
      var aLinked = false;
      function linkA() {
        if (!gl || aLinked || !gl.watchMove) return;
        aLinked = true;
        gl.watchMove(function () {
          if (!glB || camLock) return;
          camLock = true;
          glB.jumpCamera(gl.readCamera());
          camLock = false;
        });
      }
      function linkB(eng) {
        if (!eng || !eng.watchMove) return;
        eng.watchMove(function () {
          if (!gl || camLock) return;
          camLock = true;
          gl.jumpCamera(eng.readCamera());
          camLock = false;
        });
      }
      function dropGlB() {
        if (glB && glB.destroy) glB.destroy();
        glB = null;
      }
      function ensureGlB() {
        if (!state.compare || !gl || !wideScreen() || !window.CDT3D) {
          dropGlB();
          renderSplitChrome();
          return Promise.resolve(null);
        }
        renderSplitChrome();
        if (glB) {
          linkA();
          if (gl.readCamera) glB.jumpCamera(gl.readCamera());
          return Promise.resolve(glB);
        }
        var reduce = false;
        try { reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
        return CDT3D.start({
          container: 'cdt-map-b',
          reduced: reduce,
          tools: false,
          onMunicipality: function (name) { selectMuni(name, true); },
        }).then(function (eng) {
          if (!state.compare || !wideScreen()) {
            if (eng && eng.destroy) eng.destroy();
            glB = null;
            renderSplitChrome();
            return null;
          }
          glB = eng;
          linkA();
          linkB(eng);
          if (gl.readCamera) eng.jumpCamera(gl.readCamera());
          return eng;
        }).catch(function () {
          glB = null;
          renderSplitChrome();
          return null;
        });
      }

      function renderFuentes(ids) {
        var host = document.getElementById('cdt-fuentes-body');
        if (!host) return;
        var lines = '';
        (ids || []).forEach(function (id) {
          var meta = layerMeta(id);
          if (!meta || !meta.source_es) return;
          lines += '<li><strong>' + esc(tx(meta.name_es, meta.name_en)) + '.</strong> ' +
            esc(tx(meta.source_es, meta.source_en)) + ' · ' + esc(tx(meta.year_es, meta.year_en)) + '</li>';
        });
        lines += '<li><strong>' + esc(tx('Límites municipales', 'Municipal boundaries')) + '.</strong> ' +
          esc(tx('OpenStreetMap — límites municipales', 'OpenStreetMap — municipal boundaries')) + ' · ' +
          esc(tx('año no registrado en el catálogo GIS', 'year not recorded in the GIS catalog')) + '</li>';
        var theme = themeById(state.theme);
        (theme.kpis || []).forEach(function (k) {
          var src = tx(k.source_es, k.source_en);
          if (src.indexOf('CONAGUA') === -1) return;
          lines += '<li><strong>' + esc(tx(k.label_es, k.label_en)) + '.</strong> ' + esc(src) + '</li>';
        });
        var ind = indicatorById(state.z);
        lines += '<li><strong>' + esc(tx('Altura municipal', 'Municipal height')) + ' · ' +
          esc(tx(ind.label_es, ind.label_en)) + '.</strong> ' +
          esc(tx(ind.source_es, ind.source_en)) + (ind.year ? ' · ' + esc(String(ind.year)) : '') + '</li>';
        if (gl) {
          lines += '<li><strong>' + esc(tx('Relieve', 'Terrain')) + '.</strong> ' +
            esc(tx(
              'Teselas locales del atlas y, si faltan, las teselas públicas de elevación.',
              'Local atlas tiles and, where those are missing, the public elevation tiles.'
            )) + '</li>';
        }
        host.innerHTML = lines
          ? '<ul>' + lines + '</ul>'
          : '<p>' + esc(tx('Ninguna capa está encendida.', 'No layer is on.')) + '</p>';
      }

      function renderCapas(onIds, cmp) {
        var host = document.getElementById('cdt-capas-body');
        if (!host) return;
        var ids = onIds || wantedLayers();
        var on = {};
        ids.forEach(function (id) { on[id] = 1; });
        cmp = cmp || compareOnly();
        var q = capasQ.toLowerCase();
        var countEl = document.getElementById('cdt-capas-count');
        if (countEl) countEl.textContent = tx(ids.length + ' capas activas', ids.length + ' layers on');
        var search = document.getElementById('cdt-capas-q');
        if (search && document.activeElement !== search) {
          search.placeholder = tx('Filtrar capas', 'Filter layers');
          search.value = capasQ;
        }
        var html = '';
        (model.layerGroups || []).forEach(function (g) {
          var theme = themeById(g.id);
          var items = '';
          (g.layers || []).forEach(function (id) {
            var meta = layerMeta(id);
            if (!meta) return;
            var label = tx(meta.name_es, meta.name_en);
            var blob = (label + ' ' + tx(meta.source_es, meta.source_en)).toLowerCase();
            if (q && blob.indexOf(q) === -1) return;
            items += '<label><input type="checkbox" data-layer="' + id + '"' + (on[id] ? ' checked' : '') + '> <span>' +
              label +
              (cmp[id] ? ' · ' + tx('comparar', 'compare') : '') +
              '<small>' + tx(meta.source_es, meta.source_en) + ' · ' + tx(meta.year_es, meta.year_en) + '</small></span></label>';
          });
          if (!items) return;
          html += '<section class="cdt-capas-group"><h3>' + tx(theme.es, theme.en) + '</h3>' + items + '</section>';
        });
        if (!html) html = '<p>' + tx('Ninguna capa coincide con el filtro.', 'No layer matches the filter.') + '</p>';
        host.innerHTML = html;
        host.querySelectorAll('[data-layer]').forEach(function (box) {
          box.addEventListener('change', function () {
            var id = box.getAttribute('data-layer');
            if (box.checked) { layerExtra[id] = 1; delete layerOff[id]; }
            else { layerOff[id] = 1; delete layerExtra[id]; }
            syncLayers();
          });
        });
      }

      function bootMunis() {
        return fetch('/gis/osm_municipalities.geojson').then(function (r) { return r.json(); }).then(function (geo) {
          muniLayer = L.geoJSON(geo, {
            style: styleMuni,
            onEachFeature: function (feat, layer) {
              var name = feat.properties && feat.properties.name;
              layer.on('click', function () { if (name) selectMuni(name, true); });
              if (name) layer.bindTooltip(name, { sticky: true });
            },
          }).addTo(map);
        });
      }

      document.querySelectorAll('[data-theme]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          state.theme = btn.getAttribute('data-theme');
          resetLayerPins();
          applyChrome();
          syncLayers();
        });
      });
      document.querySelectorAll('[data-scenario]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          state.scenario = btn.getAttribute('data-scenario');
          if (state.compare === state.scenario) state.compare = '';
          resetLayerPins();
          applyChrome();
          ensureGlB().then(function () { return syncLayers(); }).then(fitScenario);
        });
      });
      var cmpSel = document.getElementById('cdt-compare');
      if (cmpSel) cmpSel.addEventListener('change', function () {
        state.compare = cmpSel.value && cmpSel.value !== state.scenario ? cmpSel.value : '';
        state.ab = 'both';
        resetLayerPins();
        applyChrome();
        ensureGlB().then(function () { return syncLayers(); }).then(fitScenario);
      });
      document.querySelectorAll('[data-muni-btn]').forEach(function (btn) {
        btn.addEventListener('click', function () { selectMuni(btn.getAttribute('data-muni-btn'), true); });
      });

      var selX = document.getElementById('cdt-x');
      var selY = document.getElementById('cdt-y');
      function onAxis() {
        state.x = selX.value;
        state.y = selY.value;
        if (state.x === state.y) {
          state.y = model.indicators.map(function (i) { return i.id; }).filter(function (id) { return id !== state.x; })[0];
          selY.value = state.y;
        }
        refreshMuniStyle();
        renderScatter();
        writeUrl();
      }
      var capasSearch = document.getElementById('cdt-capas-q');
      if (capasSearch) capasSearch.addEventListener('input', function () {
        capasQ = capasSearch.value || '';
        renderCapas(wantedLayers(), compareOnly());
      });
      if (selX) selX.addEventListener('change', onAxis);
      if (selY) selY.addEventListener('change', onAxis);
      var shareBtn = document.getElementById('cdt-share');
      if (shareBtn) shareBtn.addEventListener('click', function () {
        writeUrl();
        var url = location.href;
        function done(ok) {
          setStatus(ok ? 'Vista copiada.' : url, ok ? 'View copied.' : url);
          if (!ok) return;
          var tip = document.getElementById('cdt-copy-tip');
          try { if (localStorage.getItem('bcs-gemelo-copy-tip') === '1') return; } catch (e) {}
          if (tip) tip.hidden = false;
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(function () { done(true); }).catch(function () { done(false); });
        } else done(false);
      });
      var copyOk = document.getElementById('cdt-copy-tip-ok');
      if (copyOk) copyOk.addEventListener('click', function () {
        try { localStorage.setItem('bcs-gemelo-copy-tip', '1'); } catch (e) {}
        var tip = document.getElementById('cdt-copy-tip');
        if (tip) tip.hidden = true;
      });
      var printBtn = document.getElementById('cdt-print');
      if (printBtn) printBtn.addEventListener('click', function () {
        renderSheet();
        window.print();
      });
      document.querySelectorAll('[data-preset]').forEach(function (a) {
        a.addEventListener('keydown', function (e) {
          if (e.key !== ' ' && e.key !== 'Spacebar') return;
          e.preventDefault();
          a.click();
        });
        a.addEventListener('click', function (e) {
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          e.preventDefault();
          var p = new URL(a.href, location.origin).searchParams;
          state.theme = 'urbano';
          state.scenario = 'baseline';
          state.compare = '';
          state.lever = '';
          state.path = '';
          state.z = 'pob';
          state.x = 'pob';
          state.y = 'sniiv_2025';
          state.muni = 'Los Cabos';
          state.ab = 'both';
          if (p.get('theme') && themeById(p.get('theme')).id === p.get('theme')) state.theme = p.get('theme');
          if (p.get('scenario') && scenarioById(p.get('scenario')).id === p.get('scenario')) state.scenario = p.get('scenario');
          if (p.get('compare') && scenarioById(p.get('compare')).id === p.get('compare') && p.get('compare') !== state.scenario) state.compare = p.get('compare');
          if (p.get('z') && indicatorById(p.get('z')).id === p.get('z')) state.z = p.get('z');
          if (p.get('path') && /^(diagnostico|meta|escenario|recomendacion)$/.test(p.get('path'))) state.path = p.get('path');
          if (p.get('lever')) state.lever = p.get('lever');
          if (p.get('muni') && muniByName(p.get('muni')).name === p.get('muni')) state.muni = p.get('muni');
          resetLayerPins();
          applyChrome();
          ensureGlB().then(function () { return syncLayers(); }).then(fitScenario);
          selectMuni(state.muni, true);
          focusPath(!!state.path);
          var after = a.getAttribute('data-after');
          if (after === 'fit') {
            window.setTimeout(function () {
              var fit = document.getElementById('cdt-fit');
              if (fit) fit.click();
            }, 350);
          }
          if (after === 'capas') {
            var capas = document.querySelector('.cdt-capas');
            if (capas) capas.open = true;
          }
          if (after === 'cambia') {
            var cambia = document.getElementById('cdt-cambia');
            if (cambia) {
              window.setTimeout(function () { cambia.scrollIntoView({ block: 'nearest', behavior: 'auto' }); }, 200);
            }
          }
          var hash = new URL(a.href, location.origin).hash || '#presets';
          history.replaceState(null, '', location.pathname + location.search + hash);
        });
      });
      var walkPrint = document.getElementById('cdt-walk-print');
      if (walkPrint) walkPrint.addEventListener('click', function () {
        var printBtn = document.getElementById('cdt-print');
        if (printBtn) printBtn.click();
      });
      document.querySelectorAll('[data-path]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var id = btn.getAttribute('data-path');
          state.path = state.path === id ? '' : id;
          focusPath(true);
          renderSheet();
          writeUrl();
        });
      });
      document.querySelectorAll('#cdt-ab [data-ab]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          state.ab = btn.getAttribute('data-ab') || 'both';
          renderSplitChrome();
          syncLayers();
        });
      });

      document.addEventListener('bcs:lang', function () {
        fillSelects();
        renderScatter();
        renderDetail();
        renderCambia();
        renderExtrudeLegend();
        renderLevers();
        renderConsulta();
        syncLayers();
      });

      fillSelects();
      applyChrome();
      if (state.path) window.setTimeout(function () { focusPath(true); }, 350);
      renderScatter();
      var ficheWrap = document.getElementById('cdt-fiche-wrap');
      if (ficheWrap && window.matchMedia('(min-width: 981px)').matches) ficheWrap.open = true;
      window.addEventListener('resize', function () {
        if (ficheWrap && window.matchMedia('(min-width: 981px)').matches) ficheWrap.open = true;
      });
      var splitTimer = 0;
      window.addEventListener('resize', function () {
        clearTimeout(splitTimer);
        splitTimer = setTimeout(function () {
          if (!gl) return;
          ensureGlB().then(function () { return syncLayers(); });
        }, 180);
      });
      selectMuni(state.muni);
      var reduceMotion = false;
      try { reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
      var want3d = window.CDT3D && CDT3D.hasWebGL() && typeof maplibregl !== 'undefined';
      var boot3d = want3d ? CDT3D.start({
        container: mapEl,
        reduced: reduceMotion,
        onMunicipality: function (name) { selectMuni(name, true); },
      }) : Promise.reject();
      function armTip(is3d) {
        var tip = document.getElementById('cdt-3d-tip');
        if (!tip) return;
        try { if (localStorage.getItem('bcs-gemelo-3d-tip') === '1') return; } catch (e) {}
        var reduce = false;
        try { reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
        var es, en;
        if (is3d && !reduce) {
          es = 'Para mirar el relieve: pulse Vista 3D para inclinar, Girar para rotar, y Estado para encuadrar el estado. Capas enciende el tema. El camino es diagnóstico, meta, escenario y recomendación. Toque un municipio para su ficha.';
          en = 'To look at the terrain: press 3D view to tilt, Rotate to turn, and State to frame the state. Layers turns the theme on. The path is diagnosis, goal, scenario and recommendation. Tap a municipality for its fiche.';
        } else {
          es = 'La vista queda quieta. Capas enciende el tema. El camino es diagnóstico, meta, escenario y recomendación. Toque un municipio para su ficha. Estado encuadra el estado.';
          en = 'The view stays still. Layers turns the theme on. The path is diagnosis, goal, scenario and recommendation. Tap a municipality for its fiche. State frames the state.';
        }
        tip.hidden = false;
        tip.innerHTML = '<p>' + tx(es, en) + '</p><button type="button" id="cdt-3d-tip-ok">' + tx('Entendido', 'Got it') + '</button>';
        var ok = document.getElementById('cdt-3d-tip-ok');
        if (ok) ok.addEventListener('click', function () {
          try { localStorage.setItem('bcs-gemelo-3d-tip', '1'); } catch (e) {}
          tip.hidden = true;
        });
      }
      boot3d.then(function (eng) {
        gl = eng;
        refreshMuniStyle();
        armTip(true);
        return ensureGlB();
      }).catch(function () {
        ensure2d();
        armTip(false);
        return bootMunis();
      }).then(function () {
        return syncLayers();
      }).then(fitScenario).catch(function () {
        setStatus('No se pudo cargar el mapa.', 'The map could not load.');
      });
    })();
  </script>
</BaseLayout>
