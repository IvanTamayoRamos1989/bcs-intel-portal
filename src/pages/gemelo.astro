---
import BaseLayout from '../layouts/BaseLayout.astro';
import HowTo from '../components/HowTo.astro';
import PathBanner from '../components/PathBanner.astro';
import { cdtModel } from '../lib/cdtModel';

const model = cdtModel;
const learnByTheme: Record<string, string> = {
  urbano: '/aprendizaje/#planeacion',
  economia: '/aprendizaje/#vivienda',
  investigacion: '/aprendizaje/#planeacion',
  movilidad: '/aprendizaje/#agua',
  vivienda: '/aprendizaje/#costa',
};
const loretoAirLabel = cdtModel.munis.find((m) => m.name === 'Loreto')?.aereo_2025?.toLocaleString('es-MX') ?? '';
function cellText(id: string, raw: number | null | undefined) {
  if (raw === null || raw === undefined || Number.isNaN(Number(raw))) return '—';
  if (id === 'pobreza_pct') return Number(raw).toLocaleString('es-MX', { maximumFractionDigits: 2 }) + '%';
  return Math.round(Number(raw)).toLocaleString('es-MX');
}
const icon: Record<string, string> = {
  urbano: '<path d="M4 20V9l5-3 5 3v11"/><path d="M9 20v-6h4v6"/><path d="M14 20V11l5-2v11"/>',
  economia: '<path d="M4 19h16"/><path d="M7 16v-4"/><path d="M12 16V7"/><path d="M17 16v-6"/>',
  investigacion: '<circle cx="7" cy="8" r="2"/><circle cx="17" cy="8" r="2"/><circle cx="12" cy="16" r="2"/><path d="M9 9l2 5M15 9l-2 5M9 8h6"/>',
  movilidad: '<path d="M4 16h16"/><path d="M6 16V8h7l3 4h2v4"/><circle cx="8" cy="16" r="1.4"/><circle cx="16" cy="16" r="1.4"/>',
  vivienda: '<path d="M4 11 12 4l8 7"/><path d="M7 10.5V20h10v-9.5"/>',
};
---
<BaseLayout
  title="Gemelo territorial"
  titleEn="Territorial twin"
  description="Tablero por tema: mapa, cifras del portal, comparación municipal y escenarios."
  descriptionEn="Theme board: map, portal figures, municipal comparison and scenarios."
  section="Gemelo territorial"
  sectionEn="Territorial twin"
  wide={true}
  hidePageHead={true}
>
  <link rel="preconnect" href="https://tile.openstreetmap.org" crossorigin />
  <link rel="stylesheet" href="/explorar/vendor/maplibre-gl.css" />
  <link
    rel="stylesheet"
    href="/vendor/leaflet/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin=""
  />

  <PathBanner current="gemelo" />
  <div class="cdt">
    <header class="cdt-top">
      <div>
        <p class="cdt-kicker">
          <span data-lang-es>Fase 2.2 · apoyo a la decisión</span>
          <span data-lang-en hidden>Phase 2.2 · decision support</span>
        </p>
        <h1>
          <span data-lang-es>Gemelo territorial</span>
          <span data-lang-en hidden>Territorial twin</span>
        </h1>
        <p class="cdt-lead">
          <span data-lang-es>{model.pedagogy_es}</span>
          <span data-lang-en hidden>{model.pedagogy_en}</span>
        </p>
        <p class="cdt-fine">
          <span data-lang-es>{model.disclaimer_es}</span>
          <span data-lang-en hidden>{model.disclaimer_en}</span>
          {' '}
          <a href="/inicio/"><span data-lang-es>Volver a la consulta</span><span data-lang-en hidden>Back to the consultation</span></a>
          {' · '}
          <a href="/aprendizaje/"><span data-lang-es>Aprender de otras ciudades</span><span data-lang-en hidden>Learn from other cities</span></a>
        </p>
        <nav class="cdt-path" id="cdt-path" aria-label="Camino de decisión" data-aria-es="Camino de decisión" data-aria-en="Decision path">
          <button type="button" data-path="diagnostico">
            <span data-lang-es>1 · Diagnóstico</span><span data-lang-en hidden>1 · Diagnosis</span>
          </button>
          <button type="button" data-path="meta">
            <span data-lang-es>2 · Meta</span><span data-lang-en hidden>2 · Goal</span>
          </button>
          <button type="button" data-path="escenario">
            <span data-lang-es>3 · Escenario</span><span data-lang-en hidden>3 · Scenario</span>
          </button>
          <button type="button" data-path="recomendacion">
            <span data-lang-es>4 · Recomendación</span><span data-lang-en hidden>4 · Recommendation</span>
          </button>
        </nav>
        <HowTo
          leadEs="Siga el camino: diagnóstico, meta, escenario y recomendación. Cada paso usa cifras y reglas que ya están en el portal."
          leadEn="Follow the path: diagnosis, goal, scenario and recommendation. Each step uses figures and rules already in the portal."
          steps={[
            { es: 'Diagnóstico: el tema, la altura municipal y las capas de ese tema.', en: 'Diagnosis: the theme, the municipal height and that theme’s layers.' },
            { es: 'Meta: las preguntas ya escritas para el municipio y el tema.', en: 'Goal: the questions already written for the municipality and the theme.' },
            { es: 'Escenario: el botón, la palanca, qué cambia y, si quiere, la comparación.', en: 'Scenario: the button, the lever, what changes and, if you want, the comparison.' },
            { es: 'Recomendación: la regla del portal para el municipio y el escenario. Imprima esa hoja para la reunión.', en: 'Recommendation: the portal rule for the municipality and the scenario. Print that sheet for the meeting.' },
          ]}
        />
        <aside class="cdt-tip">
          <p>
            <span data-lang-es>Cómo leer el tablero: elija un tema, luego un escenario, y compare los municipios.</span>
            <span data-lang-en hidden>How to read the board: pick a theme, then a scenario, and compare the municipalities.</span>
          </p>
          <p>
            <span data-lang-es>Si una celda está en blanco, se queda en blanco. No se rellena en la reunión.</span>
            <span data-lang-en hidden>If a cell is blank, it stays blank. It is not filled in during the meeting.</span>
          </p>
          <p>
            <a href="/vistas/"><span data-lang-es>Vistas guardadas</span><span data-lang-en hidden>Saved views</span></a>
            {' · '}
            <a href="/aprendizaje/#evidencia"><span data-lang-es>Evidencia de otras ciudades</span><span data-lang-en hidden>Evidence from other cities</span></a>
          </p>
        </aside>
        <section class="cdt-limits" id="limites">
          <h2>
            <span data-lang-es>Qué puede / qué no puede (Fase 2.2)</span>
            <span data-lang-en hidden>What it can / cannot do (Phase 2.2)</span>
          </h2>
          <p>
            <span data-lang-es>Puede ahora: recorrer diagnóstico, meta, escenario y recomendación; levantar cada municipio con una cifra que usted elige; y imprimir la hoja de ese escenario. Si una celda está en blanco, ese municipio no se levanta y la celda sigue en blanco.</span>
            <span data-lang-en hidden>It can now: walk diagnosis, goal, scenario and recommendation; raise each municipality with a figure you choose; and print the sheet for that scenario. If a cell is blank, that municipality does not rise and the cell stays blank.</span>
          </p>
          <p>
            <span data-lang-es>Todavía no puede: mapas por manzana (AGEB), forma de predios, lotes de catastro, métricas de forma, ni rellenar una cifra que falta. La altura es relativa a la cifra elegida. No es un edificio ni un metro de terreno.</span>
            <span data-lang-en hidden>It cannot yet: block maps (AGEB), parcel form, cadastre lots, form metrics, or filling in a missing figure. The height is relative to the chosen figure. It is not a building and not a meter of terrain.</span>
          </p>
          <p>
            <span data-lang-es>El cruce entre temas es una lectura cualitativa de las reglas del portal. No es un motor de simulación.</span>
            <span data-lang-en hidden>The cross-theme reading is qualitative, from the portal’s rules. It is not a simulation engine.</span>
          </p>
          <p>
            <a href="/metas/"><span data-lang-es>Preguntas abiertas</span><span data-lang-en hidden>Open questions</span></a>
            {' · '}
            <a href="/aprendizaje/#evidencia"><span data-lang-es>Evidencia de otras ciudades</span><span data-lang-en hidden>Evidence from other cities</span></a>
          </p>
        </section>
        <p class="cdt-fine"><a href="/vistas/"><span data-lang-es>Vistas guardadas para una reunión</span><span data-lang-en hidden>Saved views for a meeting</span></a> · <a href="/foro/"><span data-lang-es>Hoja para invitados</span><span data-lang-en hidden>Guest sheet</span></a></p>
        <div class="cdt-guides">
          {model.guides.map((g) => (
            <a class="cdt-guide" href={`/gemelo/?theme=${g.theme}&scenario=${g.scenario}&x=${g.x}&y=${g.y}`}>
              <span data-lang-es>{g.es}</span>
              <span data-lang-en hidden>{g.en}</span>
            </a>
          ))}
        </div>
      </div>
      <div class="cdt-scenarios" data-step="escenario" role="group" aria-label="Escenario" data-aria-es="Escenario" data-aria-en="Scenario">
        {model.scenarios.map((sc, i) => (
          <button type="button" class="cdt-sc" data-scenario={sc.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            <span data-lang-es>{sc.title_es}</span>
            <span data-lang-en hidden>{sc.title_en}</span>
          </button>
        ))}
        <div id="cdt-levers" class="cdt-levers" role="group" aria-label="Palancas del escenario" data-aria-es="Palancas del escenario" data-aria-en="Scenario levers"></div>
        <label class="cdt-compare-pick">
          <span data-lang-es>Comparar con</span>
          <span data-lang-en hidden>Compare with</span>
          <select id="cdt-compare">
            <option value="">
              —
            </option>
            {model.scenarios.map((sc) => (
              <option value={sc.id}>{sc.title_es}</option>
            ))}
          </select>
        </label>
        <button type="button" class="cdt-sc" id="cdt-share">
          <span data-lang-es>Copiar enlace</span>
          <span data-lang-en hidden>Copy link</span>
        </button>
        <button type="button" class="cdt-sc" id="cdt-print">
          <span data-lang-es>Imprimir</span>
          <span data-lang-en hidden>Print</span>
        </button>
      </div>
    </header>

    <div class="cdt-work">
      <nav class="cdt-rail" aria-label="Temas del gemelo" data-aria-es="Temas del gemelo" data-aria-en="Twin themes">
        {model.themes.map((t, i) => (
          <button type="button" class="cdt-theme-btn" data-theme={t.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" set:html={icon[t.id]} />
            <span>
              <span data-lang-es>{t.es}</span>
              <span data-lang-en hidden>{t.en}</span>
            </span>
          </button>
        ))}
      </nav>

      <div class="cdt-map-col" data-step="diagnostico">
        <div class="cdt-map-frame">
          <div id="cdt-map" role="application" aria-label="Mapa del gemelo territorial" data-aria-es="Mapa del gemelo territorial" data-aria-en="Territorial twin map"></div>
          <div class="cdt-map-tools" id="cdt-map-tools">
            <button type="button" id="cdt-pitch"><span data-lang-es>Vista cenital</span><span data-lang-en hidden>Top view</span></button>
            <button type="button" id="cdt-rot"><span data-lang-es>Girar</span><span data-lang-en hidden>Rotate</span></button>
            <button type="button" id="cdt-north"><span data-lang-es>Norte</span><span data-lang-en hidden>North</span></button>
            <button type="button" id="cdt-fit"><span data-lang-es>Estado</span><span data-lang-en hidden>State</span></button>
          </div>
        </div>
        <div id="cdt-extrude" class="cdt-extrude"></div>
        <p class="cdt-map-note" id="cdt-status">
          <span data-lang-es>Cargando capas del mapa…</span>
          <span data-lang-en hidden>Loading map layers…</span>
        </p>
        <p class="cdt-layers" id="cdt-layer-names"></p>
        <p class="cdt-open">
          <a class="cdt-open-map" id="cdt-map-link" href="/mapas?scenario=baseline#gis">
            <span data-lang-es>Abrir estas capas en Mapas</span>
            <span data-lang-en hidden>Open these layers in Maps</span>
          </a>
          <a href="/explorar/">
            <span data-lang-es>Abrir el atlas 3D completo</span>
            <span data-lang-en hidden>Open the full 3D atlas</span>
          </a>
        </p>
        <details class="cdt-capas" open>
          <summary id="cdt-capas-count"><span data-lang-es>Capas</span><span data-lang-en hidden>Layers</span></summary>
          <input id="cdt-capas-q" class="cdt-capas-q" type="search" autocomplete="off" />
          <div id="cdt-capas-body"></div>
        </details>
      </div>

      <aside class="cdt-panel" aria-label="Indicadores del tema" data-aria-es="Indicadores del tema" data-aria-en="Theme indicators">
        {model.themes.map((t, i) => (
          <section class="cdt-theme" data-step="diagnostico" data-theme-panel={t.id} hidden={i === 0 ? undefined : true}>
            <h2>
              <span data-lang-es>{t.es}</span>
              <span data-lang-en hidden>{t.en}</span>
            </h2>
            <p class="cdt-diag">
              <span data-lang-es>{t.diagnostic_es}</span>
              <span data-lang-en hidden>{t.diagnostic_en}</span>
            </p>
            <div class="cdt-kpis">
              {t.kpis.map((k) => (
                <a class="cdt-kpi" href={k.href}>
                  <strong>{k.value}</strong>
                  <span>
                    <span data-lang-es>{k.label_es}</span>
                    <span data-lang-en hidden>{k.label_en}</span>
                  </span>
                  <small>
                    <span data-lang-es>{k.source_es}</span>
                    <span data-lang-en hidden>{k.source_en}</span>
                  </small>
                </a>
              ))}
            </div>
            <p class="cdt-gap">
              <span data-lang-es>{t.gap_es}</span>
              <span data-lang-en hidden>{t.gap_en}</span>
            </p>
            {t.id === 'movilidad' && (
              <div class="cdt-loreto-air">
                <p class="cdt-loreto-n">{loretoAirLabel}</p>
                <p>
                  <span data-lang-es>viajeros en Loreto, 2025</span>
                  <span data-lang-en hidden>travelers at Loreto, 2025</span>
                </p>
                <a class="cdt-source-chip" href="https://www.bcs.gob.mx/supera-bcs-los-4-5-millones-de-pasajeros-aereos-en-2025-la-paz-crece-10-9/" rel="noopener noreferrer">
                  <span data-lang-es>Fuente: Gobierno de BCS</span>
                  <span data-lang-en hidden>Source: BCS government</span>
                </a>
                <a href="/gemelo/?theme=movilidad&x=pob&y=aereo_2025">
                  <span data-lang-es>Ver en el gráfico (sin Comondú ni Mulegé)</span>
                  <span data-lang-en hidden>See on the chart (without Comondú or Mulegé)</span>
                </a>
              </div>
            )}
          </section>
        ))}

        {model.scenarios.map((sc, i) => (
          <div class="cdt-sc-copy" data-step="escenario" data-scenario-copy={sc.id} hidden={i === 0 ? undefined : true}>
            <h3>
              <span data-lang-es>{sc.title_es}</span>
              <span data-lang-en hidden>{sc.title_en}</span>
            </h3>
            <p>
              <span data-lang-es>{sc.blurb_es}</span>
              <span data-lang-en hidden>{sc.blurb_en}</span>
            </p>
            <ul>
              {sc.questions_es.map((q, qi) => (
                <li>
                  <span data-lang-es>{q}</span>
                  <span data-lang-en hidden>{sc.questions_en[qi]}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}

        <section class="cdt-cambia" id="cdt-cambia" data-step="escenario" aria-label="Qué cambia" data-aria-es="Qué cambia" data-aria-en="What changes">
          <h3>
            <span data-lang-es>Qué cambia</span>
            <span data-lang-en hidden>What changes</span>
          </h3>
          <div id="cdt-cambia-body"></div>
        </section>

        <section class="cdt-cruce" id="cdt-cruce" data-step="escenario" aria-label="Impacto entre temas" data-aria-es="Impacto entre temas" data-aria-en="Cross-theme impact">
          <h3>
            <span data-lang-es>Impacto entre temas</span>
            <span data-lang-en hidden>Cross-theme impact</span>
          </h3>
          <div id="cdt-cruce-body"></div>
        </section>

        <section class="cdt-goals" id="paso-meta" data-step="meta" aria-label="Qué tiene que ser verdad" data-aria-es="Qué tiene que ser verdad" data-aria-en="What has to be true">
          <h3>
            <span data-lang-es>Qué tiene que ser verdad</span>
            <span data-lang-en hidden>What has to be true</span>
          </h3>
          <p class="cdt-fine">
            <span data-lang-es>Preguntas y metas ya escritas en el portal para el municipio y el tema activos. No son objetivos nuevos. Una pregunta puede contarse en más de un tema.</span>
            <span data-lang-en hidden>Questions and aims already written in the portal for the active municipality and theme. They are not new targets. One question can count in more than one theme.</span>
          </p>
          <p class="cdt-counts">
            {model.questionCounts.map((c) => {
              const theme = model.themes.find((t) => t.id === c.id);
              return (
                <span data-qcount={c.id}>
                  <span data-lang-es>{theme?.es}</span>
                  <span data-lang-en hidden>{theme?.en}</span>
                  {' · '}{c.n}
                </span>
              );
            })}
          </p>
          <p class="cdt-fine">
            <span data-lang-es>Señales de la prospectiva, con el tema que ya trae cada una:</span>
            <span data-lang-en hidden>Foresight archive, by the theme already on each signal:</span>
            {' '}
            {model.foresightThemes.map((s, i) => (
              <span>
                {i ? ' · ' : ''}
                {s.n} <span data-lang-es>{s.es}</span><span data-lang-en hidden>{s.en}</span>
              </span>
            ))}
            {' '}
            <a href="/foresights/"><span data-lang-es>Ver prospectiva</span><span data-lang-en hidden>See foresight</span></a>
            {' · '}
            <a href="/metas/"><span data-lang-es>Preguntas abiertas</span><span data-lang-en hidden>Open questions</span></a>
          </p>
          <ul id="cdt-goal-list">
            {model.goals.map((g) => (
              <li data-goal-places={g.places.join(' ')} data-goal-themes={g.themes.join(' ')} hidden>
                <a href={g.href}>
                  <span data-lang-es>{g.question_es}</span>
                  <span data-lang-en hidden>{g.question_en}</span>
                </a>
              </li>
            ))}
            {model.placeAims.map((p) => (
              <li data-aim={p.id} hidden>
                <a href={p.href}>
                  <span data-lang-es>{p.question_es}</span>
                  <span data-lang-en hidden>{p.question_en}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section class="cdt-couple" aria-label="Solución integrada" data-aria-es="Solución integrada" data-aria-en="Integrated solution">
          <h3>
            <span data-lang-es>Cómo se junta con los otros temas</span>
            <span data-lang-en hidden>How it joins the other themes</span>
          </h3>
          <p class="cdt-fine">
            <span data-lang-es>{model.integrated_es}</span>
            <span data-lang-en hidden>{model.integrated_en}</span>
          </p>
          {model.themes.map((t) => (
            <ul data-couple={t.id} hidden>
              {model.couplings[t.id].map((c) => (
                <li>
                  <a href={c.href}>
                    <span data-lang-es>{c.es}</span>
                    <span data-lang-en hidden>{c.en}</span>
                  </a>
                </li>
              ))}
              <li>
                <a href={learnByTheme[t.id]}>
                  <span data-lang-es>Casos de otras ciudades sobre este cruce. Fuente externa, sin cifras de BCS.</span>
                  <span data-lang-en hidden>Cases from other cities on this link. External source, no BCS figures.</span>
                </a>
              </li>
            </ul>
          ))}
        </section>

        <section class="cdt-deps" aria-label="Proyectos e instituciones" data-aria-es="Proyectos e instituciones" data-aria-en="Projects and institutions">
          <h3>
            <span data-lang-es>Proyectos, institución y horizonte</span>
            <span data-lang-en hidden>Projects, institution and horizon</span>
          </h3>
          <p class="cdt-fine">
            <span data-lang-es>Inventario federal ya publicado. El horizonte es el sexenio reportado, no una fecha de entrega calculada. México reparte la obra entre federación, estado y municipio.</span>
            <span data-lang-en hidden>Federal inventory already published. The horizon is the reported administration, not a calculated delivery date. Mexico splits works across federation, state and municipality.</span>
          </p>
          <ul id="cdt-dep-list">
            {model.fedProjects.map((p) => (
              <li data-where={p.where} hidden>
                <a href={p.href}>{p.name}</a>
                <span class="cdt-fine"> · {p.owner} · {p.status} · {p.horizon}</span>
              </li>
            ))}
          </ul>
          <p>
            <a href="/coordinacion/"><span data-lang-es>Ver instituciones y horizontes</span><span data-lang-en hidden>See institutions and horizons</span></a>
            {' · '}
            <a href="/proyectos-federales/"><span data-lang-es>Inventario</span><span data-lang-en hidden>Inventory</span></a>
            {' · '}
            <a href="/stakeholders/"><span data-lang-es>Actores</span><span data-lang-en hidden>Stakeholders</span></a>
          </p>
        </section>

        <section class="cdt-compare" aria-label="Comparar municipios" data-aria-es="Comparar municipios" data-aria-en="Compare municipalities">
          <h3>
            <span data-lang-es>Comparar municipios</span>
            <span data-lang-en hidden>Compare municipalities</span>
          </h3>
          <p class="cdt-fine">
            <span data-lang-es>{model.notMunicipal_es}</span>
            <span data-lang-en hidden>{model.notMunicipal_en}</span>
          </p>
          <div class="cdt-axes">
            <label>
              <span data-lang-es>Eje horizontal (color del mapa)</span>
              <span data-lang-en hidden>Horizontal axis (map color)</span>
              <select id="cdt-x"></select>
            </label>
            <label>
              <span data-lang-es>Eje vertical</span>
              <span data-lang-en hidden>Vertical axis</span>
              <select id="cdt-y"></select>
            </label>
          </div>
          <div id="cdt-quality-strip" class="cdt-quality"></div>
          <div id="cdt-scatter" class="cdt-scatter"></div>
          <p class="cdt-fine" id="cdt-sources"></p>
          <p class="cdt-fine" id="cdt-quality"></p>
          <p class="cdt-fine">
            <span data-lang-es>{model.compareSkip_es}</span>
            <span data-lang-en hidden>{model.compareSkip_en}</span>
          </p>
          <p class="cdt-fine">
            <span data-lang-es>{model.regional_es}</span>
            <span data-lang-en hidden>{model.regional_en}</span>
            {' '}
            <a href="https://plataformaurbana.cepal.org/es" rel="noopener noreferrer">CEPAL</a>
          </p>
          <div class="cdt-table-wrap">
            <table class="cdt-table">
              <thead>
                <tr>
                  <th><span data-lang-es>Municipio</span><span data-lang-en hidden>Municipality</span></th>
                  {model.indicators.map((ind) => (
                    <th>
