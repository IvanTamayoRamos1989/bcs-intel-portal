  <script>
    function showLimits() {
      if ((location.hash || '') !== '#limites') return;
      var el = document.getElementById('limites');
      if (!el) return;
      var header = document.querySelector('.pt-top');
      var hb = header ? header.getBoundingClientRect().bottom : 62;
      var top = el.getBoundingClientRect().top;
      if (top < hb - 2 || top > hb + 48) {
        var root = document.documentElement;
        var prev = root.style.scrollBehavior;
        root.style.scrollBehavior = 'auto';
        el.scrollIntoView({ block: 'start', behavior: 'auto' });
        root.style.scrollBehavior = prev;
      }
    }
    if (document.readyState === 'complete') {
      showLimits();
      window.setTimeout(showLimits, 400);
    } else {
      window.addEventListener('load', function () {
        showLimits();
        window.setTimeout(showLimits, 400);
      });
    }
  </script>

