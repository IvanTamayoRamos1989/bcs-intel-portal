  <script is:inline src="https://unpkg.com/cytoscape@3.30.4/dist/cytoscape.min.js"></script>
  <script is:inline>
    (function () {
      var data = window.__ONTO_GRAPH__;
      if (!data || typeof cytoscape === 'undefined') return;

      var cyEl = document.getElementById('onto-cy');
      var detailEl = document.getElementById('onto-detail');
      var legendEl = document.getElementById('onto-legend');
      var filtersEl = document.getElementById('onto-type-filters');
      var filterGrid = document.getElementById('onto-filter-grid');
      var searchEl = document.getElementById('onto-search');
      var hideIsolatesEl = document.getElementById('onto-hide-isolates');
      var scope = 'core';
      var cy = null;
      /* Screen-space labels: inverse to zoom so zoom-in shrinks text */
      var LABEL_ZOOM = 0.72;       /* bulk labels appear above this */
      var DETAIL_ZOOM = 1.35;      /* denser detail / focus emphasis */
      var BASE_SCREEN_FONT = 11;   /* target px on screen at z≈1 */
      var MIN_SCREEN_FONT = 7;
      var MAX_SCREEN_FONT = 12;
      var FIT_PAD = 48;
      var typeOrder = Object.keys(data.typeColors || {});
      var enabledTypes = {};
      typeOrder.forEach(function (t) { enabledTypes[t] = true; });
      var focusNodeId = null;

      function lang() {
        return document.documentElement.getAttribute('data-lang') === 'en' ? 'en' : 'es';
      }

      function nodeLabel(n) {
        return lang() === 'en' ? (n.label_en || n.label) : n.label;
      }

      function typeLabel(t) {
        return lang() === 'en'
          ? (data.typeLabelsEn[t] || t)
          : (data.typeLabelsEs[t] || t);
      }

      function buildFilterUI() {
        if (!filterGrid) return;
        var html = '';
        typeOrder.forEach(function (t) {
          html += '<label><input type="checkbox" data-type="' + t + '" checked />' +
            '<i style="background:' + (data.typeColors[t] || '#8796a0') + '"></i>' +
            '<span data-type-label="' + t + '">' + typeLabel(t) + '</span></label>';
        });
        filterGrid.innerHTML = html;
        filterGrid.querySelectorAll('input[type=checkbox]').forEach(function (cb) {
          cb.addEventListener('change', function () {
            enabledTypes[cb.getAttribute('data-type')] = cb.checked;
            if (scope === 'full') initCy();

      });
        });
      }

      function syncFilterLabels() {
        if (!filterGrid) return;
        filterGrid.querySelectorAll('[data-type-label]').forEach(function (el) {
          el.textContent = typeLabel(el.getAttribute('data-type-label'));
        });
      }

      function buildElements(useCore) {
        var idSet = null;
        if (useCore) {
          idSet = {};
          (data.coreIds || []).forEach(function (id) { idSet[id] = true; });
        }
        var nodes = data.nodes.filter(function (n) {
          if (idSet && !idSet[n.id]) return false;
          if (!useCore && !enabledTypes[n.type]) return false;
          return true;
        });
        var nodeIds = {};
        nodes.forEach(function (n) { nodeIds[n.id] = true; });
        var edges = data.edges.filter(function (e) {
          return nodeIds[e.from] && nodeIds[e.to];
        });
        if (hideIsolatesEl && hideIsolatesEl.checked) {
          var connected = {};
          edges.forEach(function (e) {
            connected[e.from] = true;
            connected[e.to] = true;
          });
          nodes = nodes.filter(function (n) { return connected[n.id]; });
          nodeIds = {};
          nodes.forEach(function (n) { nodeIds[n.id] = true; });
          edges = edges.filter(function (e) {
            return nodeIds[e.from] && nodeIds[e.to];
          });
        }
        var typeIndex = {};
        typeOrder.forEach(function (t, i) { typeIndex[t] = i + 1; });
        return nodes.map(function (n) {
          return {
            group: 'nodes',
            data: {
              id: n.id,
              label: nodeLabel(n),
              type: n.type,
              summary: n.summary,
              summary_en: n.summary_en,
              label_es: n.label,
              label_en: n.label_en,
              color: data.typeColors[n.type] || '#34607d',
              concentric: typeIndex[n.type] || 99,
            },
          };
        }).concat(edges.map(function (e, i) {
          return {
            group: 'edges',
            data: {
              id: 'e' + i + '_' + e.from + '_' + e.to,
              source: e.from,
              target: e.to,
              predicate: e.predicate,
              predicate_es: e.predicate_es,
              predicate_en: e.predicate_en,
            },
          };
        }));
      }


      /* PASS5_TYPE_SEG */
      function setupTypeSeg() {
        var row = document.getElementById('onto-type-seg');
        if (!row || !data) return;
        // keep All chip, rebuild rest
        row.querySelectorAll('.onto-type-chip:not([data-type="all"])').forEach(function (x) { x.remove(); });
        typeOrder.forEach(function (tp) {
          var b = document.createElement('button');
          b.type = 'button';
          b.className = 'onto-type-chip';
          b.setAttribute('data-type', tp);
          var col = (data.typeColors && data.typeColors[tp]) || '#8796a0';
          b.innerHTML = '<i style="background:' + col + '"></i><span>' + typeLabel(tp) + '</span>';
          row.appendChild(b);
        });
        if (!row._bound) {
          row._bound = true;
          row.addEventListener('click', function (ev) {
            var btn = ev.target.closest('.onto-type-chip');
            if (!btn) return;
            row.querySelectorAll('.onto-type-chip').forEach(function (x) { x.classList.remove('active'); });
            btn.classList.add('active');
            var tp = btn.getAttribute('data-type');
            if (!cy) return;
            if (tp === 'all') {
              cy.nodes().style('display', 'element');
              cy.edges().style('display', 'element');
            } else {
              cy.nodes().forEach(function (n) {
                n.style('display', n.data('type') === tp ? 'element' : 'none');
              });
              cy.edges().forEach(function (e) {
                var ok = e.source().style('display') !== 'none' && e.target().style('display') !== 'none';
                e.style('display', ok ? 'element' : 'none');
              });
            }
            try { cy.fit(cy.nodes(':visible'), 48); } catch (e) {}
          });
        }
      }

      function renderLegend() {
        if (!legendEl) return;
        var html = '';
        typeOrder.forEach(function (t) {
          html += '<span><i style="background:' + data.typeColors[t] + '"></i>' +
            typeLabel(t) + '</span>';
        });
        legendEl.innerHTML = html;
      }


      var PRED_PLAIN_ES = {
        governs: 'Regulado por', gobierna: 'Regulado por',
        constrains: 'Limita a', restringe: 'Limita a',
        enables: 'Habilita', habilita: 'Habilita',
        demands: 'Demanda de', demanda: 'Demanda de',
        supplies: 'Abastece a', abastece: 'Abastece a',
        located_in: 'Se ubica en', ubicado_en: 'Se ubica en',
        engages_in: 'Participa en', participa: 'Participa en',
        evidenced_by: 'Respaldado por', evidenciado_por: 'Respaldado por',
        conflicts_with: 'En tensión con', conflige_con: 'En tensión con',
        depends_on: 'Depende de', depende_de: 'Depende de',
        informs_decision: 'Informa la decisión', informa_decision: 'Informa la decisión',
        observed_in: 'Observado en', observado_en: 'Observado en',
        cross_ref_osm: 'Relacionado con', isA: 'Es un'
      };
      var PRED_PLAIN_EN = {
        governs: 'Regulates', constrains: 'Limits', enables: 'Enables',
        demands: 'Demands from', supplies: 'Supplies', located_in: 'Located in',
        engages_in: 'Engages in', evidenced_by: 'Evidenced by', conflicts_with: 'Conflicts with',
        depends_on: 'Depends on', informs_decision: 'Informs the decision',
        observed_in: 'Observed in', cross_ref_osm: 'Related to', isA: 'Is a'
      };
      function plainPred(label, id) {
        var key = (id || label || '').toString();
        var map = lang() === 'en' ? PRED_PLAIN_EN : PRED_PLAIN_ES;
        if (map[key]) return map[key];
        // also try normalized label
        var low = key.toLowerCase().replace(/\s+/g, '_');
        if (map[low]) return map[low];
        // strip code-like underscores for display
        return (label || key).toString().replace(/_/g, ' ');
      }

      function showDetail(node) {
        if (!detailEl || !node) return;
        var d = node.data();
        var title = lang() === 'en' ? (d.label_en || d.label) : (d.label_es || d.label);
        var summary = lang() === 'en' ? (d.summary_en || d.summary) : d.summary;
        var neighbors = node.neighborhood('node');
        var neighHtml = '';
        neighbors.forEach(function (nb) {
          var nd = nb.data();
          var edge = node.edgesWith(nb)[0];
          var pred = '';
          if (edge) {
            pred = lang() === 'en'
              ? (edge.data('predicate_en') || edge.data('predicate'))
              : (edge.data('predicate_es') || edge.data('predicate'));
          }
          var nl = lang() === 'en' ? (nd.label_en || nd.label) : (nd.label_es || nd.label);
          neighHtml += '<li><span class="onto-pred">' + plainPred(pred, edge ? edge.data('predicate') : '') + '</span> → <strong>' + nl + '</strong></li>';
        });
        var neighTitle = lang() === 'en' ? 'Neighbours' : 'Vecinos';
        /* PASS3_ONTO_SHEET */
        var actions = '';
        var studioMap = {
          terr_los_cabos: '/studio/los_cabos/',
          terr_la_paz: '/studio/la_paz/',
          terr_loreto: '/studio/loreto/',
          terr_comondu: '/studio/comondu/',
          terr_mulege: '/studio/mulege/',
          terr_bcs: '/studio/bcs/'
        };
        if (studioMap[d.id]) {
          actions += '<a class="btn" href="' + studioMap[d.id] + '">' + (lang()==='en'?'Dossier':'Ficha') + '</a>';
        }
        if (String(d.id).indexOf('proj_fed_') === 0 || d.type === 'Project') {
          actions += '<a class="btn secondary" href="/mapas/?layers=federal_projects">' + (lang()==='en'?'Map':'Mapa') + '</a>';
        }
        if (d.id === 'rc_sibcs' || d.id === 'proj_p23_bs1' || d.id === 'rc_plant_sol_insurgentes') {
          actions += '<a class="btn secondary" href="/mapas/?layers=energy_assets">' + (lang()==='en'?'Energy map':'Mapa energía') + '</a>';
        }
        if (String(d.id).indexOf('proj_fed_') === 0) {
          var fedId = d.id.replace('proj_','').replace(/_/g,'-').toUpperCase().replace('FED-','FED-');
          // proj_fed_ene_001 -> FED-ENE-001
          var m = /^proj_fed_([a-z]+)_([0-9]+)$/.exec(d.id);
          if (m) fedId = 'FED-' + m[1].toUpperCase() + '-' + m[2];
          actions += '<a class="btn secondary" href="/proyectos-federales/?q=' + encodeURIComponent(fedId) + '">' + (lang()==='en'?'Inventory':'Inventario') + '</a>';
        }
        if (d.evidence_path && String(d.evidence_path).indexOf('http') === 0) {
          actions += '<a class="btn secondary" href="' + d.evidence_path + '" target="_blank" rel="noopener">' + (lang()==='en'?'Source':'Fuente') + '</a>';
        }
        detailEl.innerHTML =
          '<span class="onto-type">' + typeLabel(d.type) + '</span>' +
          '<h4>' + title + '</h4>' +
          '<p style="margin:0 0 0.5rem">' + (summary || '') + '</p>' +
          '' + /* hide technical node id */
          (actions ? '<p class="onto-detail-actions" style="display:flex;flex-wrap:wrap;gap:0.4rem;margin:0.65rem 0 0">' + actions + '</p>' : '') +
          (neighHtml
            ? '<p style="margin:0.75rem 0 0.2rem;font-weight:600">' + neighTitle + '</p><ul>' + neighHtml + '</ul>'
            : '');
      }

      function clearHighlight() {
        if (!cy) return;
        focusNodeId = null;
        cy.elements().removeClass('faded highlighted focus-center');
      }

      function highlight(node) {
        if (!cy) return;
        clearHighlight();
        focusNodeId = node.id();
        var neighborhood = node.closedNeighborhood();
        cy.elements().addClass('faded');
        neighborhood.removeClass('faded').addClass('highlighted');
        node.addClass('focus-center');
        applyZoomStyles();
      }

      function clamp(v, lo, hi) {
        return Math.max(lo, Math.min(hi, v));
      }

      /** Inverse-zoom font-size (screen-space) + label density / focus contrast */
      function applyZoomStyles() {
        if (!cy) return;
        var z = Math.max(cy.zoom(), 0.05);
        /* Hide bulk labels when zoomed out; always show focus/selection */
        var showAllLabels = z >= LABEL_ZOOM;
        /* At high zoom with a locked focus, only selected + neighbours keep labels */
        var denseFocus = !!focusNodeId && z >= DETAIL_ZOOM;

        /* Screen-space font shrinks slightly as zoom rises (fits dense clusters) */
        var screenFont = clamp(
          BASE_SCREEN_FONT / Math.pow(Math.max(z, 0.45), 0.55),
          MIN_SCREEN_FONT,
          MAX_SCREEN_FONT
        );
        /* Model units → Cytoscape scales by zoom, so /z keeps screen size ≈ screenFont */
        var fontSize = screenFont / z;
        var focusScreen = clamp(screenFont + 1.5, MIN_SCREEN_FONT + 1, MAX_SCREEN_FONT + 1);
