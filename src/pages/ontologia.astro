        var edgeW = (z < 0.7 ? 0.9 : (z < DETAIL_ZOOM ? 1.15 : 1.35)) / Math.sqrt(z);
        var edgeOp = z < 0.7 ? 0.22 : (z < DETAIL_ZOOM ? 0.38 : 0.5);
        /* ~78–110 px on screen, wrapping long names to ~2 lines */
        var textMax = clamp(88 / z, 28, 220);
        var bgOp = showAllLabels ? 0.88 : 0.75;
        var typeMargin = {
          Territory: 3, Instrument: 5, ResourceCapacity: 4, DemandDriver: 6,
          Constraint: 7, Actor: 5, Project: 8, Evidence: 4, DecisionQuestion: 9
        };

        cy.batch(function () {
          cy.nodes().forEach(function (n) {
            var isFocus = n.hasClass('highlighted') || n.hasClass('focus-center') || n.grabbed();
            var faded = n.hasClass('faded');
            var show = isFocus || (showAllLabels && !denseFocus && !faded);
            if (denseFocus && faded) show = false;
            var fs = isFocus ? focusFont : fontSize;
            var sz = n.data('type') === 'DecisionQuestion'
              ? (isFocus ? dqSize * 1.12 : dqSize)
              : (isFocus ? nodeSize * 1.2 : nodeSize);
            var raw = show ? (n.data('label') || '') : '';
            /* Truncate long labels at mid/low zoom; full wrap when zoomed in or focused */
            var lab = raw;
            if (raw && !isFocus && z < DETAIL_ZOOM && raw.length > 26) {
              lab = raw.slice(0, 24).replace(/\s+\S*$/, '') + '…';
              if (lab.length < 8) lab = raw.slice(0, 23) + '…';
            }
            n.style({
              'label': lab,
              'font-size': fs,
              'font-weight': isFocus ? 600 : 500,
              'color': '#23374a',
              'text-outline-color': '#fbf8f1',
              'text-outline-width': show ? (isFocus ? 2.5 : 1.75) / Math.max(z, 0.6) : 0,
              'text-outline-opacity': show ? 0.95 : 0,
              'text-background-color': '#fbf8f1',
              'text-background-opacity': show ? (isFocus ? 0.94 : bgOp) : 0,
              'text-background-padding': show ? 2 / Math.max(z, 0.7) : 0,
              'text-max-width': textMax,
              'text-wrap': 'wrap',
              'text-margin-y': (typeMargin[n.data('type')] || 5) / Math.max(z, 0.7),
              'width': sz,
              'height': sz,
              'opacity': faded ? 0.12 : 1,
            });
          });

          cy.edges().forEach(function (e) {
            var hi = e.hasClass('highlighted');
            var faded = e.hasClass('faded');
            if (hi) {
              e.style({
                'width': Math.max(edgeW * 1.7, 1.6 / z),
                'opacity': 0.95,
                'line-color': '#34607d',
                'target-arrow-color': '#34607d',
                'curve-style': 'bezier',
                'target-arrow-shape': 'triangle',
              });
            } else if (faded) {
              e.style({
                'width': edgeW * 0.7,
                'opacity': 0.08,
                'line-color': '#c5d6e1',
                'target-arrow-color': '#c5d6e1',
                'curve-style': 'haystack',
              });
            } else {
              e.style({
                'width': edgeW,
                'opacity': edgeOp,
                'line-color': '#c5d6e1',
                'target-arrow-color': '#c5d6e1',
                'curve-style': 'haystack',
              });
            }
          });
        });
      }

      function updateLabels() {
        applyZoomStyles();
      }

      function layoutOpts() {
        if (scope === 'full') {
          return {
            name: 'concentric',
            animate: false,
            padding: FIT_PAD,
            minNodeSpacing: 36,
            concentric: function (n) { return n.data('concentric') || 1; },
            levelWidth: function () { return 1; },
            avoidOverlap: true,
            spacingFactor: 1.22,
          };
        }
        return {
          name: 'cose',
          animate: false,
          padding: FIT_PAD,
          nodeRepulsion: function () { return 22000; },
          idealEdgeLength: function () { return 125; },
          nestingFactor: 1.2,
          gravity: 0.28,
          numIter: 1000,
          initialTemp: 220,
          coolingFactor: 0.95,
          minTemp: 1.0,
          componentSpacing: 48,
          nodeOverlap: 36,
        };
      }

      function zoomToSelection() {
        if (!cy) return;
        var sel = cy.$('node.highlighted, node.focus-center');
        if (!sel.length) {
          var hovered = cy.$('node:active');
          if (hovered.length) sel = hovered;
        }
        if (!sel.length) {
          cy.animate({ fit: { eles: cy.elements(), padding: FIT_PAD }, duration: 260 });
          return;
        }
        var eles = sel.closedNeighborhood();
        cy.animate({
          fit: { eles: eles, padding: FIT_PAD + 12 },
          duration: 280,
        });
      }

      function initCy() {
        var elements = buildElements(scope === 'core');
        if (cy) {
          cy.destroy();
          cy = null;
        }
        focusNodeId = null;
        cy = cytoscape({
          container: cyEl,
          elements: elements,
          style: [
            {
              selector: 'node',
              style: {
                'background-color': 'data(color)',
                'label': 'data(label)',
                'color': '#23374a',
                'font-size': 10,
                'font-weight': 500,
                'font-family': 'Inter, system-ui, sans-serif',
                'text-wrap': 'wrap',
                'text-max-width': 88,
                'text-valign': 'bottom',
                'text-halign': 'center',
                'text-margin-y': 5,
                'text-outline-color': '#fbf8f1',
                'text-outline-width': 2,
                'text-outline-opacity': 0.9,
                'text-background-color': '#fbf8f1',
                'text-background-opacity': 0.82,
                'text-background-padding': 2,
                'text-background-shape': 'roundrectangle',
                'width': 12,
                'height': 12,
                'border-width': 2,
                'border-color': '#fbf8f1',
                'overlay-padding': 4,
                'min-zoomed-font-size': 0,
              },
            },
            {
              selector: 'node[type = "DecisionQuestion"]',
              style: {
                'shape': 'diamond',
                'width': 18,
                'height': 18,
                'background-color': '#34607d',
              },
            },
            {
              selector: 'edge',
              style: {
                'width': 1,
                'line-color': '#c5d6e1',
                'target-arrow-color': '#c5d6e1',
                'target-arrow-shape': 'triangle',
                'curve-style': 'haystack',
                'haystack-radius': 0.55,
                'arrow-scale': 0.65,
                'opacity': 0.35,
              },
            },
            {
              selector: '.faded',
              style: { opacity: 0.12 },
            },
            {
              selector: 'node.highlighted',
              style: {
                opacity: 1,
                'border-width': 3,
                'border-color': '#34607d',
                'z-index': 999,
              },
            },
            {
              selector: 'node.focus-center',
              style: {
                opacity: 1,
                'border-width': 4,
                'border-color': '#2a5069',
                'z-index': 1000,
              },
            },
            {
              selector: 'edge.highlighted',
              style: {
                'curve-style': 'bezier',
                'line-color': '#34607d',
                'target-arrow-color': '#34607d',
                'target-arrow-shape': 'triangle',
                width: 2.4,
                opacity: 0.95,
                'z-index': 998,
              },
            },
          ],
          layout: layoutOpts(),
          minZoom: 0.15,
          maxZoom: 4.5,
          wheelSensitivity: 0.18,
          userZoomingEnabled: true,
          userPanningEnabled: true,
          boxSelectionEnabled: false,
          autoungrabify: false,
        });

        cy.on('tap', 'node', function (evt) {
          var node = evt.target;
          highlight(node);
          showDetail(node);
          cy.animate({
            fit: { eles: node.closedNeighborhood(), padding: FIT_PAD + 8 },
            duration: 280,
          });
        });
        cy.on('tap', function (evt) {
          if (evt.target === cy) {
            clearHighlight();
            applyZoomStyles();
            detailEl.innerHTML =
              lang() === 'en'
                ? '<p class="meta">Select a node to see its card and neighbours.</p>'
                : '<p class="meta">Selecciona un nodo para ver su ficha y vecinos.</p>';
          }
        });
        cy.on('mouseover', 'node', function (evt) {
          var n = evt.target;
          /* Soft 1-hop preview when nothing is locked by click */
          if (!focusNodeId) {
            cy.elements().removeClass('faded highlighted focus-center');
            cy.elements().addClass('faded');
            n.closedNeighborhood().removeClass('faded').addClass('highlighted');
            n.addClass('focus-center');
            applyZoomStyles();
          } else {
            var hz = Math.max(cy.zoom(), 0.05);
            n.style({
              'label': n.data('label'),
              'font-size': clamp(12 / Math.pow(Math.max(hz, 0.45), 0.55), 8, 13) / hz,
              'font-weight': 600,
              'text-outline-width': 2.5 / Math.max(hz, 0.6),
              'text-background-opacity': 0.94,
            });
          }
        });
        cy.on('mouseout', 'node', function () {
          if (!focusNodeId) {
            cy.elements().removeClass('faded highlighted focus-center');
            applyZoomStyles();
          } else {
            var sel = cy.getElementById(focusNodeId);
            if (sel.length) {
              cy.elements().removeClass('faded highlighted focus-center');
              cy.elements().addClass('faded');
              sel.closedNeighborhood().removeClass('faded').addClass('highlighted');
              sel.addClass('focus-center');
            }
            applyZoomStyles();
          }
        });
        cy.on('zoom pan', function () { applyZoomStyles(); });
        window.__ontoCy = cy;
        setupTypeSeg();
        function fitAfterLayout() {
          try {
            cy.resize();
            cy.fit(cy.nodes(), 56);
            applyZoomStyles();
          } catch (eFit) {}
        }
        cy.one('layoutstop', function () { fitAfterLayout(); });
        /* fallback if layout already finished or is continuous */
        setTimeout(fitAfterLayout, 120);
        setTimeout(fitAfterLayout, 600);
        setTimeout(fitAfterLayout, 1400);
        setTimeout(fitAfterLayout, 2400);
        window.addEventListener('resize', function () {
          try { cy.resize(); } catch (e) {}
          fitAfterLayout();
        });
        /* PASS3_ONTO_NODE_BOOT */
        setTimeout(function () {
          try {
            var nodeQ = new URLSearchParams(location.search).get('node') || 'rc_sibcs';
            var n0 = cy.getElementById(nodeQ);
            if (!(n0 && n0.length)) n0 = cy.getElementById('proj_fed_ene_001');
            if (!(n0 && n0.length) && cy.nodes().length) n0 = cy.nodes().first();
            if (n0 && n0.length) {
              highlight(n0);
              showDetail(n0);
              try { cy.fit(n0.closedNeighborhood(), 48); } catch (e2) {}
            }
          } catch (e) { console.warn('onto boot', e); }
        }, 400);
      }

      function relabelNodes() {
        if (!cy) return;
        cy.nodes().forEach(function (n) {
          var d = n.data();
          n.data('label', lang() === 'en' ? (d.label_en || d.label_es) : d.label_es);
        });
        applyZoomStyles();
        renderLegend();
        setupTypeSeg();

        syncFilterLabels();
        var sel = cy.$('node.focus-center, node.highlighted');
        if (sel.length) showDetail(sel[0]);
        if (searchEl) {
          searchEl.placeholder = lang() === 'en' ? 'Search…' : 'Buscar…';
        }
      }

      function setScope(next) {
        scope = next;
        document.querySelectorAll('.onto-scope').forEach(function (btn) {
          btn.classList.toggle('active', btn.getAttribute('data-scope') === next);
        });
        if (filtersEl) filtersEl.hidden = next !== 'full';
        initCy();
        renderLegend();
      }

      function focusSearch(q) {
        if (!cy || !q) return;
        var ql = q.trim().toLowerCase();
        if (!ql) return;
        var hit = cy.nodes().filter(function (n) {
          var d = n.data();
          var hay = ((d.label_es || '') + ' ' + (d.label_en || '') + ' ' + d.id + ' ' + (d.type || '')).toLowerCase();
          return hay.indexOf(ql) !== -1;
        });
        if (!hit.length) return;
        var node = hit[0];
        highlight(node);
        showDetail(node);
        cy.animate({
          fit: { eles: node.closedNeighborhood(), padding: FIT_PAD + 8 },
          duration: 280,
        });
      }

      document.getElementById('onto-scope-core')?.addEventListener('click', function () {
        setScope('core');
      });
      document.getElementById('onto-scope-full')?.addEventListener('click', function () {
        setScope('full');
      });
      document.getElementById('onto-zoom-sel')?.addEventListener('click', function () {
        zoomToSelection();
      });
      document.getElementById('onto-reset')?.addEventListener('click', function () {
        if (!cy) return;
        clearHighlight();
        applyZoomStyles();
        cy.fit(undefined, FIT_PAD);
        cy.center();
        if (searchEl) searchEl.value = '';
        detailEl.innerHTML =
          lang() === 'en'
            ? '<p class="meta">Select a node to see its card and neighbours.</p>'
            : '<p class="meta">Selecciona un nodo para ver su ficha y vecinos.</p>';
      });
      (function setupExpand() {
        var shell = document.getElementById('onto-graph-shell');
        var btn = document.getElementById('onto-expand');
        if (!shell || !btn) return;
        function setLabel(fs) {
          var es = btn.querySelector('[data-lang-es]');
          var en = btn.querySelector('[data-lang-en]');
          if (es) es.textContent = fs ? 'Cerrar' : 'Ampliar';
          if (en) en.textContent = fs ? 'Close' : 'Expand';
          btn.setAttribute('aria-pressed', fs ? 'true' : 'false');
        }
        function refreshCy() {
          if (!cy) return;
          requestAnimationFrame(function () {
            cy.resize();
            applyZoomStyles();
          });
        }
        btn.addEventListener('click', function () {
          var fs = !shell.classList.contains('onto-fullscreen');
          shell.classList.toggle('onto-fullscreen', fs);
          shell.classList.toggle('onto-expanded', fs);
          document.body.classList.toggle('onto-fs-active', fs);
          setLabel(fs);
          refreshCy();
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && shell.classList.contains('onto-fullscreen')) {
            shell.classList.remove('onto-fullscreen', 'onto-expanded');
            document.body.classList.remove('onto-fs-active');
            setLabel(false);
            refreshCy();
          }
        });
        window.addEventListener('resize', function () {
          if (cy) { cy.resize(); applyZoomStyles(); }
        });
      })();
      hideIsolatesEl?.addEventListener('change', function () {
        initCy();
      });
      var searchTimer = null;
      searchEl?.addEventListener('input', function () {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(function () { focusSearch(searchEl.value); }, 180);
      });
      searchEl?.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          focusSearch(searchEl.value);
        }
      });

      document.addEventListener('bcs:lang', relabelNodes);

      buildFilterUI();
      if (filtersEl) filtersEl.hidden = true;

      function applyHashFocus() {
        try {
          var h = (location.hash || '').replace(/^#/, '');
          if (!h || h.indexOf('=') >= 0) return;
          var id = decodeURIComponent(h);
          if (!id) return;
          if (searchEl) searchEl.value = id;
          focusSearch(id);
        } catch (e) {}
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () {
          initCy();
          renderLegend();
          setTimeout(applyHashFocus, 120);
        });
      } else {
        initCy();
        renderLegend();
        setTimeout(applyHashFocus, 120);
      }
      window.addEventListener('hashchange', applyHashFocus);
    })();
  </script>
</BaseLayout>
