---
import { cleanSourceText } from '../lib/sourceLabel';
import BaseLayout from '../layouts/BaseLayout.astro';
import graph from '../data/graph.json';

const typeOrder = [
  'Territory',
  'Instrument',
  'ResourceCapacity',
  'DemandDriver',
  'Constraint',
  'Actor',
  'Project',
  'Evidence',
  'DecisionQuestion',
];

const typeEn: Record<string, { label: string; description: string }> = {
  Territory: {
    label: 'Territory',
    description: 'State, municipality, corridor or protected area as a spatial decision unit.',
  },
  Instrument: {
    label: 'Instrument',
    description: 'Plan, law or programme governing land uses, UGAs or investment (POERBCS, PED, PDU, POEL…).',
  },
  ResourceCapacity: {
    label: 'Resource capacity',
    description: 'Physical or network supply — water/aquifer, energy/SIBCS, mobility.',
  },
  DemandDriver: {
    label: 'Demand driver',
    description: 'Pressure that consumes capacity — tourism, residential, agro, industry.',
  },
  Constraint: {
    label: 'Constraint / lock',
    description: 'Structural or temporary restriction that vetoes or conditions scenarios.',
  },
  Actor: {
    label: 'Actor',
    description: 'Person or organization with a governance role; may include fp_group tags.',
  },
  Project: {
    label: 'Project',
    description: 'Concrete intervention (desalination plant, PPP, highway, Commitment…).',
  },
  Evidence: {
    label: 'Evidence',
    description: 'Document or dataset in the portal documentary sources.',
  },
  DecisionQuestion: {
    label: 'Decision question',
    description: 'Workshop / lock question the graph should inform.',
  },
};

const predicateEn: Record<string, string> = {
  governs: 'Regulates',
  constrains: 'Limits',
  enables: 'Enables',
  demands: 'Demands from',
  supplies: 'Supplies',
  located_in: 'Located in',
  engages_in: 'Engages in',
  evidenced_by: 'Evidenced by',
  conflicts_with: 'Conflicts with',
  depends_on: 'Depends on',
  informs_decision: 'Informs the decision',
  observed_in: 'Observed in',
  cross_ref_osm: 'Related to',
  isA: 'Is a',
};

const typeMeta = Object.fromEntries(
  (graph.entity_types || []).map((t) => [t.id, t])
);

const nodesByType = typeOrder.map((type) => ({
  type,
  meta: typeMeta[type],
  en: typeEn[type],
  nodes: graph.nodes.filter((n) => n.type === type),
}));

const labelOf = Object.fromEntries(graph.nodes.map((n) => [n.id, n.label]));
const labelEnOf = Object.fromEntries(
  graph.nodes.map((n) => [n.id, (n as { label_en?: string }).label_en || n.label])
);
const predicateLabel = Object.fromEntries(
  (graph.relation_types || []).map((r) => [r.id, r.label_es || r.id])
);

/* PASS5_PRED_ES plain Spanish relation labels */
const PRED_ES_PLAIN: Record<string, string> = {
  governs: 'Regulado por',
  constrains: 'Limita a',
  enables: 'Habilita',
  demands: 'Demanda de',
  supplies: 'Abastece a',
  located_in: 'Se ubica en',
  engages_in: 'Participa en',
  evidenced_by: 'Respaldado por',
  conflicts_with: 'En tensión con',
  depends_on: 'Depende de',
  informs_decision: 'Informa la decisión',
  observed_in: 'Observado en',
  cross_ref_osm: 'Relacionado con',
  isA: 'Es un',
};
Object.keys(PRED_ES_PLAIN).forEach((k) => { predicateLabel[k] = PRED_ES_PLAIN[k]; });


const edgeRows = graph.edges.slice(0, 80).map((e) => ({
  from: labelOf[e.from] || e.from,
  fromEn: labelEnOf[e.from] || e.from,
  fromId: e.from,
  predicate: predicateLabel[e.predicate] || e.predicate,
  predicateEn: predicateEn[e.predicate] || e.predicate,
  predicateId: e.predicate,
  to: labelOf[e.to] || e.to,
  toEn: labelEnOf[e.to] || e.to,
  toId: e.to,
}));

const predicateListEs = graph.relation_types.map((r) => r.label_es).join(' · ');
const predicateListEn = graph.relation_types
  .map((r) => predicateEn[r.id] || r.label_es || r.id)
  .join(' · ');

/** Decision-core node ids for default subgraph view */
const CORE_IDS = [
  'dq_capacidad_carga',
  'dq_coast_anp_buffers',
  'dq_stills_densification',
  'dd_turismo_cabos',
  'dd_residencial_cabos',
  'rc_acuifero_0317',
  'rc_acuifero_0319',
  'rc_acuifero_0324',
  'rc_acuifero_0313',
  'rc_sibcs',
  'rc_aeropuerto_sjd',
  'rc_aeropuerto_lap',
  'rc_tx_lapaz_cabos',
  'const_dma_deficit',
  'const_escasez_agua',
  'const_red_aislada',
  'const_anp_nucleos',
  'const_coast_anp_pressure',
  'inst_pdu_cabos',
  'inst_poerbcs',
  'inst_pamrnt',
  'actor_oomsapas_cabos',
  'actor_conagua',
  'actor_cfe',
  'actor_cenace',
  'actor_conanp',
  'proj_desal_cabos',
  'proj_p23_bs1',
  'terr_los_cabos',
  'terr_corredor_cabos',
  'terr_anp_cabo_pulmo',
  'terr_anp_sierra_laguna',
  'terr_obs_cabos_coast',
  'ev_stills_intel',
];

const typeColors: Record<string, string> = {
  Territory: '#34607d',
  Instrument: '#2a5069',
  ResourceCapacity: '#00A3C4',
  DemandDriver: '#E8A838',
  Constraint: '#C45C4A',
  Actor: '#5B8C5A',
  Project: '#7B6BB0',
  Evidence: '#6B7C8A',
  DecisionQuestion: '#34607d',
};

const graphPayload = {
  nodes: graph.nodes.map((n) => ({
    id: n.id,
    type: n.type,
    label: n.label,
    label_en: (n as { label_en?: string }).label_en || n.label,
    summary: n.summary || '',
    summary_en: (n as { summary_en?: string }).summary_en || n.summary || '',
    evidence_path: (n as { evidence_path?: string }).evidence_path || '',
  })),
  edges: graph.edges.map((e) => ({
    from: e.from,
    to: e.to,
    predicate: e.predicate,
    predicate_es: predicateLabel[e.predicate] || e.predicate,
    predicate_en: predicateEn[e.predicate] || e.predicate,
  })),
  coreIds: CORE_IDS,
  typeColors,
  typeLabelsEs: Object.fromEntries(
    typeOrder.map((t) => [t, typeMeta[t]?.label_es || t])
  ),
  typeLabelsEn: Object.fromEntries(
    typeOrder.map((t) => [t, typeEn[t]?.label || t])
  ),
};
---
<BaseLayout
  title="Mapa de relaciones"
  titleEn="Ontology"
  description="Mapa de relaciones entre territorio, capacidad, proyectos y actores en BCS"
  descriptionEn="Relationship map of territory, capacity, projects and actors in BCS"
  wide={true}
>
  <p class="lead onto-lead">
    <span data-lang-es>
      Mapa de cómo se conectan lugares, capacidad (agua y energía), proyectos y actores.
      Pulse un nodo para ver vecinos y enlaces.
    </span>
    <span data-lang-en hidden>
      Map of how places, capacity (water and energy), projects and actors connect.
      Tap a node to see neighbours and links.
    </span>
  </p><!-- PASS4: technical source callout removed -->

  <!-- PASS3_ONTO_COLLAPSE -->
  <details class="bcs-collapse">
  <summary>
    <span data-lang-es>Para qué sirve en la decisión</span>
    <span data-lang-en hidden>How it supports decisions</span>
  </summary>
  <div class="bcs-collapse-body">
  <h2 class="sr-only">
    <span data-lang-es>Para qué sirve en la decisión</span>
    <span data-lang-en hidden>How it supports decisions</span>
  </h2>
  <ol data-lang-es>
    <li>Partir de una <strong>pregunta de decisión</strong> (p.ej. capacidad de carga).</li>
    <li>Recorrer nodos por tipo — no leer PDFs al azar.</li>
    <li>Anclar la ruta en <strong>evidencia</strong> de las fuentes documentales del portal.</li>
    <li>Llevar la conclusión al grupo de decisión con la ruta de evidencia clara.</li>
  </ol>
  <ol data-lang-en hidden>
    <li>Start from a <strong>decision question</strong> (e.g. carrying capacity).</li>
    <li>Walk nodes by type — do not read PDFs at random.</li>
    <li>Anchor the path in <strong>evidence</strong> from the portal documentary sources.</li>
    <li>Bring the conclusion back to the decision group with a clear evidence path.</li>
  </ol>

  <div class="cta-row">
    <a class="btn" href="/agua/"><span data-lang-es>Ver capacidad</span><span data-lang-en hidden>View capacity</span></a>
    <a class="btn secondary" href="/limitaciones"><span data-lang-es>Ver candados</span><span data-lang-en hidden>View constraints</span></a>
    <a class="btn secondary" href="/actores"><span data-lang-es>Ver actores</span><span data-lang-en hidden>View actors</span></a>
  </div>
  </div></details>

  
  <!-- PASS5 ontology graph hero -->
  <style>
    /* PASS5_ONTO_LAYOUT */
    .onto-lead { max-width: 42rem; margin: 0 0 0.75rem; color: #5c6e7b; font-size: 0.95rem; }
    .onto-graph-shell.onto-graph-hero {
      display: flex;
      flex-direction: column;
      margin: 0.75rem 0 1.5rem;
      border: 1px solid #e2dccf;
      border-radius: 16px;
      background: #fbf8f1;
      overflow: hidden;
      min-height: 70vh;
    }
    .onto-graph-toolbar {
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      padding: 0.75rem 0.9rem;
      border-bottom: 1px solid #e2dccf;
      background: #f3eee3;
    }
    .onto-toolbar-row {
      display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; justify-content: space-between;
    }
    .onto-graph-toggles { display: flex; flex-wrap: wrap; gap: 0.35rem; }
    .onto-graph-tools { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }
    .onto-scope {
      border: 0; border-radius: 999px; padding: 0.35rem 0.75rem;
      background: #e8e8ed; color: #23374a; font: inherit; font-size: 0.8rem; font-weight: 600; cursor: pointer;
    }
    .onto-scope.active { background: #34607d; color: #fbf8f1; }
    .onto-type-seg { display: flex; flex-wrap: wrap; gap: 0.3rem; }
    .onto-type-chip {
      border: 0; border-radius: 999px; padding: 0.28rem 0.65rem;
      background: #fbf8f1; color: #23374a; font: inherit; font-size: 0.74rem; font-weight: 600;
      cursor: pointer; border: 1px solid #e2dccf; display: inline-flex; align-items: center; gap: 0.3rem;
    }
    .onto-type-chip i { width: 0.5rem; height: 0.5rem; border-radius: 50%; display: inline-block; }
    .onto-type-chip.active { background: #34607d; color: #fbf8f1; border-color: #34607d; }
    .onto-type-chip.active i { box-shadow: 0 0 0 1px #fbf8f1; }
    .onto-search-wrap input {
      min-width: 9rem; padding: 0.35rem 0.6rem; border: 1px solid #d1d1d6; border-radius: 8px; font: inherit; font-size: 0.85rem;
    }
    .onto-check { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.78rem; color: #5c6e7b; }
    .onto-graph-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(260px, 320px);
      min-height: 0;
      flex: 1;
      position: relative;
    }
    .onto-cy-wrap {
      position: relative;
      min-height: 70vh;
      height: 70vh;
      background: #fbf8f1;
    }
    #onto-cy { width: 100% !important; height: 100% !important; min-height: 70vh; }
    .onto-zoom-hint { display: none; }
    .onto-detail {
      border-left: 1px solid #e2dccf;
      background: rgba(249,249,251,0.98);
      padding: 0.9rem 1rem;
      overflow: auto;
      max-height: 70vh;
    }
    .onto-detail .onto-type { font-size: 0.72rem; font-weight: 700; color: #34607d; text-transform: uppercase; letter-spacing: 0.03em; }
    .onto-detail h4 { margin: 0.25rem 0 0.45rem; font-size: 1.05rem; }
    .onto-detail ul { margin: 0.35rem 0 0; padding-left: 0; list-style: none; }
    .onto-detail li { margin: 0.35rem 0; font-size: 0.88rem; line-height: 1.35; }
    .onto-pred { color: #5c6e7b; font-weight: 500; }
    .onto-type-filters { display: none !important; }
    .onto-legend { display: none; }
    @media (max-width: 900px) {
      .onto-graph-layout { grid-template-columns: 1fr; }
      .onto-cy-wrap, #onto-cy { min-height: 55vh; height: 55vh; }
      .onto-detail { border-left: 0; border-top: 1px solid #e2dccf; max-height: 38vh; }
    }
    /* dark-mode block removed: light theme forced */
  </style>

  <div class="onto-graph-shell onto-graph-hero" id="onto-graph-shell">
    <div class="onto-graph-toolbar">
      <div class="onto-toolbar-row">
        <div class="onto-graph-toggles" role="group" aria-label="Vista">
          <button type="button" class="onto-scope active" data-scope="core" id="onto-scope-core">
            <span data-lang-es>Núcleo de decisión</span>
            <span data-lang-en hidden>Decision core</span>
          </button>
          <button type="button" class="onto-scope" data-scope="full" id="onto-scope-full">
            <span data-lang-es>Grafo completo</span>
            <span data-lang-en hidden>Full graph</span>
          </button>
        </div>
        <div class="onto-graph-tools">
          <label class="onto-search-wrap">
            <span class="sr-only">Buscar</span>
            <input type="search" id="onto-search" placeholder="Buscar…" autocomplete="off" />
          </label>
          <label class="onto-check">
            <input type="checkbox" id="onto-hide-isolates" />
            <span data-lang-es>Ocultar aislados</span>
            <span data-lang-en hidden>Hide isolates</span>
          </label>
          <button type="button" class="btn secondary" id="onto-zoom-sel">
            <span data-lang-es>Zoom</span><span data-lang-en hidden>Zoom</span>
          </button>
          <button type="button" class="btn secondary" id="onto-reset">
            <span data-lang-es>Restablecer</span><span data-lang-en hidden>Reset</span>
          </button>
        </div>
      </div>
      <div class="onto-type-seg" id="onto-type-seg" role="group" aria-label="Tipo">
        <button type="button" class="onto-type-chip active" data-type="all">
          <span data-lang-es>Todos</span>
          <span data-lang-en hidden>All</span>
        </button>
      </div>
    </div>
    <div class="onto-type-filters" id="onto-type-filters" hidden>
      <div class="onto-filter-grid" id="onto-filter-grid"></div>
    </div>
    <div class="onto-graph-layout">
      <div class="onto-cy-wrap">
        <div id="onto-cy" role="img" aria-label="Grafo ontológico"></div>
      </div>
      <aside class="onto-detail" id="onto-detail" aria-live="polite">
        <p class="meta" data-lang-es>Seleccione un nodo para ver su ficha y vecinos.</p>
        <p class="meta" data-lang-en hidden>Select a node to see its card and neighbours.</p>
      </aside>
    </div>
  </div>
  <div class="onto-legend" id="onto-legend" hidden></div>

  </div>

  <h2><span data-lang-es>Tipos de entidad</span><span data-lang-en hidden>Entity types</span></h2>
  <div class="card-grid">
    {nodesByType.map(({ type, meta, en, nodes }) => (
      <div class="card" id={`tipo-${type}`}>
        <h3>
          <span data-lang-es>{meta?.label_es || type}</span>
          <span data-lang-en hidden>{en?.label || type}</span>
        </h3>
        <p>
          <span data-lang-es>{meta?.description || ''}</span>
          <span data-lang-en hidden>{en?.description || meta?.description || ''}</span>
        </p>
        <p style="margin-top:0.65rem;font-size:0.85rem;color:var(--muted)">
          <span class="tag">{nodes.length}</span>
          <code style="font-size:0.8rem">{type}</code>
        </p>
      </div>
    ))}
  </div>

  <h2>
    <span data-lang-es>Subgrafo núcleo — capacidad de carga</span>
    <span data-lang-en hidden>Core subgraph — carrying capacity</span>
  </h2>
  <p data-lang-es>
    Ruta canónica del programa: demanda turística de Los Cabos → agua en déficit →
    candado DMA → PDU → operador OOMSAPAS (y en paralelo el techo del SIBCS).
  </p>
  <p data-lang-en hidden>
    Canonical programme path: Los Cabos tourism demand → deficit water →
    DMA lock → PDU → OOMSAPAS operator (and in parallel the SIBCS ceiling).
  </p>
  <div class="callout" style="overflow-x:auto">
    <pre class="mermaid-block" style="margin:0;font-size:0.82rem;white-space:pre-wrap;font-family:ui-monospace,monospace;line-height:1.45" data-lang-es>flowchart LR
  DD["Demanda turismo Cabos"] -->|demanda| AGUA["Acuífero CSL 0317"]
  DD -->|demanda| SIBCS["SIBCS"]
  AGUA -->|restringe| DMA["DMA en déficit"]
  DMA -->|restringe| PDU["PDU 2040 Los Cabos"]
  OOM["OOMSAPAS Cabos"] -->|participa_en| PDU
  SIBCS -->|restringe| RED["Red aislada"]
  ANP["Núcleos ANP"] -->|restringe| DD
  DMA -->|informa| DQ["¿Cuánta demanda cabe?"]
  RED -->|informa| DQ</pre>
    <pre class="mermaid-block" style="margin:0;font-size:0.82rem;white-space:pre-wrap;font-family:ui-monospace,monospace;line-height:1.45" data-lang-en hidden>flowchart LR
  DD["Cabos tourism demand"] -->|demands| AGUA["CSL aquifer 0317"]
  DD -->|demands| SIBCS["SIBCS"]
  AGUA -->|constrains| DMA["DMA in deficit"]
  DMA -->|constrains| PDU["PDU 2040 Los Cabos"]
  OOM["OOMSAPAS Cabos"] -->|engages_in| PDU
  SIBCS -->|constrains| RED["Isolated grid"]
  ANP["ANP cores"] -->|constrains| DD
  DMA -->|informs| DQ["How much demand fits?"]
  RED -->|informs| DQ</pre>
  </div>
  <p class="meta">
    <span data-lang-es>Diagrama de texto de la misma ruta canónica del grafo interactivo.</span>
    <span data-lang-en hidden>Text diagram of the same canonical path as the interactive graph.</span>
  </p>

  <h2>
    <span data-lang-es>Entidades por tipo (semilla BCS)</span>
    <span data-lang-en hidden>Entities by type (BCS seed)</span>
  </h2>
  {nodesByType.map(({ type, meta, en, nodes }) => (
    <div class="group-block">
      <h3>
        <span data-lang-es>{meta?.label_es || type}</span>
        <span data-lang-en hidden>{en?.label || type}</span>
        {' '}
        <span class="tag sand">{nodes.length}</span>
      </h3>
      <ul>
        {nodes.map((n) => {
          const nEn = n as { label_en?: string; summary_en?: string };
          return (
            <li>
              <strong>
                <span data-lang-es>{n.label}</span>
                <span data-lang-en hidden>{nEn.label_en || n.label}</span>
              </strong>
              <code style="font-size:0.78rem;margin-left:0.35rem">{n.id}</code>
              —{' '}
              <span data-lang-es>{n.summary}</span>
              <span data-lang-en hidden>{nEn.summary_en || n.summary}</span>
              {n.evidence_path && (
                <>
                  {' '}
                  <span class="meta" style="display:inline">[{/^https?:/.test(n.evidence_path) ? n.evidence_path : cleanSourceText(n.evidence_path)}]</span>
                </>
              )}
              {n.fp_group && (
                <>
                  {' '}
                  <span class="tag">{n.fp_group}</span>
                  {n.subgroup && <span class="tag sand">{n.subgroup}</span>}
                </>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  ))}

  <h2>
    <span data-lang-es>Relaciones (muestra del grafo)</span>
    <span data-lang-en hidden>Relations (graph sample)</span>
  </h2>
  <p>
    <span data-lang-es>
      Predicados: {predicateListEs}.
      Tabla con las primeras {edgeRows.length} de {graph.edges.length} aristas.
    </span>
    <span data-lang-en hidden>
      Predicates: {predicateListEn}.
      Table shows the first {edgeRows.length} of {graph.edges.length} edges.
    </span>
  </p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th><span data-lang-es>Desde</span><span data-lang-en hidden>From</span></th>
          <th><span data-lang-es>Relación</span><span data-lang-en hidden>Relation</span></th>
          <th><span data-lang-es>Hacia</span><span data-lang-en hidden>To</span></th>
        </tr>
      </thead>
      <tbody>
        {edgeRows.map((row) => (
          <tr>
            <td>
              <span data-lang-es>{row.from}</span>
              <span data-lang-en hidden>{row.fromEn}</span>
              <br /><code style="font-size:0.75rem">{row.fromId}</code>
            </td>
            <td>
              <span class="tag">
                <span data-lang-es>{row.predicate}</span>
                <span data-lang-en hidden>{row.predicateEn}</span>
              </span>
            </td>
            <td>
              <span data-lang-es>{row.to}</span>
              <span data-lang-en hidden>{row.toEn}</span>
              <br /><code style="font-size:0.75rem">{row.toId}</code>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>
    <span data-lang-es>Cinco lentes</span>
    <span data-lang-en hidden>Five lenses</span>
  </h2>
  <ol data-lang-es>
    <li><strong>Capacidad de carga</strong> — agua–energía–ANP vs demanda.</li>
    <li><strong>Factibilidad política / agenda</strong> — Foro, PED, Commitment.</li>
    <li><strong>Readiness de inversión</strong> — desaladora, red, aeropuertos.</li>
    <li><strong>Integridad ecológica</strong> — núcleos ANP y recarga.</li>
    <li><strong>Coherencia de instrumentos</strong> — POERBCS ↔ PDU ↔ proyectos.</li>
  </ol>
  <ol data-lang-en hidden>
    <li><strong>Carrying capacity</strong> — water–energy–ANP vs demand.</li>
    <li><strong>Political / agenda feasibility</strong> — Forum, PED, Commitment.</li>
    <li><strong>Investment readiness</strong> — desalination, grid, airports.</li>
    <li><strong>Ecological integrity</strong> — ANP core zones and recharge.</li>
    <li><strong>Instrument coherence</strong> — POERBCS ↔ PDU ↔ projects.</li>
  </ol>
  

  <style>
    .onto-graph-shell {
      margin: 1rem 0 2rem;
      border: 1px solid #e2dccf;
      border-radius: 10px;
      background: #f3eee3;
      overflow: hidden;
    }
    .onto-graph-toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 1rem;
      border-bottom: 1px solid #e2dccf;
      background: #fbf8f1;
    }
