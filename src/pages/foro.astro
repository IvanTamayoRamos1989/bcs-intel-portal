---
import BaseLayout from '../layouts/BaseLayout.astro';
import HowTo from '../components/HowTo.astro';
import PathBanner from '../components/PathBanner.astro';
import CdtPageTone from '../components/CdtPageTone.astro';
import { vistas } from '../lib/vistas';

const aguaSur = vistas.find((v) => v.id === 'agua-sur');
if (!aguaSur) throw new Error('foro water view missing');
---
<BaseLayout
  title="Hoja para invitados"
  titleEn="Guest sheet"
  description="Cuatro enlaces para seguir la reunión sin una cuenta nueva."
  descriptionEn="Four links to follow the meeting without a new account."
  section="Invitados"
  sectionEn="Guests"
  wide={true}
>
  <CdtPageTone />
  <PathBanner current="foro" />
  <HowTo
    leadEs="Esta hoja es para quien llega de lado en la reunión. No pide datos personales. Cada enlace abre una página pública del portal."
    leadEn="This sheet is for someone joining from the side of the meeting. It asks for no personal data. Each link opens a public page of the portal."
    steps={[
      { es: 'Abra el gemelo si quiere comparar municipios.', en: 'Open the twin if you want to compare municipalities.' },
      { es: 'Abra una vista guardada si el grupo ya eligió un mapa.', en: 'Open a saved view if the group already picked a map.' },
      { es: 'Imprima Aprendizaje si necesita la lista de fuentes externas.', en: 'Print Learning if you need the external-source list.' },
    ]}
  />
  <ul class="foro-list">
    <li>
      <a href={aguaSur.gemelo}>
        <span data-lang-es>Gemelo territorial</span>
        <span data-lang-en hidden>Territorial twin</span>
      </a>
      <p class="foro-why"><span data-lang-es>Por qué abrirlo: para comparar municipios con cifras que ya están en el portal, y dejar en blanco las que faltan.</span><span data-lang-en hidden>Why open this: to compare municipalities with figures already in the portal, and leave blank the ones that are missing.</span></p>
      <p><span data-lang-es>Tema, escenario, comparación y recomendaciones. Agua y nivel de vida ya elegidos.</span><span data-lang-en hidden>Theme, scenario, comparison and recommendations. Water and living standard are already selected.</span></p>
    </li>
    <li>
      <a href="/vistas/">
        <span data-lang-es>Vistas guardadas</span>
        <span data-lang-en hidden>Saved views</span>
      </a>
      <p class="foro-why"><span data-lang-es>Por qué abrirlo: para que todo el grupo del Foro Mar de Cortés mire el mismo mapa y el mismo tablero.</span><span data-lang-en hidden>Why open this: so the whole Mar de Cortés forum looks at the same map and the same board.</span></p>
      <p><span data-lang-es>Agua, corredor Cabos–La Paz, puertos, vivienda y East Cape.</span><span data-lang-en hidden>Water, Cabos–La Paz corridor, ports, housing and East Cape.</span></p>
    </li>
    <li>
      <a href="/aprendizaje/">
        <span data-lang-es>Aprendizaje para imprimir</span>
        <span data-lang-en hidden>Learning, ready to print</span>
      </a>
      <p class="foro-why"><span data-lang-es>Por qué abrirlo: para llevar fuentes de otras ciudades sin mezclarlas con las cifras de Baja California Sur.</span><span data-lang-en hidden>Why open this: to bring sources from other cities without mixing them with Baja California Sur figures.</span></p>
      <p><span data-lang-es>Al imprimir queda solo la lista de fuentes externas.</span><span data-lang-en hidden>Printing leaves only the external-source list.</span></p>
    </li>
    <li>
      <a href="/coordinacion/">
        <span data-lang-es>Coordinación</span>
        <span data-lang-en hidden>Coordination</span>
      </a>
      <p class="foro-why"><span data-lang-es>Por qué abrirlo: para ver qué institución aparece con qué obra, sin una fecha de entrega calculada.</span><span data-lang-en hidden>Why open this: to see which institution appears with which work, with no calculated delivery date.</span></p>
      <p><span data-lang-es>Institución, obra y sexenio del inventario federal. Sin fecha de entrega calculada.</span><span data-lang-en hidden>Institution, work and administration from the federal inventory. No calculated delivery date.</span></p>
    </li>
  </ul>
  <style>
    .foro-list { list-style: none; padding: 0; margin: 0.5rem 0; }
    .foro-list li { border: 1px solid #e0e0e0; border-left: 3px solid #0083C4; border-radius: 12px; padding: 0.75rem 0.9rem; margin: 0.55rem 0; background: #fff; }
    .foro-list a { font-weight: 700; color: #006BA3; font-size: 1.05rem; }
    .foro-list p { margin: 0.25rem 0 0; }
    .foro-why { color: #006BA3; font-size: 0.92rem; }
    @page { size: A4; margin: 16mm; }
    @media print {
      :global(.pt-top), :global(.pt-sub), :global(.pt-crumbs), :global(.site-footer), :global(.bcs-chat), :global(.bcs-place-strip), :global(.pt-spec-note), :global(.path-banner), :global(.how-use), :global(.ios-tabbar) { display: none !important; }
      body, body.has-chat-sidebar { padding: 0 !important; margin: 0 !important; background: #fff !important; }
      main { max-width: none !important; }
      .foro-list li { break-inside: avoid; page-break-inside: avoid; border-radius: 0; box-shadow: none; }
      .foro-list a { color: #000; text-decoration: none; }
      .foro-list a[href]::after { content: " — bajacaliforniasur2050.com" attr(href); display: block; margin-top: 0.15rem; font-weight: 400; font-size: 0.82rem; color: #333; word-break: break-all; }
      h1 { break-after: avoid; page-break-after: avoid; }
    }
  </style>
</BaseLayout>
