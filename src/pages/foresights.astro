    crossorigin=""
  />
  <script is:inline src="/vendor/leaflet/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script is:inline>
    (function () {
      var lb = document.getElementById('fs-lightbox');
      var lbImg = document.getElementById('fs-lightbox-img');
      if (lb && lbImg && typeof lb.showModal === 'function') {
        document.querySelectorAll('.fs-diagram-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var src = btn.getAttribute('data-lightbox-src') || '';
            var alt = btn.getAttribute('data-lightbox-alt') || '';
            if (!src) return;
            lbImg.src = src;
            lbImg.alt = alt;
            lb.showModal();
          });
        });
        lb.addEventListener('click', function (e) {
          if (e.target === lb) lb.close();
        });
      }

      var el = document.getElementById('fs-vocation-map');
      if (el && window.L) {
        var map = L.map(el, { scrollWheelZoom: false }).setView([25.0, -111.5], 6);
        L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
          attribution: '&copy; OpenStreetMap &copy; CARTO',
          maxZoom: 12,
        }).addTo(map);
        fetch('/foresights/vocation_places.geojson')
          .then(function (r) { return r.json(); })
          .then(function (gj) {
            var layer = L.geoJSON(gj, {
              pointToLayer: function (feat, latlng) {
                var c = (feat.properties && feat.properties.color) || '#34607d';
                return L.circleMarker(latlng, {
                  radius: 9,
                  fillColor: c,
                  color: '#fbf8f1',
                  weight: 2,
                  fillOpacity: 0.95,
                });
              },
              onEachFeature: function (feat, layer) {
                var p = feat.properties || {};
                var html =
                  '<strong>' + (p.name_es || p.name_en || '') + '</strong><br/>' +
                  '<em>' + (p.vocation_short_es || '') + ' / ' + (p.vocation_short_en || '') + '</em><br/>' +
                  '<span style="font-size:0.85em">' + (p.vocation_es || p.vocation_en || '') + '</span>';
                layer.bindPopup(html);
              },
            }).addTo(map);
            try {
              map.fitBounds(layer.getBounds().pad(0.35));
            } catch (e) {}
          })
          .catch(function () {});
      }

      // Keep CTA deep-link in sync with place strip
      function syncCta() {
        var a = document.querySelector('[data-bcs-gds-cta]');
        if (!a || !window.BCSPlace) return;
        var id = window.BCSPlace.get();
        a.href = id ? '/crecimiento/?place=' + encodeURIComponent(id) + '#' + encodeURIComponent(id) : '/crecimiento/';
      }
      window.addEventListener('bcs:placechange', syncCta);
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', syncCta);
      else setTimeout(syncCta, 0);
    })();
  </script>

