---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Gracias" titleEn="Thank you">
  <p class="lead">
    <span data-lang-es>Recibimos tu envío. El equipo lo revisará manualmente antes de incorporarlo a los datos.</span>
    <span data-lang-en hidden>We received your submission. The team will review it manually before adding it to the data library.</span>
  </p>
  <p class="cta-row">
    <a class="btn" href="/catalogo/"><span data-lang-es>Volver al catálogo</span><span data-lang-en hidden>Back to catalog</span></a>
    <a class="btn secondary" href="/explorar"><span data-lang-es>Explorar</span><span data-lang-en hidden>Explore</span></a>
  </p>
</BaseLayout>
