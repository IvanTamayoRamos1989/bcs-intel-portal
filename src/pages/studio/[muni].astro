            <span data-lang-en hidden>{n.label_en || n.label}</span>
          </a>
        ))}
      </div>
    )}
  </section>

  {dataGaps.length > 0 && (
    <section class="su-sec" id="brechas">
      <h2><span data-lang-es>Brechas de datos</span><span data-lang-en hidden>Data gaps</span></h2>
