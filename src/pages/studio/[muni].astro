      <ul class="su-news">
        {newsShow.map((n: any) => (
          <li>
            <a href={n.url} target="_blank" rel="noopener">
              <span data-lang-es>{n.title_es}</span>
              <span data-lang-en hidden>{n.title_en}</span>
