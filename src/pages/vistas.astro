---
import BaseLayout from '../layouts/BaseLayout.astro';
import HowTo from '../components/HowTo.astro';
import PathBanner from '../components/PathBanner.astro';
import CdtPageTone from '../components/CdtPageTone.astro';
import { vistas } from '../lib/vistas';
---
<BaseLayout
  title="Vistas guardadas"
  titleEn="Saved views"
  description="Enlaces con nombre para abrir el mismo mapa y el mismo tablero."
  descriptionEn="Named links that open the same map and the same board."
  section="Vistas"
  sectionEn="Views"
  wide={true}
>
  <CdtPageTone />
  <PathBanner current="vistas" />
  <HowTo
    leadEs="Una vista es un enlace con nombre. No guarda nada en su cuenta."
    leadEn="A view is a named link. It saves nothing to your account."
    steps={[
      { es: 'Elija la vista que el grupo está mirando.', en: 'Pick the view the group is looking at.' },
      { es: 'Abra el gemelo para las cifras o el mapa para las capas.', en: 'Open the twin for the figures or the map for the layers.' },
      { es: 'Comparta esa misma dirección si alguien llega tarde.', en: 'Share that same address if someone arrives late.' },
    ]}
  />
  <p class="lead">
    <span data-lang-es>
      Cinco vistas con nombre para una reunión. Cada tarjeta dice qué capas enciende el mapa y, si hay escenario, qué encuadre usa.
      Compartir el enlace basta: no hay una cuenta de usuario ni un mapa nuevo.
    </span>
    <span data-lang-en hidden>
      Five named views for a meeting. Each card says which layers the map turns on and, when there is a scenario, which frame it uses.
      Sharing the link is enough: there is no user account and no new map.
    </span>
  </p>
  <p>
    <a href="/gemelo/"><span data-lang-es>Gemelo territorial</span><span data-lang-en hidden>Territorial twin</span></a>
    {' · '}
    <a href="/mapas/"><span data-lang-es>Mapas</span><span data-lang-en hidden>Maps</span></a>
    {' · '}
    <a href="/metas/"><span data-lang-es>Preguntas abiertas</span><span data-lang-en hidden>Open questions</span></a>
  </p>
  {vistas.map((v) => (
    <article class="vista" id={v.id}>
      <h2>
        <span data-lang-es>{v.es}</span>
        <span data-lang-en hidden>{v.en}</span>
      </h2>
      <p>
        <span data-lang-es>{v.note_es}</span>
        <span data-lang-en hidden>{v.note_en}</span>
      </p>
      <p class="vista-open">
        <span data-lang-es>{v.preview_es}</span>
        <span data-lang-en hidden>{v.preview_en}</span>
      </p>
      <p>
        <a class="btn" href={v.gemelo}><span data-lang-es>Abrir en el gemelo</span><span data-lang-en hidden>Open in the twin</span></a>
        {' '}
        <a class="btn secondary" href={v.mapas}><span data-lang-es>Abrir en mapas</span><span data-lang-en hidden>Open in maps</span></a>
      </p>
    </article>
  ))}
  <style>
    .vista { border: 1px solid #e0e0e0; border-left: 3px solid #0083C4; border-radius: 12px; padding: 0.8rem 0.95rem; margin: 0.7rem 0; background: #fff; }
    .vista h2 { margin: 0 0 0.35rem; color: #006BA3; font-size: 1.15rem; }
    .vista p { margin: 0.3rem 0; }
    .vista-open { color: #006BA3; font-size: 0.92rem; }
  </style>
</BaseLayout>
