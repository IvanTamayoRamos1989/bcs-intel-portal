---
import BaseLayout from '../layouts/BaseLayout.astro';
import fc from '../data/flight_connections_bcs.json';
import foresights from '../data/foresights.json';
import { PLACE_BY_ID } from '../lib/places';

const airports = (fc.airports || []) as Array<{
  iata: string;
  name: string;
  name_es: string;
  municipality: string;
  municipality_es: string;
  source_url: string;
  diagram?: string;
  destinations: Array<{
    city: string;
    iata: string;
    country: string;
    flights_per_month?: number | null;
    duration?: string;
    duration_hours?: number;
  }>;
  counts: { total: number; us: number; mx: number; ca: number; eu: number; other: number };
  notes?: string;
}>;
const retrieved = fc.retrieved || '2026-09-17';
const disclaimer = fc.disclaimer || '';
const disclaimerEs = fc.disclaimer_es || disclaimer;
const source = fc.source || 'FlightConnections.com';

const AIRPORT_PLACE: Record<string, string> = { SJD: 'los_cabos', LAP: 'la_paz', LTO: 'loreto' };
const signals = ((foresights as any).signals || []) as any[];
function feedsForAirport(iata: string) {
  const pid = AIRPORT_PLACE[iata];
  const sigs = signals.filter((s) => {
    const refs = (s.provenance && s.provenance.flight_refs) || [];
    if (refs.some((r: any) => r.iata === iata)) return true;
    return pid && (s.place_ids || []).includes(pid);
  });
  return { placeId: pid, signals: sigs.slice(0, 4) };
}
function placeShort(id: string, lang: 'es' | 'en') {
  const pl = PLACE_BY_ID[id];
  if (!pl) return id;
  return lang === 'en' ? pl.short_en : pl.short_es;
}
---
<BaseLayout
  title="Conectividad aérea"
  titleEn="Air connectivity"
  description="Destinos sin escalas SJD, LAP y LTO según FlightConnections"
  descriptionEn="Non-stop destinations from SJD, LAP and LTO per FlightConnections"
  wide={true}
>
  <p class="lead">
    <span data-lang-es>
      Destinos <strong>sin escalas</strong> desde los tres aeropuertos internacionales de BCS,
      según <a href="https://www.flightconnections.com/" rel="noopener" target="_blank">{source}</a>
      (consultado {retrieved}). Complementa <a href="/conectividad">Conectividad</a> y
      <a href="/puertos">Puertos</a>.
    </span>
    <span data-lang-en hidden>
      <strong>Non-stop</strong> destinations from BCS’s three international airports, per
      <a href="https://www.flightconnections.com/" rel="noopener" target="_blank">{source}</a>
      (retrieved {retrieved}). Complements <a href="/conectividad">Connectivity</a> and
      <a href="/puertos">Ports</a>.
    </span>
  </p>

  <p class="cite-banner" role="note">
    <span data-lang-es>{disclaimerEs}</span>
    <span data-lang-en hidden>{disclaimer}</span>
  </p>

  <div class="stat-grid air-kpi">
    {airports.map((a) => (
      <a class="stat air-stat" href={`#${a.iata.toLowerCase()}`}>
        <span class="n">{a.counts.total}</span>
        <span class="l">
          <strong>{a.iata}</strong>
          <span data-lang-es> destinos sin escalas</span>
          <span data-lang-en hidden> non-stop destinations</span>
        </span>
        <span class="air-breakdown">
          MX {a.counts.mx} · US {a.counts.us} · CA {a.counts.ca}
          {a.counts.eu ? ` · EU ${a.counts.eu}` : ''}
          {a.counts.other ? ` · other ${a.counts.other}` : ''}
        </span>
      </a>
    ))}
  </div>


  <section class="air-feeds" id="feeds-foresights">
    <h2>
      <span data-lang-es>Alimenta la prospectiva</span>
      <span data-lang-en hidden>Feeds foresights</span>
    </h2>
    <p class="meta">
      <span data-lang-es>La conectividad aérea es evidencia de demanda por vocación — no un destino aislado. Cada aeropuerto enlaza a lugar y señales.</span>
      <span data-lang-en hidden>Air connectivity is demand evidence by vocation — not an orphan destination. Each airport links to place and signals.</span>
    </p>
    <div class="air-feeds-grid">
      {airports.map((a) => {
        const feed = feedsForAirport(a.iata);
        return (
          <article class="air-feed-card" id={`feed-${a.iata.toLowerCase()}`}>
            <h3>{a.iata} · {a.counts.total}
              <span data-lang-es> destinos</span>
              <span data-lang-en hidden> destinations</span>
            </h3>
            {feed.placeId && (
              <p>
                <a class="air-feed-chip" href={`/crecimiento/?place=${feed.placeId}#${feed.placeId}`}>
                  <span data-lang-es>Lugar: {placeShort(feed.placeId, 'es')}</span>
                  <span data-lang-en hidden>Place: {placeShort(feed.placeId, 'en')}</span>
                </a>
                <a class="air-feed-chip" href={`/foresights/?place=${feed.placeId}#${feed.placeId}`}>
                  <span data-lang-es>Prospectiva</span>
                  <span data-lang-en hidden>Foresights</span>
                </a>
              </p>
            )}
            <div class="air-feed-sigs">
              {feed.signals.map((s: any) => (
                <a class="air-feed-chip air-feed-chip--sig" href={`/foresights/?signal=${s.id}#signal-${s.id}`}>
                  {s.id}
                </a>
              ))}
              {!feed.signals.length && (
                <span class="meta">
                  <span data-lang-es>Sin señal etiquetada aún — ver /foresights</span>
                  <span data-lang-en hidden>No tagged signal yet — see /foresights</span>
                </span>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <div class="air-filter-bar">
    <label for="air-q">
      <span data-lang-es>Buscar destino</span>
      <span data-lang-en hidden>Search destination</span>
    </label>
    <input
      id="air-q"
      type="search"
      placeholder="City / IATA / country…"
      autocomplete="off"
    />
    <label for="air-airport">
      <span data-lang-es>Aeropuerto</span>
      <span data-lang-en hidden>Airport</span>
    </label>
    <select id="air-airport">
      <option value="">All / Todos</option>
      {airports.map((a) => (
        <option value={a.iata}>{a.iata} — {a.municipality}</option>
      ))}
    </select>
  </div>

  {airports.map((a) => (
    <section class="air-card" id={a.iata.toLowerCase()} data-airport={a.iata}>
      <header class="air-card-head">
        <div>
          <h2>
            <span class="iata-badge">{a.iata}</span>
            <span data-lang-es>{a.name_es}</span>
            <span data-lang-en hidden>{a.name}</span>
          </h2>
          <p class="air-meta">
            <span data-lang-es>{a.municipality_es}</span>
            <span data-lang-en hidden>{a.municipality}</span>
            · {a.counts.total}
            <span data-lang-es> destinos</span>
            <span data-lang-en hidden> destinations</span>
            (MX {a.counts.mx} / US {a.counts.us} / CA {a.counts.ca}
            {a.counts.eu ? ` / EU ${a.counts.eu}` : ''}
            {a.counts.other ? ` / other ${a.counts.other}` : ''})
          </p>
        </div>
        <a class="btn-link" href={a.source_url} rel="noopener" target="_blank">
          <span data-lang-es>Abrir en FlightConnections ↗</span>
          <span data-lang-en hidden>Open on FlightConnections ↗</span>
        </a>
      </header>

      {a.diagram && (
        <figure class="air-diagram">
          <button
            type="button"
            class="air-diagram-btn"
            data-lightbox-src={a.diagram}
            data-lightbox-alt={`FlightConnections route map ${a.iata}`}
            aria-label={`Expand ${a.iata} route map`}
          >
            <img
              src={a.diagram}
              alt={`FlightConnections route map ${a.iata}`}
              loading="lazy"
              decoding="async"
            />
            <span class="air-diagram-expand" aria-hidden="true">
              <span data-lang-es>Ampliar mapa</span>
              <span data-lang-en hidden>Expand map</span>
            </span>
          </button>
          <figcaption class="air-diagram-cap">
            <span data-lang-es>
              Diagrama de rutas (captura completa) · fuente {source} · {retrieved}.
              Clic para ampliar.
            </span>
            <span data-lang-en hidden>
              Route diagram (full screenshot) · source {source} · {retrieved}.
              Click to expand.
            </span>
            {' · '}
            <a href={a.source_url} rel="noopener" target="_blank">
              <span data-lang-es>Abrir en FlightConnections</span>
              <span data-lang-en hidden>Open on FlightConnections</span>
            </a>
          </figcaption>
        </figure>
      )}

      <div class="table-wrap air-table-wrap">
        <table class="air-table">
          <thead>
            <tr>
              <th><span data-lang-es>Ciudad</span><span data-lang-en hidden>City</span></th>
              <th>IATA</th>
              <th><span data-lang-es>País</span><span data-lang-en hidden>Country</span></th>
              <th><span data-lang-es>Vuelos / mes</span><span data-lang-en hidden>Flights / month</span></th>
              <th><span data-lang-es>Duración</span><span data-lang-en hidden>Duration</span></th>
            </tr>
          </thead>
          <tbody>
            {a.destinations.map((d) => (
              <tr
                data-q={`${d.city} ${d.iata} ${d.country}`.toLowerCase()}
                data-airport={a.iata}
              >
                <td>{d.city}</td>
                <td><code>{d.iata}</code></td>
                <td>{d.country}</td>
                <td>{d.flights_per_month != null ? d.flights_per_month : '—'}</td>
                <td>{d.duration || (d.duration_hours != null ? `${d.duration_hours}h` : '—')}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {a.notes && <p class="air-note">{a.notes}</p>}
    </section>
  ))}

  <p class="meta">
    <span data-lang-es>Fuente: FlightConnections.com — rutas sin escalas por aeropuerto (consultado 2026-09-17) y capturas de sus mapas de rutas.</span>
    <span data-lang-en hidden>Source: FlightConnections.com — non-stop routes per airport (retrieved 2026-09-17) and captures of its route maps.</span>
  </p>

  {/* Full-size map lightbox — must live inside layout <main>/<body> */}
  <dialog id="air-lightbox" class="air-lightbox" aria-label="Expanded route map">
    <form method="dialog" class="air-lightbox-bar">
      <button type="submit" class="air-lightbox-close" value="close">
        <span data-lang-es>Cerrar</span>
        <span data-lang-en hidden>Close</span>
        <span aria-hidden="true"> ×</span>
      </button>
    </form>
    <img id="air-lightbox-img" src="" alt="" />
  </dialog>

  <style is:global>
    .air-feeds { margin: 1.75rem 0 1.25rem; }
    .air-feeds h2 { font-size: 1.15rem; color: #23374a; margin: 0 0 0.35rem; }
    .air-feeds-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 0.85rem;
      margin-top: 0.75rem;
    }
    .air-feed-card {
      border: 1px solid #e2dccf;
      border-radius: 12px;
      padding: 0.85rem 1rem;
      background: #f3eee3;
    }
    .air-feed-card h3 { margin: 0 0 0.5rem; font-size: 1rem; }
    .air-feed-chip {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 600;
      padding: 0.15rem 0.5rem;
      border-radius: 999px;
      background: #dfe8ee;
      color: #34607d;
      text-decoration: none;
      margin: 0.15rem 0.25rem 0.15rem 0;
    }
    .air-feed-chip--sig { background: #f3e6cc; color: #a8664a; }
    .air-feed-sigs { margin-top: 0.35rem; }
  </style>
</BaseLayout>

<style>
  .cite-banner {
    background: #f7f3ea;
    border: 1px solid var(--border, #d9d2c4);
    border-left: 4px solid #b0892e;
    padding: 0.75rem 1rem;
    font-size: 0.92rem;
    margin: 0 0 1.25rem;
  }
  .air-kpi .air-stat {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .air-breakdown {
    font-size: 0.75rem;
    opacity: 0.75;
  }
  .air-filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: center;
    margin: 0 0 1.5rem;
    padding: 0.75rem 1rem;
    background: #fbf8f1;
    border: 1px solid var(--border, #d9d2c4);
  }
  .air-filter-bar input[type='search'] {
    flex: 1 1 220px;
    min-width: 180px;
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--border, #d9d2c4);
    border-radius: 4px;
  }
  .air-filter-bar select {
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--border, #d9d2c4);
    border-radius: 4px;
  }
  .air-card {
    margin: 0 0 2.25rem;
    padding: 1.25rem 1.25rem 1rem;
    background: #fbf8f1;
    border: 1px solid var(--border, #d9d2c4);
    border-radius: 6px;
    overflow: visible;
  }
  .air-card-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: flex-start;
    margin-bottom: 1rem;
  }
  .air-card-head h2 {
    margin: 0 0 0.35rem;
    font-size: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  .iata-badge {
    display: inline-block;
    background: #23374a;
    color: #fbf8f1;
    font-size: 0.85rem;
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    letter-spacing: 0.04em;
  }
  .air-meta {
    margin: 0;
    font-size: 0.9rem;
    opacity: 0.85;
  }
  .btn-link {
    font-size: 0.88rem;
    white-space: nowrap;
  }

  /* Full diagram — never crop with object-fit:cover / short max-height */
  .air-diagram {
    margin: 0 0 1rem;
    overflow: visible;
  }
  .air-diagram-btn {
    display: block;
    width: 100%;
    padding: 0;
    margin: 0;
    border: 1px solid var(--border, #d9d2c4);
    border-radius: 4px;
    background: #eef2f5;
    cursor: zoom-in;
    position: relative;
    overflow: visible;
    text-align: left;
  }
  .air-diagram-btn:focus-visible {
    outline: 3px solid var(--fp-cyan, #34607d);
    outline-offset: 2px;
  }
  .air-diagram img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    max-height: none;
    object-fit: contain;
    object-position: center top;
    vertical-align: top;
    background: #eef2f5;
  }
  .air-diagram-expand {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    background: rgba(26, 43, 60, 0.88);
    color: #fbf8f1;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.3rem 0.55rem;
    border-radius: 3px;
    pointer-events: none;
    letter-spacing: 0.02em;
  }
  .air-diagram-cap {
    font-size: 0.78rem;
    opacity: 0.85;
    margin-top: 0.4rem;
    line-height: 1.45;
  }

  .air-note {
    font-size: 0.82rem;
    opacity: 0.75;
    margin: 0.75rem 0 0;
  }

  /* Tables: horizontal scroll + sticky header inside scroll box */
  .air-table-wrap {
    overflow: auto;
    max-width: 100%;
    max-height: min(70vh, 560px);
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--border, #d9d2c4);
    border-radius: 4px;
    margin: 0.5rem 0 0;
  }
  .air-table {
    width: 100%;
    min-width: 520px;
    margin: 0;
    border-collapse: separate;
    border-spacing: 0;
  }
  .air-table thead th {
    position: sticky;
    top: 0;
    z-index: 2;
    background: var(--fp-blue, #34607d);
    color: #fbf8f1;
    box-shadow: 0 1px 0 rgba(35, 55, 74, 0.12);
  }
  .air-table tr.is-hidden {
    display: none;
  }
  .air-card.is-hidden {
    display: none;
  }

  /* Lightbox overlay */
  .air-lightbox {
    border: none;
    padding: 0;
    max-width: min(96vw, 1400px);
    max-height: 94vh;
    width: auto;
    background: #23374a;
    color: #fbf8f1;
    border-radius: 6px;
  }
  .air-lightbox::backdrop {
    background: rgba(10, 16, 24, 0.78);
  }
  .air-lightbox-bar {
    display: flex;
    justify-content: flex-end;
    margin: 0;
    padding: 0.35rem 0.5rem;
    background: #23374a;
  }
  .air-lightbox-close {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #fbf8f1;
    font: inherit;
    font-size: 0.88rem;
    padding: 0.35rem 0.7rem;
    cursor: pointer;
    border-radius: 3px;
  }
  .air-lightbox-close:hover {
    background: rgba(255, 255, 255, 0.12);
  }
  .air-lightbox img {
    display: block;
    max-width: 96vw;
    max-height: calc(94vh - 2.75rem);
    width: auto;
    height: auto;
    margin: 0 auto;
    object-fit: contain;
  }
</style>

<script is:inline>
  (function () {
    var q = document.getElementById('air-q');
    var sel = document.getElementById('air-airport');
    if (q && sel) {
      function apply() {
        var query = (q.value || '').trim().toLowerCase();
        var ap = sel.value || '';
        document.querySelectorAll('.air-card').forEach(function (card) {
          var cardAp = card.getAttribute('data-airport') || '';
          var showCard = !ap || cardAp === ap;
          var anyVisible = false;
          card.querySelectorAll('tbody tr').forEach(function (tr) {
            var hay = tr.getAttribute('data-q') || '';
            var matchQ = !query || hay.indexOf(query) !== -1;
            var matchAp = !ap || (tr.getAttribute('data-airport') || '') === ap;
            var ok = matchQ && matchAp;
            tr.classList.toggle('is-hidden', !ok);
            if (ok) anyVisible = true;
          });
          card.classList.toggle('is-hidden', !showCard || (query && !anyVisible));
        });
      }
      q.addEventListener('input', apply);
      sel.addEventListener('change', apply);
    }

    var lb = document.getElementById('air-lightbox');
    var lbImg = document.getElementById('air-lightbox-img');
    if (lb && lbImg && typeof lb.showModal === 'function') {
      document.querySelectorAll('.air-diagram-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var src = btn.getAttribute('data-lightbox-src') || '';
          var alt = btn.getAttribute('data-lightbox-alt') || '';
          if (!src) return;
          lbImg.src = src;
          lbImg.alt = alt;
          lb.showModal();
        });
      });
      lb.addEventListener('click', function (e) {
        if (e.target === lb) lb.close();
      });
    }
  })();
</script>
