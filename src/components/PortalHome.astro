---
import '../styles/global.css';
import ThreeNav from './ThreeNav.astro';
import ChatWidget from './ChatWidget.astro';
import { ui } from '../i18n/ui';
---
<!doctype html>
<html lang="es" data-lang="es" data-title-es="Preguntar" data-title-en="Ask" data-title-suffix=" · BCS 2050">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" /><meta name="theme-color" content="#f7f6ef" />
  <title>Preguntar · BCS 2050</title>
  <script is:inline define:vars={{uiObj:ui}}>window.__BCS_UI__=uiObj;</script>
  <script is:inline src="/auth-gate.js"></script><script is:inline src="/lang-toggle.js?v=20261102-ux"></script>
  <script is:inline>
    var oldView=new URLSearchParams(location.search);
    if(['base','theme','tema','muni','q'].some(function(k){return oldView.has(k);}))location.replace('/consulta/'+location.search+location.hash);
  </script>
</head>
<body class="shell-app conversation-page">
  <ThreeNav active="ask" />
  <main id="conversation-main">
    <section class="conversation-welcome" id="conversation-welcome">
      <p>BAJA CALIFORNIA SUR</p>
      <h1><span data-lang-es>¿Qué quieres conocer?</span><span data-lang-en hidden>What would you like to know?</span></h1>
      <div><span data-lang-es>Pregunta sobre el estado. Explora sus datos, lugares y documentos.</span><span data-lang-en hidden>Ask about the state. Explore its data, places and documents.</span></div>
    </section>
    <button type="button" id="conversation-new" hidden><span data-lang-es>＋ Nueva conversación</span><span data-lang-en hidden>＋ New conversation</span></button>
    <ChatWidget shell={true} />
  </main>
  <script is:inline src="/conversation.js?v=20261103-pages" defer></script>
  <link rel="stylesheet" href="/conversation.css?v=20261103-pages" />
</body></html>
