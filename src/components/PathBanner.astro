---
interface Props { current?: string }
const { current = '' } = Astro.props;
const steps = [
  { id: 'aprendizaje', href: '/aprendizaje/', es: 'Aprender', en: 'Learn' },
  { id: 'vistas', href: '/vistas/', es: 'Ver vista', en: 'Open a view' },
  { id: 'gemelo', href: '/gemelo/', es: 'Comparar', en: 'Compare' },
  { id: 'coordinacion', href: '/coordinacion/', es: 'Coordinar', en: 'Coordinate' },
];
---
<nav class="path-banner" aria-label="Ruta de decisión" data-aria-es="Ruta de decisión" data-aria-en="Decision path">
  <ol>
    {steps.map((s, i) => (
      <li>
        {i > 0 && <span class="path-arrow" aria-hidden="true">→</span>}
        <a href={s.href} aria-current={current === s.id ? 'page' : undefined}>
          <span class="path-n">{i + 1}</span>
          <span data-lang-es>{s.es}</span>
          <span data-lang-en hidden>{s.en}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>
<style>
  .path-banner { margin: 0 0 0.8rem; }
  .path-banner ol { display: flex; flex-wrap: wrap; gap: 0.35rem 0.2rem; list-style: none; margin: 0; padding: 0; align-items: center; }
  .path-banner li { display: flex; align-items: center; gap: 0.2rem; }
  .path-banner a {
    display: inline-flex; align-items: center; gap: 0.35rem;
    border: 1px solid #e0e0e0; border-radius: 999px; padding: 0.28rem 0.65rem;
    text-decoration: none; color: #1a1a1a; background: #fff; font-size: 0.82rem; font-weight: 650;
  }
  .path-banner a[aria-current="page"] { background: #0083C4; border-color: #0083C4; color: #fff; }
  .path-n { display: inline-flex; width: 1.15rem; height: 1.15rem; align-items: center; justify-content: center; border-radius: 999px; background: #e8f4fb; color: #006BA3; font-size: 0.72rem; }
  .path-banner a[aria-current="page"] .path-n { background: #fff; color: #006BA3; }
  .path-arrow { color: #5a5a5a; font-size: 0.8rem; }
  .path-banner a:focus-visible { outline: 2px solid #0083C4; outline-offset: 2px; }
  @media (max-width: 420px) {
    .path-banner a { font-size: 0.75rem; padding: 0.24rem 0.5rem; }
  }
</style>
