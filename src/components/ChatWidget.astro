<script is:inline src="/js/bcs-chat-render.js"></script>
<script is:inline src="/js/bcs-grok-voice.js"></script>
<script is:inline>
(function () {
  var root = document.getElementById('bcs-chat');
  if (!root) return;
  var panel = document.getElementById('bcs-chat-panel');
  var openBtn = document.getElementById('bcs-chat-open');
  var closeBtn = document.getElementById('bcs-chat-close');
  var form = document.getElementById('bcs-chat-form');
  var input = document.getElementById('bcs-chat-input');
  var msgs = document.getElementById('bcs-chat-msgs');
  var history = [];
  var CHAT_HOME = document.body.classList.contains('chat-home');
  var MQ = CHAT_HOME ? { matches: false, addEventListener: function () {} } : window.matchMedia('(max-width: 900px)');
  var SESSION_KEY = 'bcs_chat_sid';
  function chatSessionId() {
    try {
      var sid = sessionStorage.getItem(SESSION_KEY);
      if (sid && sid.length >= 8) return sid;
      sid = (crypto.randomUUID && crypto.randomUUID()) ||
        ('s' + Date.now().toString(36) + Math.random().toString(36).slice(2, 10));
      sessionStorage.setItem(SESSION_KEY, sid);
      return sid;
    } catch (e) {
      return null;
    }
  }


  function t(key) {
    var ui = window.__BCS_UI__ || {};
    var lang = (document.documentElement.getAttribute('data-lang') || 'es');
    var bag = ui[lang] || ui.es || {};
    return bag[key] || key;
  }

  function syncPlaceholders() {
    var ph = t('chatPlaceholder');
    if (input) input.setAttribute('placeholder', ph);
  }

  var backdrop = document.getElementById('bcs-chat-backdrop');

  var sheetControls = document.getElementById('bcs-chat-sheet-controls');
  var SHEET_KEY = 'bcs_chat_sheet';

  function getSheet() {
    try {
      var s = localStorage.getItem(SHEET_KEY);
      if (s === 'full' || s === 'partial') return s;
    } catch (e) {}
    return 'partial';
  }

  function setSheet(mode) {
    if (mode !== 'full' && mode !== 'partial' && mode !== 'collapsed') mode = 'partial';
    root.setAttribute('data-sheet', mode);
    try {
      if (mode === 'collapsed') { /* don't persist collapsed as preferred open size */ }
      else localStorage.setItem(SHEET_KEY, mode);
    } catch (e) {}
    if (sheetControls) {
      sheetControls.hidden = !MQ.matches || root.getAttribute('data-open') !== 'true';
      sheetControls.querySelectorAll('.bcs-chat-sheet-btn').forEach(function (btn) {
        btn.setAttribute('aria-pressed', btn.getAttribute('data-sheet') === mode ? 'true' : 'false');
      });
    }
    // Preserve place strip context — do not clear BCSPlace
  }

  // Portal pages (BaseLayout, body.has-chat-sidebar): on desktop the assistant is a docked panel that
  // "Preguntar" opens and "Cerrar" hides, remembered per browser (like the atlas). Other hosts keep the
  // previous always-open desktop sidebar.
  var DOCKABLE = document.body.classList.contains('has-chat-sidebar') && !CHAT_HOME;
  var DOCK_KEY = 'bcs_chat_docked';
  function dockPref() {
    try {
      var v = localStorage.getItem(DOCK_KEY);
      if (v === '1') return true;
      if (v === '0') return false;
    } catch (e) {}
    return window.innerWidth >= 1100 || /^\/(inicio|chat)\/?$/.test(location.pathname);
  }
  function rememberDock(open) {
    if (!DOCKABLE || MQ.matches) return;
    try { localStorage.setItem(DOCK_KEY, open ? '1' : '0'); } catch (e) {}
  }
  function setOpen(open, sheetMode) {
    // Desktop: docked sidebar; mobile: 3-state sheet
    if (!MQ.matches) {
      if (!DOCKABLE) open = true;
      root.setAttribute('data-sheet', 'desktop');
    } else {
      if (open) {
        var mode = sheetMode || getSheet() || 'partial';
        if (mode === 'collapsed') mode = 'partial';
        setSheet(mode);
      } else {
        setSheet('collapsed');
      }
    }
    root.setAttribute('data-open', open ? 'true' : 'false');
    if (openBtn) openBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    document.body.classList.toggle('chat-drawer-open', MQ.matches && open);
    if (DOCKABLE) document.body.classList.toggle('chat-docked', !MQ.matches && open);
    document.body.classList.toggle('chat-sheet-full', MQ.matches && open && root.getAttribute('data-sheet') === 'full');
    if (backdrop) {
      if (MQ.matches && open) backdrop.removeAttribute('hidden');
      else backdrop.setAttribute('hidden', '');
    }
    if (panel) {
      var hidePanel = MQ.matches && !open;
      panel.setAttribute('aria-hidden', hidePanel ? 'true' : 'false');
      if (hidePanel) panel.setAttribute('inert', '');
      else panel.removeAttribute('inert');
    }
    if (sheetControls) sheetControls.hidden = !MQ.matches || !open;
    if (open && input && MQ.matches) {
      setTimeout(function () { input.focus(); }, 280);
    }
    syncPlaceholders();
  }

  // Desktop: open unless the reader closed it (portal pages); mobile collapsed so pages stay full width
  setOpen(!MQ.matches && (!DOCKABLE || dockPref()));

  openBtn && openBtn.addEventListener('click', function () { setOpen(true, getSheet()); });
  closeBtn && closeBtn.addEventListener('click', function () { setOpen(false); rememberDock(false); });
  backdrop && backdrop.addEventListener('click', function () { setOpen(false); });
  sheetControls && sheetControls.addEventListener('click', function (e) {
    var btn = e.target.closest('.bcs-chat-sheet-btn');
    if (!btn) return;
    var mode = btn.getAttribute('data-sheet');
    if (mode) setOpen(true, mode);
  });
  // Swipe-down on head to collapse (light)
  var head = root.querySelector('.bcs-chat-head');
  if (head) {
    var touchY = null;
    head.addEventListener('touchstart', function (e) {
      if (!MQ.matches) return;
      touchY = e.changedTouches[0].clientY;
    }, { passive: true });
    head.addEventListener('touchend', function (e) {
      if (!MQ.matches || touchY == null) return;
      var dy = e.changedTouches[0].clientY - touchY;
      touchY = null;
      if (dy > 60) {
        var cur = root.getAttribute('data-sheet');
        if (cur === 'full') setOpen(true, 'partial');
        else setOpen(false);
      } else if (dy < -40 && root.getAttribute('data-open') === 'true') {
        setOpen(true, 'full');
      }
    }, { passive: true });
  }
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && MQ.matches && root.getAttribute('data-open') === 'true') {
      var cur = root.getAttribute('data-sheet');
      if (cur === 'full') setOpen(true, 'partial');
      else setOpen(false);
    }
  });
  MQ.addEventListener && MQ.addEventListener('change', function () {
    setOpen(!MQ.matches && (!DOCKABLE || dockPref()));
  });

  function el(tag, cls, text) {
    var n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text != null) n.textContent = text;
    return n;
  }

  function appendChainLinks(div, payload) {
    var lang = document.documentElement.getAttribute('data-lang') || 'es';
    var links = el('div', 'bcs-chat-links');
    var chainLabel = el('div', 'bcs-chat-link-label bcs-chat-chain-title');
    chainLabel.textContent = lang === 'en' ? 'Evidence chain' : 'Cadena de evidencia';
    links.appendChild(chainLabel);
    var row = el('div', 'bcs-chat-chain-row');
    var any = false;

    function addChip(label, href, title, external) {
      if (!href && !label) return;
      any = true;
      var a = el('a', 'bcs-chat-chip bcs-chat-chain-chip');
      a.textContent = label;
      if (title) a.title = title;
      if (href) {
        a.href = href;
        if (external) {
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
        }
      } else {
        a.href = '#';
        a.addEventListener('click', function (e) { e.preventDefault(); });
        a.classList.add('bcs-chat-chip--static');
      }
      row.appendChild(a);
    }

    // 1) Primary file
    var pf = payload && payload.primary_file;
    if (pf && (pf.view_url || pf.catalog_url || pf.path || pf.title)) {
      var pft = safeCardTitle(pf);
      var flab = (lang === 'en' ? 'Document: ' : 'Documento: ') + pft;
      if (flab.length > 42) flab = flab.slice(0, 40) + '…';
      addChip(flab, pf.view_url || pf.catalog_url || ('/catalogo?q=' + catalogQuery(pf)), pft, !!pf.view_url);
    }

    // 2) Ontology (first 2)
    var onto = (payload && payload.ontology) || [];
    onto.slice(0, 2).forEach(function (n) {
      var lab = (lang === 'es' && n.label_es) ? n.label_es : (n.label || n.id);
      addChip((lang === 'en' ? 'Onto: ' : 'Onto: ') + lab, n.href || ('/ontologia#' + encodeURIComponent(n.id || '')), n.why || lab, false);
    });

    // 3) Stakeholder
    var st = payload && payload.stakeholder;
    if (st && st.name) {
      addChip((lang === 'en' ? 'Actor: ' : 'Actor: ') + st.name, st.href || ('/stakeholders?q=' + encodeURIComponent(st.name)), st.description || st.name, false);
    }

    // 4) Place vocation
    var place = payload && payload.place;
    var placeId = null;
    var placeLab = null;
    if (place && typeof place === 'object') {
      placeId = place.id;
      placeLab = (lang === 'en' ? (place.label_en || place.label_es) : (place.label_es || place.label_en)) || placeId;
    } else if (typeof place === 'string' && place) {
      placeId = place;
      placeLab = place.replace(/_/g, ' ');
    }
    if (!placeId && window.BCSPlace && window.BCSPlace.get) placeId = window.BCSPlace.get() || null;
    if (placeId) {
      if (!placeLab) placeLab = placeId.replace(/_/g, ' ');
      addChip((lang === 'en' ? 'Place: ' : 'Lugar: ') + placeLab, '/crecimiento/?place=' + encodeURIComponent(placeId) + '#' + encodeURIComponent(placeId), placeId, false);
    }

    // 5) Foresight signal(s)
    var signals = [];
    if (payload && Array.isArray(payload.foresight_signals)) signals = payload.foresight_signals;
    else if (payload && payload.foresight_signal) signals = [payload.foresight_signal];
    signals.slice(0, 3).forEach(function (sig) {
      if (!sig) return;
      var sid = sig.id || '';
      var stitle = (lang === 'en' ? (sig.title_en || sig.title_es) : (sig.title_es || sig.title_en)) || sid;
      if (stitle.length > 36) stitle = stitle.slice(0, 34) + '…';
      var href = '/foresights/';
      if (placeId) href += '?place=' + encodeURIComponent(placeId);
      if (sid) href += (href.indexOf('?') >= 0 ? '&' : '?') + 'signal=' + encodeURIComponent(sid);
      href += '#signal-' + encodeURIComponent(sid || 'signals');
      addChip((lang === 'en' ? 'Signal: ' : 'Señal: ') + (sid || stitle), href, stitle, false);
    });

    var sqs = (payload && payload.strategic_questions) || [];
    sqs.slice(0, 2).forEach(function (sq) {
      if (!sq) return;
      var lab = (lang === 'en' ? (sq.question_en || sq.question_es) : (sq.question_es || sq.question_en)) || sq.id;
      if (lab.length > 40) lab = lab.slice(0, 38) + '…';
      addChip((lang === 'en' ? 'Q: ' : 'P: ') + (sq.id || lab), sq.href || ('/preguntas/' + encodeURIComponent(sq.id || '') + '/'), lab, false);
    });

    if (any) {
      links.appendChild(row);
      div.appendChild(links);
    }
  }

  // Card titles (2026-10-08): never render a raw file name; the server sends human titles, this is the guard.
  var CARD_FILE_RE = /\.(pdf|md|csv|tsv|xlsx?|json|geojson|zip|kml|kmz|docx?|pptx?|txt|py|mjs|ya?ml|shp|dbf|prj|esp|html?|jpe?g|png|webp)\b|_|^\d{4}(-\d{2}){0,2}[ _-]?_/i;
  function safeCardTitle(s) {
    var t = String((s && s.title) || '').replace(/\s+/g, ' ').trim();
    if (s && s.type === 'news') return t;
    if (!t || CARD_FILE_RE.test(t)) t = 'Documento del acervo BCS 2050 — ' + ((s && s.theme_label) || 'acervo de datos');
    return t;
  }
  function catalogQuery(s) {
    return encodeURIComponent(((s && s.path) || '').split('/').pop() || safeCardTitle(s));
  }

  function appendSourcesDeemph(div, sources) {
    if (!sources || !sources.length) return;
    var wrap = el('div', 'bcs-chat-sources bcs-chat-sources-deemph');
    var seen = {};
    var unique = [];
    var ordered = sources.filter(function (s) { return s && s.drive_url; })
      .concat(sources.filter(function (s) { return s && !s.drive_url; }));
    ordered.forEach(function (s) {
      var title = safeCardTitle(s);
      var key = title.toLowerCase();
      var base = ((s.path || title).split('/').pop() || '').toLowerCase();
      if (/08_fp_team_research/i.test(s.path || '') || /08_fp_team_research/i.test(s.drive_url || '')) return;
      if (seen[key] || seen[base]) return;
      seen[key] = true;
      if (base) seen[base] = true;
      unique.push(s);
    });
    unique.slice(0, 4).forEach(function (s) {
      var a = el('a', 'bcs-chat-chip');
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.textContent = safeCardTitle(s);
      if (s.type === 'news') {
        // Press source card: "Noticia · outlet · date — headline" (never presented as official data)
        var en = (document.documentElement.getAttribute('data-lang') || 'es') === 'en';
        a.className = 'bcs-chat-chip bcs-chat-chip--news';
        a.textContent = '';
        var badge = el('span', 'bcs-chat-news-badge', en ? (s.label_en || 'News') : (s.label || 'Noticia'));
        var meta = [s.outlet, en ? (s.date_label_en || s.date) : (s.date_label_es || s.date)].filter(Boolean).join(' · ');
        var head = String(s.title || '').replace(/^Noticia(\s+sin\s+resumen)?\s*\([^)]*\):\s*/, '');
        a.appendChild(badge);
        a.appendChild(document.createTextNode(' ' + meta + (head ? ' — ' + head : '')));
        a.title = (en ? 'Press report (not official data): ' : 'Nota de prensa (no es dato oficial): ') + meta + (head ? ' — ' + head : '');
        if (s.url || (s.href && /^https?:\/\//.test(s.href))) a.href = s.url || s.href;
        wrap.appendChild(a);
        return;
      }
      if (s.drive_url) {
        a.href = s.drive_url;
      } else if (s.href && (/^https?:\/\//.test(s.href) || s.href.charAt(0) === '/')) {
        a.href = s.href;
      } else {
        a.href = '/catalogo?q=' + catalogQuery(s);
      }
      wrap.appendChild(a);
    });
    if (wrap.childNodes.length) div.appendChild(wrap);
  }

  function addBubble(role, text, payload) {
    var hint = msgs.querySelector('.bcs-chat-hint');
    if (hint) hint.remove();
    var sugg = msgs.querySelector('.bcs-chat-sugg');
    if (sugg) sugg.remove();
    var wel = msgs.querySelector('.bcs-chat-welcome');
    if (wel) wel.remove();
    root.classList.add('has-msgs');
    var isRich = role.indexOf('bot') === 0 && role.indexOf('thinking') < 0 && window.BCSChatRender;
    var div = el('div', 'bcs-chat-bubble ' + role, isRich ? null : text);
    if (isRich) {
      div.classList.add('rich');
      try { div.appendChild(window.BCSChatRender.renderMarkdown(text)); } catch (e) { div.textContent = text; }
      try {
        var rb = payload && payload.blocks && window.BCSChatRender.renderBlocks(payload.blocks, document.documentElement.getAttribute('data-lang') || 'es');
        if (rb) div.appendChild(rb);
      } catch (e) {}
      try {
        var fus = payload && Array.isArray(payload.followUps) ? payload.followUps.slice(0, 3) : [];
        if (fus.length) {
          msgs.querySelectorAll('.bcs-fu').forEach(function (n) { n.classList.add('bcs-fu-old'); });
          var fu = el('div', 'bcs-fu');
          var enL = (document.documentElement.getAttribute('data-lang') || 'es') === 'en';
          fu.appendChild(el('span', 'bcs-fu-label', enL ? 'Keep exploring' : 'Sigue explorando'));
          fus.forEach(function (q) {
            var b = el('button', 'bcs-fu-chip', String(q));
            b.type = 'button';
            b.addEventListener('click', function () { if (!input || !form) return; input.value = String(q).slice(0, 2000); if (form.requestSubmit) form.requestSubmit(); else form.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true })); });
            fu.appendChild(b);
          });
          div.appendChild(fu);
        }
      } catch (e) {}
    }
    if (role.indexOf('bot') === 0 && role.indexOf('thinking') < 0 && payload && !Array.isArray(payload)) {
      appendChainLinks(div, payload);
      appendSourcesDeemph(div, payload.sources);
    } else if (role.indexOf('bot') === 0 && role.indexOf('thinking') < 0 && Array.isArray(payload)) {
      // legacy: sources array only
      appendChainLinks(div, { primary_file: null, ontology: [], stakeholder: null, place: null, foresight_signals: [] });
      appendSourcesDeemph(div, payload);
    }
    msgs.appendChild(div);
    msgs.scrollTop = msgs.scrollHeight;
    return div;
  }

  /* —— Voice conversation (xAI Grok realtime) —— */
  var micBtn = document.getElementById('bcs-chat-mic');
  var speakBtn = document.getElementById('bcs-chat-speak');
  var voiceStatus = document.getElementById('bcs-chat-voice-status');
  var grokVoice = null;
  var conversationMode = false;
  var lastSpokenText = '';
  var voiceSupported = !!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia && window.WebSocket && (window.AudioContext || window.webkitAudioContext));

  function setVoiceState(state) {
    root.setAttribute('data-voice', state || '');
    if (!voiceStatus) return;
    if (!state) {
      voiceStatus.hidden = true;
      voiceStatus.textContent = '';
      return;
    }
    var map = {
      connecting: 'chatVoiceConnecting',
      listening: 'chatVoiceListening',
      speaking: 'chatVoiceSpeaking',
      processing: 'chatMicProcessing',
      error: 'chatVoiceError',
      unsupported: 'chatMicUnsupported'
    };
    var key = map[state] || '';
    voiceStatus.textContent = key ? t(key) : '';
    voiceStatus.hidden = !voiceStatus.textContent;
  }

  function syncVoiceChrome() {
    if (micBtn) {
      var mKey = conversationMode ? 'chatMicStop' : 'chatMic';
      micBtn.setAttribute('aria-label', t(mKey));
      micBtn.setAttribute('title', t(mKey));
      micBtn.setAttribute('aria-pressed', conversationMode ? 'true' : 'false');
      var ml = micBtn.querySelector('.bcs-chat-mic-label');
      if (ml) ml.textContent = t(mKey);
    }
    if (speakBtn) {
      /* Grok plays audio natively; keep Escuchar as replay of last assistant text via browser TTS only if available */
      var speaking = root.getAttribute('data-voice') === 'speaking';
      var sKey = speaking ? 'chatSpeakStop' : 'chatSpeak';
      speakBtn.setAttribute('aria-label', t(sKey));
      speakBtn.setAttribute('title', t(sKey));
      speakBtn.setAttribute('aria-pressed', speaking ? 'true' : 'false');
      var sl = speakBtn.querySelector('.bcs-chat-speak-label');
      if (sl) sl.textContent = t(sKey);
      speakBtn.disabled = !lastSpokenText && !speaking;
    }
  }

  function showVoiceError(code) {
    var key = 'chatVoiceError';
    if (code === 'voice_not_configured') key = 'chatVoiceNotConfigured';
    else if (code === 'voice_unauthorized') key = 'chatVoiceUnauthorized';
    if (voiceStatus) {
      voiceStatus.textContent = t(key);
      voiceStatus.hidden = false;
    }
    root.setAttribute('data-voice', 'error');
    syncVoiceChrome();
  }

  function stopConversation() {
    conversationMode = false;
    if (grokVoice) {
      try { grokVoice.stop(); } catch (e) {}
    }
    setVoiceState('');
    if (micBtn) micBtn.setAttribute('aria-pressed', 'false');
    syncVoiceChrome();
  }

  function ensureGrok() {
    if (grokVoice) return grokVoice;
    if (!window.BcsGrokVoice) return null;
    grokVoice = new window.BcsGrokVoice({
      onState: function (state) {
        if (!conversationMode && state) return;
        setVoiceState(state || '');
        syncVoiceChrome();
      },
      onTranscript: function (role, text) {
        var clean = String(text || '').trim();
        if (!clean) return;
        if (role === 'user') {
          addBubble('user', clean);
          history.push({ role: 'user', content: clean });
        } else {
          addBubble('bot', clean, {
            primary_file: null,
            ontology: [],
            stakeholder: null,
            sources: [],
            place: (window.BCSPlace && window.BCSPlace.get && window.BCSPlace.get()) ? { id: window.BCSPlace.get() } : null,
            foresight_signals: [],
            strategic_questions: []
          });
          history.push({ role: 'assistant', content: clean });
          lastSpokenText = clean;
          syncVoiceChrome();
        }
      },
      onError: function (code) {
        showVoiceError(code);
      }
    });
    return grokVoice;
  }

  async function startConversation() {
    if (!voiceSupported || !window.BcsGrokVoice) {
      setVoiceState('unsupported');
      syncVoiceChrome();
      return;
    }
    conversationMode = true;
    syncVoiceChrome();
    setVoiceState('connecting');
    var gv = ensureGrok();
    try {
      await gv.start();
    } catch (e) {
      conversationMode = false;
      var code = (e && e.message) || 'voice_token_failed';
      showVoiceError(code);
      syncVoiceChrome();
    }
  }

  function toggleConversation() {
    if (conversationMode) stopConversation();
    else startConversation();
  }

  if (micBtn) {
    if (!voiceSupported) {
      micBtn.disabled = true;
      micBtn.setAttribute('title', t('chatMicUnsupported'));
      micBtn.setAttribute('aria-label', t('chatMicUnsupported'));
      setVoiceState('unsupported');
    } else {
      micBtn.addEventListener('click', function (e) {
        e.preventDefault();
        toggleConversation();
      });
    }
  }

  if (speakBtn) {
    /* Optional: stop Grok playback barge by stopping session audio only via Parar; mute button stops conversation audio by stopping voice */
    speakBtn.addEventListener('click', function () {
      if (root.getAttribute('data-voice') === 'speaking' && conversationMode) {
        /* cannot surgically mute Grok stream easily — user should tap Parar */
        return;
      }
      if (!lastSpokenText || !window.speechSynthesis) return;
      try {
        window.speechSynthesis.cancel();
        var u = new SpeechSynthesisUtterance(lastSpokenText);
        u.lang = (document.documentElement.getAttribute('data-lang') || 'es') === 'en' ? 'en-US' : 'es-MX';
        window.speechSynthesis.speak(u);
      } catch (e) {}
    });
  }

  document.addEventListener('bcs:lang', function () {
    syncVoiceChrome();
    if (conversationMode && root.getAttribute('data-voice') === 'listening') {
      setVoiceState('listening');
    }
  });

  form && form.addEventListener('submit', function (e) {
    e.preventDefault();
    var message = (input.value || '').trim();
    if (!message) return;
    /* Typed chat stays independent of Grok voice session */
    input.value = '';
    addBubble('user', message);
    history.push({ role: 'user', content: message });
    var thinking = addBubble('bot thinking', t('chatThinking'));
    var sendBtn = form.querySelector('.bcs-chat-send');
    if (sendBtn) sendBtn.disabled = true;

    var lang = document.documentElement.getAttribute('data-lang') || 'es';
    fetch('/api/chat', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        message: message,
        lang: lang,
        history: history.slice(-6),
        place: (window.BCSPlace && window.BCSPlace.get && window.BCSPlace.get()) || null,
        session: chatSessionId()
      })
    })
      .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (res) {
        thinking.remove();
        var j = res.j || {};
        var answer = j.answer || t('chatError');
        var bubble = addBubble('bot', answer, {
          primary_file: j.primary_file || null,
          ontology: j.ontology || [],
          stakeholder: j.stakeholder || null,
          sources: j.sources || [],
          place: j.place || ((window.BCSPlace && window.BCSPlace.get && window.BCSPlace.get()) ? { id: window.BCSPlace.get() } : null),
          foresight_signals: j.foresight_signals || (j.foresight_signal ? [j.foresight_signal] : []),
          strategic_questions: j.strategic_questions || [],
          blocks: Array.isArray(j.blocks) ? j.blocks : [],
          followUps: Array.isArray(j.followUps) && j.followUps.length ? j.followUps : (lang === 'en'
            ? ['How many people live in each municipality?', 'Which protected natural areas are in Baja California Sur?']
            : ['¿Cuántas personas viven en cada municipio?', '¿Qué áreas naturales protegidas hay en Baja California Sur?'])
        });
        try {
          var acts = j.actions || {};
          if (bubble && acts) {
            var wrap = el('div', 'bcs-chat-actions');
            wrap.appendChild(el('div', 'bcs-chat-link-label', lang === 'en' ? 'Actions' : 'Acciones'));
            var row = el('div', 'bcs-chat-link-row');
            function act(label, href) {
              if (!href) return;
              var a = el('a', 'bcs-chat-chip', label);
              a.href = href;
              row.appendChild(a);
            }
            act(lang === 'en' ? 'Studio' : 'Studio', acts.open_lugares);
            act(lang === 'en' ? 'Growth' : 'Crecimiento', acts.open_crecimiento);
            act(lang === 'en' ? 'Map' : 'Mapa', acts.open_map);
            act(lang === 'en' ? 'Compare places' : 'Comparar lugares', acts.compare_places);
            act(lang === 'en' ? 'Strategic Q' : 'Pregunta', acts.create_strategic_question);
            act(lang === 'en' ? 'Missing evidence' : 'Evidencia faltante', acts.request_missing_evidence);
            act(lang === 'en' ? 'Session' : 'Sesión', acts.strategy_session);
            wrap.appendChild(row);
            bubble.appendChild(wrap);
          }
        } catch (e) {}
        try {
          // Hook for pages that extend the chat (e.g. /explorar adds map "Localizar" chips). No effect elsewhere.
          document.dispatchEvent(new CustomEvent('bcs:chat-answer', { detail: { answer: answer, bubble: bubble, sources: j.sources || [], grounded: j.grounded, question: message } }));
        } catch (e) {}
        history.push({ role: 'assistant', content: answer });
        lastSpokenText = String(answer || '').replace(/\s+/g, ' ').trim().slice(0, 1200);
        syncVoiceChrome();
      })
      .catch(function () {
        thinking.remove();
        addBubble('bot', t('chatError'), {
          primary_file: null,
          ontology: [],
          stakeholder: null,
          sources: []
        });
      })
      .finally(function () {
        if (sendBtn) sendBtn.disabled = false;
      });
  });

  // Small public API so a page can dock the chat and prefill a question (used by /explorar).
  window.BCSChat = {
    root: root,
    open: function () { setOpen(true, getSheet()); rememberDock(true); },
    close: function () { setOpen(false); rememberDock(false); },
    prefill: function (text) { if (input) { input.value = String(text || '').slice(0, 2000); try { input.focus(); input.setSelectionRange(input.value.length, input.value.length); } catch (e) {} } },
    send: function (text) { if (!input || !form) return; input.value = String(text || '').slice(0, 2000); form.requestSubmit(); }
  };

  input && input.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      form.requestSubmit();
    }
  });

  document.getElementById('lang-toggle') && document.getElementById('lang-toggle').addEventListener('click', function () {
    setTimeout(function () {
      syncPlaceholders();
      syncVoiceChrome();
    }, 50);
  });

  var hl = document.getElementById('bcs-chat-home-lang');
  hl && hl.addEventListener('click', function () { var lt = document.getElementById('lang-toggle'); if (lt) lt.click(); });
  if (CHAT_HOME && input) setTimeout(function () { try { input.focus(); } catch (e) {} }, 100);

  syncVoiceChrome();
})();
</script>
