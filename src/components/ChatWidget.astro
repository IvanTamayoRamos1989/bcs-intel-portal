---
import { ui } from '../i18n/ui';
import PlaceStrip from './PlaceStrip.astro';
const { home = false } = Astro.props;
---
<aside id="bcs-chat" class="bcs-chat" data-open="false" aria-label={ui.es.chatTitle}>
  <div class="bcs-chat-backdrop" id="bcs-chat-backdrop" hidden></div>
  <button type="button" class="bcs-chat-tab" id="bcs-chat-open" aria-expanded="false" aria-controls="bcs-chat-panel">
    <span class="bcs-chat-tab-label" data-i18n="chatOpen">{ui.es.chatOpen}</span>
  </button>

  <div class="bcs-chat-panel" id="bcs-chat-panel" role="complementary" aria-label={ui.es.chatTitle}>
    <header class="bcs-chat-head">
      <div class="bcs-chat-head-text">
        <strong data-i18n="chatTitle">{ui.es.chatTitle}</strong>
        <span class="bcs-chat-sub" data-i18n="chatSubtitle">{ui.es.chatSubtitle}</span>
      </div>
      {home && (
        <div class="bcs-chat-home-tools">
          <button type="button" class="bcs-chat-home-btn" id="bcs-chat-home-lang"><span data-lang-es>English</span><span data-lang-en hidden>Español</span></button>
          <a class="bcs-chat-home-btn" href="/portal"><span data-lang-es>Resto del portal →</span><span data-lang-en hidden>Rest of the portal →</span></a>
        </div>
      )}
      <div class="bcs-chat-head-actions">
        <div class="bcs-chat-sheet-controls" id="bcs-chat-sheet-controls" hidden>
          <button type="button" class="bcs-chat-sheet-btn" data-sheet="partial" aria-pressed="true" title="Vista parcial">
            <span aria-hidden="true">▭</span>
            <span class="sr-only">Vista parcial</span>
          </button>
          <button type="button" class="bcs-chat-sheet-btn" data-sheet="full" aria-pressed="false" title="Pantalla completa">
            <span aria-hidden="true">▣</span>
            <span class="sr-only">Pantalla completa</span>
          </button>
        </div>
        <button type="button" class="bcs-chat-x" id="bcs-chat-close" aria-label={ui.es.chatClose}>
          <span data-i18n="chatClose">{ui.es.chatClose}</span>
        </button>
      </div>
    </header>
    <PlaceStrip compact={true} class="bcs-chat-place-strip" />
    <div class="bcs-chat-msgs" id="bcs-chat-msgs" aria-live="polite">
      {home && (
        <div class="bcs-chat-welcome">
          <h1 class="bcs-chat-welcome-t">BCS 2050</h1>
          <p class="bcs-chat-welcome-p"><span data-lang-es>Conversa con los datos públicos del estado.</span><span data-lang-en hidden>Talk with the state's public data.</span></p>
          <ul class="bcs-fx-stats" aria-label="Contenido del portal">
            <li><span data-lang-es>municipios</span><span data-lang-en hidden>municipalities</span></li>
            <li><span data-lang-es>mapas oficiales</span><span data-lang-en hidden>official maps</span></li>
            <li><span data-lang-es>fotos aéreas</span><span data-lang-en hidden>aerial photos</span></li>
          </ul>
        </div>
      )}
      <p class="bcs-chat-hint" data-i18n="chatEmpty">{ui.es.chatEmpty}</p>
      <div class="bcs-chat-sugg" id="bcs-chat-sugg" aria-label="Preguntas sugeridas" data-aria-es="Preguntas sugeridas" data-aria-en="Suggested questions">
        <p class="bcs-chat-sugg-title"><span data-lang-es>Empieza a explorar</span><span data-lang-en hidden>Start exploring</span></p>
        <button type="button" class="bcs-chat-sugg-btn" data-q-es="¿Cuánta agua hay disponible en mi municipio?" data-q-en="How much water is available in my municipality?"><img class="bcs-sugg-th" src="/maps/dma-la-paz-localizacion.jpg" alt="" loading="lazy" onerror="this.remove()"><span class="bcs-sugg-k"><span data-lang-es>Agua</span><span data-lang-en hidden>Water</span></span><span class="bcs-sugg-q"><span data-lang-es>¿Cuánta agua hay disponible en mi municipio?</span><span data-lang-en hidden>How much water is available in my municipality?</span></span></button>
        <button type="button" class="bcs-chat-sugg-btn" data-q-es="¿Qué áreas naturales protegidas hay en Baja California Sur?" data-q-en="Which protected natural areas are in Baja California Sur?"><img class="bcs-sugg-th" src="/maps/poer-ugas-56.jpg" alt="" loading="lazy" onerror="this.remove()"><span class="bcs-sugg-k"><span data-lang-es>Medio ambiente</span><span data-lang-en hidden>Environment</span></span><span class="bcs-sugg-q"><span data-lang-es>¿Qué áreas naturales protegidas hay en Baja California Sur?</span><span data-lang-en hidden>Which protected natural areas are in Baja California Sur?</span></span></button>
        <button type="button" class="bcs-chat-sugg-btn" data-q-es="¿Qué proyectos federales hay en Los Cabos?" data-q-en="Which federal projects are in Los Cabos?"><img class="bcs-sugg-th" src="/stills/batch_01/thumbs/S0005_san_jose_del_cabo.jpg" alt="" loading="lazy" onerror="this.remove()"><span class="bcs-sugg-k"><span data-lang-es>Inversión</span><span data-lang-en hidden>Investment</span></span><span class="bcs-sugg-q"><span data-lang-es>¿Qué proyectos federales hay en Los Cabos?</span><span data-lang-en hidden>Which federal projects are in Los Cabos?</span></span></button>
        <button type="button" class="bcs-chat-sugg-btn" data-q-es="¿De dónde viene la electricidad del estado?" data-q-en="Where does the state's electricity come from?"><img class="bcs-sugg-th" src="/maps/cenace-red-troncal-transmision.jpg" alt="" loading="lazy" onerror="this.remove()"><span class="bcs-sugg-k"><span data-lang-es>Energía</span><span data-lang-en hidden>Energy</span></span><span class="bcs-sugg-q"><span data-lang-es>¿De dónde viene la electricidad del estado?</span><span data-lang-en hidden>Where does the state's electricity come from?</span></span></button>
        <button type="button" class="bcs-chat-sugg-btn" data-q-es="¿Qué plan urbano aplica en La Paz?" data-q-en="Which urban plan applies in La Paz?"><img class="bcs-sugg-th" src="/maps/psdu-todos-santos-zonificacion.jpg" alt="" loading="lazy" onerror="this.remove()"><span class="bcs-sugg-k"><span data-lang-es>Ciudad</span><span data-lang-en hidden>City</span></span><span class="bcs-sugg-q"><span data-lang-es>¿Qué plan urbano aplica en La Paz?</span><span data-lang-en hidden>Which urban plan applies in La Paz?</span></span></button>
        <button type="button" class="bcs-chat-sugg-btn" data-q-es="¿Cuántas personas viven en cada municipio?" data-q-en="How many people live in each municipality?"><img class="bcs-sugg-th" src="/stills/batch_01/thumbs/S0004_la_paz.jpg" alt="" loading="lazy" onerror="this.remove()"><span class="bcs-sugg-k"><span data-lang-es>Población</span><span data-lang-en hidden>Population</span></span><span class="bcs-sugg-q"><span data-lang-es>¿Cuántas personas viven en cada municipio?</span><span data-lang-en hidden>How many people live in each municipality?</span></span></button>
        <button type="button" class="bcs-chat-sugg-btn" data-q-es="¿Qué puedo aprender de otras ciudades sobre agua, vivienda o movilidad, y dónde veo los datos de BCS?" data-q-en="What can I learn from other cities about water, housing or mobility, and where are the BCS figures?"><span class="bcs-sugg-k"><span data-lang-es>Otras ciudades</span><span data-lang-en hidden>Other cities</span></span><span class="bcs-sugg-q"><span data-lang-es>¿Qué puedo aprender de otras ciudades?</span><span data-lang-en hidden>What can I learn from other cities?</span></span></button>
        {home && (
          <div class="bcs-chat-path" aria-label="Para la consulta" data-aria-es="Para la consulta" data-aria-en="For the consultation">
            <p class="bcs-chat-spec-title"><span data-lang-es>Para la consulta</span><span data-lang-en hidden>For the consultation</span></p>
            <div class="bcs-chat-path-row">
              <a class="bcs-chat-path-card" href="/aprendizaje/#evidencia">
                <strong><span data-lang-es>Evidencia</span><span data-lang-en hidden>Evidence</span></strong>
                <span><span data-lang-es>Casos de otras ciudades sobre agua y costa. Esas cifras no son de Baja California Sur.</span><span data-lang-en hidden>Cases from other cities on water and the coast. Those figures are not for Baja California Sur.</span></span>
              </a>
              <a class="bcs-chat-path-card" href="/vistas/">
                <strong><span data-lang-es>Vistas</span><span data-lang-en hidden>Views</span></strong>
                <span><span data-lang-es>Cinco mapas con nombre: agua, corredor, puertos, vivienda y East Cape.</span><span data-lang-en hidden>Five named maps: water, the corridor, ports, housing and East Cape.</span></span>
              </a>
              <a class="bcs-chat-path-card" href="/foro/#recorrido">
                <strong><span data-lang-es>Recorrido</span><span data-lang-en hidden>Walk</span></strong>
                <span><span data-lang-es>El orden de diez minutos para seguir la reunión.</span><span data-lang-en hidden>The ten-minute order for following the meeting.</span></span>
              </a>
              <div class="bcs-chat-path-card bcs-chat-decide">
                <strong><span data-lang-es>Antes de decidir</span><span data-lang-en hidden>Before you decide</span></strong>
                <span class="bcs-chat-decide-path">
                  <a href="/vistas/"><span data-lang-es>Vistas</span><span data-lang-en hidden>Views</span></a>
                  <span aria-hidden="true"> → </span>
                  <a href="/gemelo/?path=diagnostico"><span data-lang-es>Gemelo</span><span data-lang-en hidden>Twin</span></a>
                  <span aria-hidden="true"> → </span>
                  <a href="/metas/"><span data-lang-es>Preguntas abiertas</span><span data-lang-en hidden>Open questions</span></a>
                  <span aria-hidden="true"> → </span>
                  <a href="/aprendizaje/#evidencia"><span data-lang-es>Evidencia</span><span data-lang-en hidden>Evidence</span></a>
                  <span aria-hidden="true"> · </span>
                  <a href="/gemelo/?path=recomendacion"><span data-lang-es>Recomendación</span><span data-lang-en hidden>Recommendation</span></a>
                </span>
              </div>
            </div>
          </div>
        )}
        {home && (
          <div class="bcs-chat-spec" aria-label="Para especialistas" data-aria-es="Para especialistas" data-aria-en="For specialists">
            <p class="bcs-chat-spec-title"><span data-lang-es>Para especialistas</span><span data-lang-en hidden>For specialists</span></p>
            <div class="bcs-chat-spec-row">
              <a class="bcs-chat-spec-link" href="/gemelo/"><span data-lang-es>Gemelo</span><span data-lang-en hidden>Twin</span></a>
              <a class="bcs-chat-spec-link" href="/vistas/"><span data-lang-es>Vistas</span><span data-lang-en hidden>Views</span></a>
              <a class="bcs-chat-spec-link" href="/metas/"><span data-lang-es>Metas</span><span data-lang-en hidden>Questions</span></a>
              <a class="bcs-chat-spec-link" href="/coordinacion/"><span data-lang-es>Coordinación</span><span data-lang-en hidden>Coordination</span></a>
              <a class="bcs-chat-spec-link" href="/aprendizaje/"><span data-lang-es>Aprendizaje</span><span data-lang-en hidden>Learning</span></a>
              <a class="bcs-chat-spec-link" href="/foro/"><span data-lang-es>Foro</span><span data-lang-en hidden>Guests</span></a>
            </div>
          </div>
        )}
      </div>
    </div>
    <form class="bcs-chat-form" id="bcs-chat-form">
      <label class="sr-only" for="bcs-chat-input" data-i18n="chatPlaceholder">{ui.es.chatPlaceholder}</label>
      <textarea id="bcs-chat-input" rows="2" data-i18n-placeholder="chatPlaceholder" placeholder={ui.es.chatPlaceholder} maxlength="2000" required></textarea>
      <div class="bcs-chat-controls">
        <button type="button" class="bcs-chat-mic" id="bcs-chat-mic" data-i18n-aria="chatMic" aria-label={ui.es.chatMic} aria-pressed="false" title={ui.es.chatMic}>
          <span class="bcs-chat-mic-icon" aria-hidden="true">🎤</span>
          <span class="bcs-chat-mic-label" data-i18n="chatMic">{ui.es.chatMic}</span>
        </button>
        <button type="button" class="bcs-chat-speak" id="bcs-chat-speak" data-i18n-aria="chatSpeak" aria-label={ui.es.chatSpeak} aria-pressed="false" title={ui.es.chatSpeak} disabled>
          <span class="bcs-chat-speak-icon" aria-hidden="true">🔊</span>
          <span class="bcs-chat-speak-label" data-i18n="chatSpeak">{ui.es.chatSpeak}</span>
        </button>
        <button type="submit" class="bcs-chat-send" data-i18n="chatSend">{ui.es.chatSend}</button>
      </div>
      <p class="bcs-chat-voice-hint" data-i18n="chatVoiceHint">{ui.es.chatVoiceHint}</p>
      <p class="bcs-chat-voice-status" id="bcs-chat-voice-status" hidden aria-live="polite"></p>
    </form>
  </div>
</aside>

<script is:inline>
  document.addEventListener('click', function (e) {
    var b = e.target && e.target.closest && e.target.closest('.bcs-chat-sugg-btn');
    if (!b) return;
    var en = (document.documentElement.getAttribute('data-lang') || document.documentElement.lang) === 'en';
    var input = document.getElementById('bcs-chat-input');
    var form = document.getElementById('bcs-chat-form');
    if (!input || !form) return;
    input.value = en ? b.getAttribute('data-q-en') : b.getAttribute('data-q-es');
    var box = document.getElementById('bcs-chat-sugg'); if (box) box.hidden = true;
    if (form.requestSubmit) form.requestSubmit(); else form.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
  });
</script>

<style is:global>
  .bcs-chat-sugg { display: flex; flex-direction: column; gap: 6px; margin: 4px 0 10px; }
  .bcs-chat-sugg-title { margin: 0 0 2px; font-size: .8rem; color: #5c6e7b; }
  .bcs-chat-path, .bcs-chat-spec { grid-column: 1 / -1; }
  .bcs-chat-path { display: flex; flex-direction: column; gap: .4rem; margin-top: .55rem; }
  .bcs-chat-path-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .45rem; }
  .bcs-chat-path-card { display: flex; flex-direction: column; gap: .2rem; text-decoration: none; background: #fff; color: #1a2b38; border: 1px solid #e2dccf; border-radius: 12px; padding: .55rem .7rem; }
  .bcs-chat-path-card strong { color: #006BA3; font-size: .86rem; }
  .bcs-chat-path-card span { font-size: .78rem; line-height: 1.35; font-weight: 450; }
  .bcs-chat-path-card:focus-visible { outline: 3px solid #006BA3; outline-offset: 3px; }
  .bcs-chat-decide { grid-column: 1 / -1; }
  .bcs-chat-decide-path { display: flex; flex-wrap: wrap; gap: .15rem .35rem; align-items: baseline; }
  .bcs-chat-decide-path a { color: #006BA3; font-weight: 700; }
  @media (max-width: 720px) { .bcs-chat-path-row { grid-template-columns: 1fr; } }
  .bcs-chat-spec { display: flex; flex-direction: column; align-items: center; gap: .35rem; margin-top: .45rem; padding-top: .55rem; border-top: 1px solid rgba(0, 131, 196, .28); }
  .bcs-chat-spec-title { margin: 0; font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #006BA3; }
  .bcs-chat-spec-row { display: flex; flex-wrap: wrap; justify-content: center; gap: .35rem; }
  .bcs-chat-spec-link { font-size: .78rem; font-weight: 700; line-height: 1.2; padding: .28rem .65rem; border-radius: 999px; border: 1px solid #0083C4; background: #e8f4fb; color: #006BA3; text-decoration: none; }
  .bcs-chat-spec-link:hover { background: #0083C4; color: #fff; }
  .bcs-chat-spec-link:focus-visible { background: #0083C4; color: #fff; outline: 3px solid #006BA3; outline-offset: 3px; }
  .bcs-chat-sugg-btn { text-align: left; font: inherit; font-size: .84rem; line-height: 1.35; padding: 7px 10px; border-radius: 10px; border: 1px solid #e2dccf; background: #fbf8f1; color: #23374a; cursor: pointer; }
  .bcs-chat-sugg-btn:hover, .bcs-chat-sugg-btn:focus-visible { border-color: #34607d; background: #eef3f6; }
  .bcs-chat {
    --bcs-chat-w: 440px;
    position: fixed;
    z-index: 80;
    top: 0;
    right: 0;
    bottom: 0;
    width: var(--bcs-chat-w);
    font-family: var(--font);
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }
  .bcs-chat > * { pointer-events: auto; }

  .bcs-chat-tab {
    display: none;
    position: fixed;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 81;
    writing-mode: vertical-rl;
    text-orientation: mixed;
    background: var(--fp-blue);
    color: #fbf8f1;
    border: none;
    border-radius: 10px 0 0 10px;
    padding: 0.85rem 0.45rem;
    font-weight: 600;
    font-size: 0.82rem;
    cursor: pointer;
    box-shadow: -2px 4px 14px rgba(0, 128, 192, 0.28);
    letter-spacing: 0.04em;
  }
  .bcs-chat-tab:hover { background: var(--fp-blue-dark); }

  .bcs-chat-panel {
    width: 100%;
    height: 100%;
    background: var(--surface);
    border-left: 1px solid var(--border);
    box-shadow: -4px 0 24px rgba(35, 55, 74,0.06);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .bcs-chat-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.85rem 0.9rem 0.55rem;
    background: var(--ios-surface, var(--surface, #fbf8f1));
    color: var(--ios-text, var(--text, #23374a));
    border-bottom: 1px solid var(--ios-separator, rgba(60,60,67,0.12));
    flex-shrink: 0;
  }
  .bcs-chat-head strong { color: var(--ios-text, #23374a); }
  .bcs-chat-sub { color: var(--ios-secondary, #5c6e7b) !important; opacity: 1 !important; }
  /* iOS chat scope strip */
  .bcs-chat-place-strip.bcs-place-strip,
  .bcs-chat .bcs-place-strip--compact {
    background: var(--ios-surface, #fbf8f1) !important;
    border-bottom: 1px solid var(--ios-separator, rgba(60,60,67,0.12)) !important;
  }
  .bcs-chat .bcs-ps-label { color: var(--ios-secondary, #5c6e7b) !important; }

  .bcs-chat-x {
    color: var(--ios-accent, #34607d) !important;
    background: var(--ios-fill, rgba(120,120,128,0.12)) !important;
    border: 0 !important;
    border-radius: 980px !important;
    min-height: 32px;
    padding: 0.25rem 0.7rem !important;
    font-weight: 600;
  }
  .bcs-chat-head-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  /* iOS chat head text fix */
  .bcs-chat-head,
  .bcs-chat-head strong,
  .bcs-chat-head-text {
    color: var(--ios-text, #23374a);
  }
  .bcs-chat-sub {
    color: var(--ios-secondary, #5c6e7b) !important;
    opacity: 1 !important;
  }

  .bcs-chat-head strong {
    font-size: 0.98rem;
    line-height: 1.25;
  }
  .bcs-chat-sub {
    font-size: 0.72rem;
    opacity: 0.88;
    font-weight: 400;
    line-height: 1.35;
  }
  .bcs-chat-x {
    background: transparent;
    border: 1px solid rgba(255,255,255,0.45);
    color: #fbf8f1;
    border-radius: 8px;
    padding: 0.25rem 0.5rem;
    font-size: 0.72rem;
    cursor: pointer;
    flex-shrink: 0;
    display: none; /* desktop always open */
  }
  .bcs-chat-msgs {
    flex: 1;
    overflow-y: auto;
    padding: 0.85rem;
    background: var(--bg);
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    min-height: 0;
  }
  .bcs-chat-hint {
    margin: 0;
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.45;
  }
  .bcs-chat-bubble {
    max-width: 100%;
    padding: 0.6rem 0.7rem;
    border-radius: 12px;
    font-size: 0.86rem;
    line-height: 1.5;
    white-space: pre-wrap;
  }
  .bcs-chat-bubble.user {
    align-self: flex-end;
    background: var(--fp-blue-soft);
    color: var(--text);
  }
  .bcs-chat-bubble.bot {
    align-self: flex-start;
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .bcs-chat-bubble.thinking { color: var(--muted); font-style: italic; }
  .bcs-chat-sources {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.45rem;
  }
  .bcs-chat-chip {
    display: inline-block;
    font-size: 0.7rem;
    line-height: 1.2;
    padding: 0.22rem 0.45rem;
    border-radius: 999px;
    background: #dfe8ee;
    color: var(--fp-blue-dark);
    text-decoration: none;
    border: 1px solid var(--fp-blue-soft);
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bcs-chat-chip:hover { background: var(--fp-blue); color: #fbf8f1; }
  .bcs-chat-chip--news {
    background: #fff8e6;
    color: #6b4e00;
    border-color: #f0d48a;
    border-radius: 8px;
    max-width: 100%;
  }
  .bcs-chat-chip--news:hover { background: #fdecc0; color: #4a3600; }
  .bcs-chat-news-badge {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 0.62rem;
    margin-right: 0.15rem;
  }
  .bcs-chat-links {
    margin-top: 0.55rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    border-top: 1px solid var(--border);
    padding-top: 0.5rem;
  }
  .bcs-chat-link-block {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .bcs-chat-link-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .bcs-chat-link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    align-items: center;
  }
  .bcs-chat-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.72rem;
    line-height: 1.25;
    padding: 0.28rem 0.55rem;
    border-radius: 8px;
    background: var(--fp-blue);
    color: #fbf8f1;
    text-decoration: none;
    font-weight: 600;
    border: none;
    max-width: 100%;
