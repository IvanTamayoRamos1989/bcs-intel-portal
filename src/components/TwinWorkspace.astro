---
import '../styles/global.css';
import ThreeNav from './ThreeNav.astro';
import { ui } from '../i18n/ui';
import { cdtModel } from '../lib/cdtModel';
import gisLayers from '../../public/gis/layers.json';

const titleEs = 'Mapa 3D';
const titleEn = '3D map';

type GisLayer = {
  id: string;
  url: string;
  type: string;
  color?: string;
  name_es: string;
  name_en: string;
};

const gisById = Object.fromEntries((gisLayers as GisLayer[]).map((l) => [l.id, l]));

function extraLayer(id: string) {
  const raw = gisById[id];
  if (!raw) throw new Error(`Shell stack layer missing from GIS catalog: ${id}`);
  return {
    id: raw.id,
    url: raw.url,
    type: raw.type,
    color: raw.color || '#0083C4',
    name_es: raw.name_es,
    name_en: raw.name_en,
    group: 'infra',
    source_es: 'OpenStreetMap',
    source_en: 'OpenStreetMap',
    year_es: 'año no registrado en el catálogo GIS',
    year_en: 'year not recorded in the GIS catalog',
  };
}

const catalogLayers = cdtModel.layerCatalog.map((l) => ({
  id: l.id,
  url: l.url,
  type: l.type,
  color: l.color,
  name_es: l.name_es,
  name_en: l.name_en,
  group: l.group,
  source_es: l.source_es,
  source_en: l.source_en,
  year_es: l.year_es,
  year_en: l.year_en,
}));
const catalogIds = new Set(catalogLayers.map((l) => l.id));
const stack = [
  { id: 'l0', layers: ['osm_towns', 'settlements'] },
  {
    id: 'l2',
    layers: [
      'osm_highways',
      'osm_power_lines',
      'osm_power_nodes',
      'osm_waterways',
      'focus_water_dmas',
      'focus_ports_air',
      'federal_projects',
      'poer_ugas',
      'anp_federales',
      'rtp_conabio',
    ],
  },
  { id: 'l3', layers: ['osm_transport_nodes', 'highway_nodes', 'focus_corridor_cabos_lapaz'] },
  { id: 'l4', layers: ['bcs_market_listings'] },
];
const extras = [...new Set(stack.flatMap((s) => s.layers))].filter((id) => !catalogIds.has(id)).map(extraLayer);
const shellLayers = [...catalogLayers, ...extras];
const layersById = Object.fromEntries(shellLayers.map((l) => [l.id, l]));
for (const group of stack) {
  for (const id of group.layers) {
    if (!layersById[id]) throw new Error(`Shell stack layer not resolvable: ${id}`);
  }
}
const munis = [...cdtModel.munis]
  .map((m) => ({ name: m.name, pob: m.pob, studio: m.studio }))
  .sort((a, b) => b.pob - a.pob);
const maxPob = munis[0]?.pob || 1;
const twinScenarios = ['baseline', 'corridor_intensify', 'water_first', 'ports_air_hubs']
  .map((id) => cdtModel.scenarios.find((s) => s.id === id))
  .filter((s): s is NonNullable<typeof s> => !!s);

const shellModel = {
  layers: shellLayers,
  themes: cdtModel.themes.map((t) => ({
    id: t.id,
    es: t.es,
    en: t.en,
    layers: t.layers,
  })),
  stack,
  defaults: ['osm_towns', 'osm_highways'],
  munis,
  scenarios: twinScenarios.map((s) => ({
    id: s.id,
    es: s.title_es,
    en: s.title_en,
    href: `/gemelo/?scenario=${s.id}`,
  })),
};
---
<!doctype html>
<html lang="es" data-lang="es" data-title-es={titleEs} data-title-en={titleEn} data-title-suffix=" · BCS 2050">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#fbf8f1" />
    <title data-title-es={titleEs} data-title-en={titleEn} data-title-suffix=" · BCS 2050">{titleEs} · BCS 2050</title>
    <link rel="stylesheet" href="/explorar/vendor/maplibre-gl.css" />
    <link rel="stylesheet" href="/vendor/leaflet/leaflet.css" />
    <script is:inline define:vars={{ uiObj: ui }}>
      window.__BCS_UI__ = uiObj;
    </script>
    <script is:inline src="/lang-toggle.js"></script>
    <script is:inline src="/auth-gate.js"></script>
    <script is:inline src="/place-strip.js" defer></script>
  </head>
  <body class="shell-app twin-workspace map-page" data-pane="map">
    <ThreeNav active="map" />
    <div class="shell">
      <section class="shell-map-wrap" aria-label="Mapa">
        <div id="shell-map"></div>
        <div class="twin-map-context"><span class="twin-eyebrow"><span data-lang-es>BAJA CALIFORNIA SUR</span><span data-lang-en hidden>CONTEXT MAP</span></span><p id="twin-map-summary" role="status"><span data-lang-es>Busca un lugar o activa una capa.</span><span data-lang-en hidden>Find a place or turn on a layer.</span></p><div class="map-search"><label for="map-place-search"><span data-lang-es>Buscar un lugar</span><span data-lang-en hidden>Find a place</span></label><input id="map-place-search" type="search" placeholder="La Paz, Loreto, Todos Santos…" autocomplete="off" aria-controls="map-place-results" /><ul id="map-place-results" class="map-search-results" hidden></ul></div>
          <button type="button" id="twin-reset-map"><span data-lang-es>Ver todo BCS</span><span data-lang-en hidden>View all BCS</span></button></div>
        <aside id="shell-fiche" class="shell-fiche" hidden></aside>
      </section>
      <footer class="shell-dock" id="shell-dock">
        <div class="shell-dock-bar">
          <div class="shell-base" role="group" aria-label="Mapa base" data-aria-es="Mapa base" data-aria-en="Basemap">
            <button type="button" data-base="streets" aria-pressed="true"><span data-lang-es>Calles</span><span data-lang-en hidden>Streets</span></button>
            <button type="button" data-base="satellite" aria-pressed="false"><span data-lang-es>Satélite</span><span data-lang-en hidden>Satellite</span></button>
            <button type="button" id="shell-pitch" aria-pressed="true">
              <span data-lang-es>3D</span><span data-lang-en hidden>3D</span>
            </button>
            <button type="button" class="shell-capas-btn" id="shell-capas" aria-expanded="false">
              <span data-lang-es>Más capas</span><span data-lang-en hidden>More layers</span>
            </button>
          </div>
          <p class="shell-hud" id="shell-hud">
            <span data-lang-es>Terreno 3D activo</span>
            <span data-lang-en hidden>3D terrain on</span>
          </p>
          <div class="twin-basic" role="group" aria-label="Capas básicas">
            <span class="twin-basic-label"><span data-lang-es>Mostrar</span><span data-lang-en hidden>Show</span></span>
            <button type="button" data-basic="places" aria-pressed="true"><span data-lang-es>Localidades</span><span data-lang-en hidden>Places</span></button>
            <button type="button" data-basic="roads" aria-pressed="true"><span data-lang-es>Carreteras</span><span data-lang-en hidden>Roads</span></button>
            <button type="button" data-basic="water" aria-pressed="false"><span data-lang-es>Agua</span><span data-lang-en hidden>Water</span></button>
            <button type="button" data-basic="nature" aria-pressed="false"><span data-lang-es>Áreas naturales</span><span data-lang-en hidden>Natural areas</span></button>
          </div>
        </div>
          <div class="shell-scrim" id="shell-scrim" hidden></div>
          <div class="shell-sheet" id="shell-sheet" role="region" aria-label="Todas las capas">
            <div class="shell-dock-chips" role="group" aria-label="Capas">
            <button type="button" data-dock="l0" aria-selected="false"><span class="shell-n">0</span><span data-lang-es>Terreno</span><span data-lang-en hidden>Terrain</span></button>
            <button type="button" data-dock="l1" aria-selected="false"><span class="shell-n">1</span><span data-lang-es>Edificios</span><span data-lang-en hidden>Buildings</span></button>
            <button type="button" data-dock="l2" aria-selected="false"><span class="shell-n">2</span><span data-lang-es>Infraestructura</span><span data-lang-en hidden>Infrastructure</span></button>
            <button type="button" data-dock="l3" aria-selected="false"><span class="shell-n">3</span><span data-lang-es>Movilidad</span><span data-lang-en hidden>Mobility</span></button>
            <button type="button" data-dock="l4" aria-selected="false"><span class="shell-n">4</span><span data-lang-es>Vivienda</span><span data-lang-en hidden>Housing</span></button>
            <button type="button" data-dock="suelo" aria-selected="false"><span class="shell-n">S</span><span data-lang-es>Uso de suelo</span><span data-lang-en hidden>Land use</span></button>
          </div>

            <button type="button" class="shell-sheet-x" id="shell-sheet-x">
              <span data-lang-es>Cerrar capas</span><span data-lang-en hidden>Close layers</span>
            </button>
            <p class="shell-stack-lead">
              <span data-lang-es>Elige un tema y activa la información que quieras ver. Cada capa indica su fuente.</span>
              <span data-lang-en hidden>Choose a topic and turn on the information you want to see. Each layer names its source.</span>
            </p>
            <ol class="shell-stack">
              <li data-dock-panel="l0">
                <header>
                  <span class="shell-n">0</span>
                  <div>
                    <strong><span data-lang-es>Terreno</span><span data-lang-en hidden>Terrain</span></strong>
                    <small><span data-lang-es>Relieve del estado y geografía básica. El botón 3D inclina la vista.</span><span data-lang-en hidden>State relief and basic geography. The 3D button pitches the view.</span></small>
                  </div>
                  <button type="button" data-stack-toggle="l0" aria-pressed="true"><span data-lang-es>Relieve</span><span data-lang-en hidden>Relief</span></button>
                </header>
                <div class="shell-layer-group">
                  {stack[0].layers.map((id) => {
                    const layer = layersById[id];
                    return (
                      <label>
                        <input type="checkbox" data-layer={layer.id} checked={shellModel.defaults.includes(layer.id)} />
                        <i class="shell-swatch" style={`background:${layer.color}`}></i>
                        <span>
                          <span data-lang-es>{layer.name_es}</span><span data-lang-en hidden>{layer.name_en}</span>
                          <small><span data-lang-es>{layer.source_es}</span><span data-lang-en hidden>{layer.source_en}</span></small>
                        </span>
                      </label>
                    );
                  })}
                </div>
              </li>
              <li data-dock-panel="l1">
                <header>
                  <span class="shell-n">1</span>
                  <div>
                    <strong><span data-lang-es>Edificios</span><span data-lang-en hidden>Buildings</span></strong>
                    <small><span data-lang-es>Apagada al entrar. Si la enciendes, son columnas de población sobre el relieve, no el terreno.</span><span data-lang-en hidden>Off on arrival. When on, population columns sit on the relief. They are not the terrain.</span></small>
                  </div>
                  <button type="button" data-stack-toggle="l1" aria-pressed="false"><span data-lang-es>Extrusión</span><span data-lang-en hidden>Extrusion</span></button>
                </header>
                <ul class="shell-bars">
                  {munis.map((m) => (
                    <li>
                      <span>{m.name}</span>
                      <span class="shell-bar" style={`width:${Math.max(8, Math.round((m.pob / maxPob) * 100))}%`}></span>
                      <b>{m.pob.toLocaleString('es-MX')}</b>
                    </li>
                  ))}
                </ul>
                <p class="shell-note"><span data-lang-es>La columna compara población 2020, INEGI. No es la altura del terreno ni de un inmueble.</span><span data-lang-en hidden>The column compares 2020 population, INEGI. It is not terrain height and not a building height.</span></p>
                <p class="shell-gap-note"><span data-lang-es>BIM de edificios: próximo / sin datos.</span><span data-lang-en hidden>Building BIM: upcoming / no data.</span></p>
              </li>
              <li data-dock-panel="l2">
                <header>
                  <span class="shell-n">2</span>
                  <div>
                    <strong><span data-lang-es>Infraestructura</span><span data-lang-en hidden>Infrastructure</span></strong>
                    <small><span data-lang-es>Vías, energía, agua, puertos y ordenamiento publicado.</span><span data-lang-en hidden>Roads, energy, water, ports and published zoning.</span></small>
                  </div>
                  <button type="button" data-stack-toggle="l2" aria-pressed="false"><span data-lang-es>Todas</span><span data-lang-en hidden>All</span></button>
                </header>
                <div class="shell-layer-group">
                  {stack[1].layers.map((id) => {
                    const layer = layersById[id];
                    return (
                      <label>
                        <input type="checkbox" data-layer={layer.id} checked={shellModel.defaults.includes(layer.id)} />
                        <i class="shell-swatch" style={`background:${layer.color}`}></i>
                        <span>
                          <span data-lang-es>{layer.name_es}</span><span data-lang-en hidden>{layer.name_en}</span>
                          <small><span data-lang-es>{layer.source_es}</span><span data-lang-en hidden>{layer.source_en}</span></small>
                        </span>
                      </label>
                    );
                  })}
                </div>
              </li>
              <li data-dock-panel="l3">
                <header>
                  <span class="shell-n">3</span>
                  <div>
                    <strong><span data-lang-es>Movilidad</span><span data-lang-en hidden>Mobility</span></strong>
                    <small><span data-lang-es>Movimiento de personas y bienes con las capas de transporte que ya existen.</span><span data-lang-en hidden>Movement of people and goods from transport layers that already exist.</span></small>
                  </div>
                  <button type="button" data-stack-toggle="l3" aria-pressed="false"><span data-lang-es>Todas</span><span data-lang-en hidden>All</span></button>
                </header>
                <div class="shell-layer-group">
                  {stack[2].layers.map((id) => {
                    const layer = layersById[id];
                    return (
                      <label>
                        <input type="checkbox" data-layer={layer.id} />
                        <i class="shell-swatch" style={`background:${layer.color}`}></i>
                        <span>
                          <span data-lang-es>{layer.name_es}</span><span data-lang-en hidden>{layer.name_en}</span>
                          <small><span data-lang-es>{layer.source_es}</span><span data-lang-en hidden>{layer.source_en}</span></small>
                        </span>
                      </label>
                    );
                  })}
                </div>
                <p class="shell-note"><span data-lang-es>El corredor es un marco de análisis, no un límite oficial.</span><span data-lang-en hidden>The corridor is an analysis frame, not an official boundary.</span></p>
              </li>
              <li data-dock-panel="l4"><header><div><strong><span data-lang-es>Vivienda y mercado inmobiliario</span><span data-lang-en hidden>Housing and real estate</span></strong><small><span data-lang-es>Oferta publicada, con precios de lista en dólares.</span><span data-lang-en hidden>Published listings, with asking prices in US dollars.</span></small></div></header><div class="shell-layer-group"><label><input type="checkbox" data-layer="bcs_market_listings" /><i class="shell-swatch" style="background:#f59e0b"></i><span><span data-lang-es>Propiedades en mercado</span><span data-lang-en hidden>Market listings</span><small>MLS BCS · 2026</small></span></label></div><p class="shell-note"><span data-lang-es>Las columnas son símbolos de las propiedades; no representan edificios reales ni precios de venta cerrada.</span><span data-lang-en hidden>Columns are property symbols, not actual buildings or completed sale prices.</span></p></li>
              <li data-dock-panel="suelo">
                <header>
                  <span class="shell-n">S</span>
                  <div>
                    <strong><span data-lang-es>Uso de suelo</span><span data-lang-en hidden>Land use</span></strong>
                    <small><span data-lang-es>Tres instrumentos. Solo se dibuja el que tiene polígonos publicados.</span><span data-lang-en hidden>Three instruments. Only the one with published polygons is drawn.</span></small>
                  </div>
                </header>
                <div class="shell-layer-group">
                  <label>
                    <input type="checkbox" data-layer="poer_ugas" />
                    <span>
                      <span data-lang-es>POERBCS — política ambiental (69 UGA)</span><span data-lang-en hidden>POERBCS — environmental policy (69 UGAs)</span>
                      <small><span data-lang-es>SEPUIMM / POERBCS. Polígonos reales. El color sigue el sufijo de CLASIFICAC.</span><span data-lang-en hidden>SEPUIMM / POERBCS. Real polygons. Color follows the CLASIFICAC suffix.</span></small>
                    </span>
                  </label>
                </div>
                <ul class="shell-legend">
                  <li><i style="background:#2d6a4f"></i><span data-lang-es>AS aprovechamiento sustentable</span><span data-lang-en hidden>AS sustainable use</span></li>
                  <li><i style="background:#d4a017"></i><span data-lang-es>PR preservación</span><span data-lang-en hidden>PR preservation</span></li>
                  <li><i style="background:#6b3fa0"></i><span data-lang-es>PT protección</span><span data-lang-en hidden>PT protection</span></li>
                  <li><i style="background:#c0392b"></i><span data-lang-es>RT restauración</span><span data-lang-en hidden>RT restoration</span></li>
                  <li><i style="background:#8d99ae"></i><span data-lang-es>Otra clave de CLASIFICAC</span><span data-lang-en hidden>Other CLASIFICAC code</span></li>
                </ul>
                <p class="shell-note"><span data-lang-es>Nombres tomados de la simbología de la carta publicada del modelo de ordenamiento (AS, PR, PT, RT).</span><span data-lang-en hidden>Names taken from the legend of the published ordering-model map (AS, PR, PT, RT).</span></p>
                <div class="shell-layer-group">
                  <label>
                    <input type="checkbox" data-icluster="uso" />
                    <span>
                      <span data-lang-es>iCluster — IMPLAN Los Cabos, uso de suelo</span><span data-lang-en hidden>iCluster — IMPLAN Los Cabos land use</span>
                      <small><span data-lang-es>SIG BCS, capa cimp100. Se ve al acercar a Los Cabos. Un clic identifica el uso de suelo. No es el POER.</span><span data-lang-en hidden>SIG BCS, layer cimp100. It shows when you zoom to Los Cabos. A click identifies the land use. It is not the POER.</span></small>
                    </span>
                  </label>
                  <label>
                    <input type="checkbox" data-icluster="parcelas" />
                    <span>
                      <span data-lang-es>iCluster — parcelas</span><span data-lang-en hidden>iCluster — parcels</span>
                      <small><span data-lang-es>Secretaría de Turismo, Economía y Sustentabilidad, capa cspyde100. Un clic identifica la parcela si el servicio la devuelve. No es el catastro del estado.</span><span data-lang-en hidden>Tourism, Economy and Sustainability secretariat, layer cspyde100. A click identifies the parcel when the service returns one. It is not the state cadastre.</span></small>
                    </span>
                  </label>
                </div>
                <div class="shell-scenarios">
                  <button type="button" data-suelo="pdu"><span data-lang-es>PDU 2040 Los Cabos</span><span data-lang-en hidden>PDU 2040 Los Cabos</span></button>
                  <button type="button" data-suelo="pducp"><span data-lang-es>PDU La Paz</span><span data-lang-en hidden>La Paz PDU</span></button>
                  <a href="http://sig.bcs.gob.mx/iclusterbcs/" target="_blank" rel="noopener noreferrer"><span data-lang-es>Abrir visor iCluster</span><span data-lang-en hidden>Open the iCluster viewer</span></a>
                </div>
                <p class="shell-gap-note"><span data-lang-es>Algunos planes solo cuentan con mapas en imagen; no se representan como polígonos.</span><span data-lang-en hidden>Some plans are available as map images only; they are not represented as polygons.</span></p>
              </li>
            </ol>
            <p class="shell-status" id="shell-status" aria-live="polite"></p>
            <p class="shell-gap"><span data-lang-es>Selecciona un elemento del mapa para consultar sus datos y su fuente.</span><span data-lang-en hidden>Select a map feature to read its data and source.</span></p>
          </div>
      </footer>
    </div>
    <p class="shell-toast" id="shell-toast" hidden role="status"></p>
    <script is:inline define:vars={{ shellModel }}>
      window.__SHELL_MODEL__ = shellModel;
    </script>
    <script is:inline src="/explorar/vendor/maplibre-gl.js"></script>
    <script is:inline src="/gemelo/cdt3d.js?v=20261103-fly"></script>
    <script is:inline src="/vendor/leaflet/leaflet.js"></script>
    <script is:inline>if(new URLSearchParams(location.search).has("embed"))document.body.classList.add("map-embed");</script>
    <script is:inline src="/shell/evidence.js?v=20261102-integrated"></script>
    <script is:inline src="/shell/app.js?v=20261103-pages"></script>
    <style is:global>
      html, body.shell-app { margin: 0; height: 100%; background: #fbf8f1; color: #1a1a1a; overflow: hidden; }
      body.shell-app { font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; }
      .shell {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: minmax(0, 1fr) auto;
        height: 100%;
        min-height: 0;
      }
      .shell-map-wrap { grid-column: 1; grid-row: 1; }
      .shell-dock { grid-column: 1; grid-row: 2; }
      body.shell-dock-open .shell { grid-template-rows: minmax(0, 1fr) minmax(10%, 36%); }
      .shell-chat, .shell-files, .shell-map-wrap { min-width: 0; min-height: 0; height: 100%; }
      .shell-chat { overflow: hidden; }
      .shell-chat { background: #fbf8f1; border-right: 1px solid #e0e0e0; }
      .shell-files { display: flex; flex-direction: column; background: #fff; border-left: 1px solid #e0e0e0; }
      .shell-files header { display: flex; flex-direction: column; gap: .3rem; padding: .4rem .4rem .3rem; border-bottom: 1px solid #e0e0e0; min-width: 0; }
      .shell-files header strong { color: #006BA3; font-size: .72rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .shell-files input { width: 100%; min-width: 0; font: inherit; font-size: .75rem; border: 1px solid #d5d5d5; border-radius: 8px; padding: .28rem .4rem; }
      #shell-tree, #shell-related { overflow: auto; padding: .35rem .55rem .6rem; }
      #shell-tree { flex: 1; }
      #shell-related { border-bottom: 1px solid #e7eef3; max-height: 34%; }
      .shell-tree-label { margin: .35rem .2rem; font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; color: #0083C4; font-weight: 700; }
      .shell-files details { margin: .15rem 0; }
      .shell-files summary { cursor: pointer; font-weight: 650; color: #1a1a1a; padding: .2rem 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: .72rem; }
      .shell-file { display: block; width: 100%; text-align: left; font: inherit; font-size: .72rem; line-height: 1.3; border: 0; background: transparent; color: #1a1a1a; padding: .28rem .2rem .28rem 1.05rem; border-radius: 6px; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; position: relative; }
      .shell-file::before { content: ""; position: absolute; left: .15rem; top: .38rem; width: .55rem; height: .68rem; border: 1.5px solid #0083C4; border-radius: 1px; }
      .shell-file:hover, .shell-file:focus-visible { background: #e8f4fb; outline: none; }
      #shell-preview { border-top: 1px solid #e0e0e0; padding: .55rem .7rem .7rem; max-height: 38%; overflow: auto; }
      #shell-preview p { margin: 0 0 .35rem; font-size: .82rem; }
      #shell-preview a { color: #006BA3; font-weight: 700; }
